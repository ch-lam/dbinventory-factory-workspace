# ============================================================================
# .env.example -- template for local configuration.
#
# Copy to .env and fill in. .env is gitignored and must never be committed.
#   cp .env.example .env
#
# Used by apex/dbinventory/applications/db-inv/tests/apex_page_test.mjs,
# which reads the nearest .env above it. See the README.md next to it.
# ============================================================================

# ---- Deployed APEX application ---------------------------------------------
# Base URL up to and including the ORDS path segment, no trailing slash.
APEX_BASE_URL=https://apex.internal/ords/dbinv-dev
APEX_APP_ID=100

# ---- Test profiles ---------------------------------------------------------
# One pair per role. The test takes --profile <name> and defaults to ADMIN.
# Separate accounts are not cosmetic: the derogation screen forbids a request
# and its approval coming from the same person, so testing that path needs two.
APEX_USER_ADMIN=DBINVENTORY
APEX_PASS_ADMIN=

# Approver, for the segregation-of-duties path on page 71.
# APEX_USER_RSSI=
# APEX_PASS_RSSI=

# Read-only user, to check no privileged action leaks into an ordinary session.
# APEX_USER_READONLY=
# APEX_PASS_READONLY=

# ---- Browser ---------------------------------------------------------------
# Any Chromium build exposing the DevTools protocol. Defaults to Edge, which is
# what is installed on the development machine; Chrome works unchanged.
# APEX_TEST_BROWSER=C:/Program Files (x86)/Microsoft/Edge/Application/msedge.exe
