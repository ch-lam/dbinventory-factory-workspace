page 70 (
    name: DB Inv. - Derogations
    alias: DB-INV-DEROGATIONS
    title: DB Inv. - Derogations
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region derogations (
        name: Derogations
        title: Derogations
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select e.exception_id,
                       e.review_state,
                       e.status,
                       e.platform,
                       e.rule_title,
                       e.entity_type,
                       e.scope_name,
                       e.item_key,
                       e.start_date,
                       e.end_date,
                       e.review_due_date,
                       e.covered_today,
                       e.created_by,
                       e.approved_by
                  from v_exception_review e
                 order by case e.review_state
                             when 'Expired'                  then 1
                             when 'Review overdue'           then 2
                             when 'Expiring within 60 days'  then 3
                             when 'Awaiting approval'        then 4
                             when 'Draft, not submitted'     then 5
                             when 'Approved, covers nothing' then 6
                             else 7
                          end,
                          e.exception_id
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        reportLayout {
            numberOfRows: 30
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
        }
        pagination {
            type: rowRangesXToYOfZWithPagination
            displayPosition: topAndBottomRight
        }
        messages {
            whenNoDataFound: No derogation has been captured yet
        }

        column APPROVED_BY (
            reportColumnQueryId: 14
            derivedColumn: N
            heading {
                heading: Approved by
            }
            layout {
                sequence: 140
            }
        )

        column COVERED_TODAY (
            reportColumnQueryId: 12
            derivedColumn: N
            heading {
                heading: Findings covered
            }
            layout {
                sequence: 120
            }
        )

        column CREATED_BY (
            reportColumnQueryId: 13
            derivedColumn: N
            heading {
                heading: Requested by
            }
            layout {
                sequence: 130
            }
        )

        column END_DATE (
            reportColumnQueryId: 10
            derivedColumn: N
            heading {
                heading: Until
            }
            layout {
                sequence: 100
            }
        )

        column ENTITY_TYPE (
            reportColumnQueryId: 6
            derivedColumn: N
            heading {
                heading: Scope
            }
            layout {
                sequence: 60
            }
        )

        column EXCEPTION_ID (
            reportColumnQueryId: 1
            derivedColumn: N
            type: link
            heading {
                heading: Id
            }
            layout {
                sequence: 10
            }
            link {
                target: {
                    page: 71
                    items: {
                        P71_EXCEPTION_ID: #EXCEPTION_ID#
                    }
                    clearCache: 71
                }
                linkText: #EXCEPTION_ID#
            }
        )

        column ITEM_KEY (
            reportColumnQueryId: 8
            derivedColumn: N
            heading {
                heading: Item
            }
            layout {
                sequence: 80
            }
        )

        column PLATFORM (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Platform
            }
            layout {
                sequence: 40
            }
        )

        column REVIEW_DUE_DATE (
            reportColumnQueryId: 11
            derivedColumn: N
            heading {
                heading: Review due
            }
            layout {
                sequence: 110
            }
        )

        column REVIEW_STATE (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Review
            }
            layout {
                sequence: 20
            }
        )

        column RULE_TITLE (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Rule
            }
            layout {
                sequence: 50
            }
        )

        column SCOPE_NAME (
            reportColumnQueryId: 7
            derivedColumn: N
            heading {
                heading: Entity
            }
            layout {
                sequence: 70
            }
        )

        column START_DATE (
            reportColumnQueryId: 9
            derivedColumn: N
            heading {
                heading: From
            }
            layout {
                sequence: 90
            }
        )

        column STATUS (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Status
            }
            layout {
                sequence: 30
            }
        )

    )

    region review-summary (
        name: To Review
        title: To Review
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select review_state,
                       count(*) derogations,
                       sum(covered_today) findings_covered
                  from v_exception_review
                 where review_state <> 'Current'
                 group by review_state
                 order by case review_state
                             -- First: approved, yet without any effect until the
                             -- scoring runs. The Recompute Scoring button is here.
                             when 'Approved, not yet scored' then 0
                             when 'Expired'                  then 1
                             when 'Review overdue'           then 2
                             when 'Expiring within 60 days'  then 3
                             when 'Awaiting approval'        then 4
                             when 'Draft, not submitted'     then 5
                             when 'Approved, covers nothing' then 6
                             else 7
                          end
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--altRowsDefault
            ]
        }
        messages {
            whenNoDataFound: Nothing waiting: every derogation is current
        }

        column DEROGATIONS (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Derogations
            }
            layout {
                sequence: 20
            }
        )

        column FINDINGS_COVERED (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Findings covered
            }
            layout {
                sequence: 30
            }
        )

        column REVIEW_STATE (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Review state
            }
            layout {
                sequence: 10
            }
        )

    )

    button create (
        buttonName: CREATE
        label: New Derogation
        layout {
            sequence: 10
            region: @derogations
            slot: edit
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 71
                clearCache: 71
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button rescore (
        buttonName: RESCORE
        label: Recompute Scoring
        layout {
            sequence: 10
            region: @review-summary
            slot: edit
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: submitPage
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: noRowsReturned
            sqlQuery:
                ```sql
                select 1
                  from v_environment_identity
                 where name = 'Service name'
                   and upper(value) like '%DEMO%'
                ```
        }
        comments {
            comments: Derogations attach to findings only when the scoring runs. Granted between two collects, they would otherwise wait for the next cron run with no effect at all. Rendered everywhere but on the demo, which has its own button with a warning.
        }
    )

    button rescore-demo (
        buttonName: RESCORE_DEMO
        label: Recompute Scoring
        layout {
            sequence: 20
            region: @review-summary
            slot: edit
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: submitPage
            requiresConfirmation: true
            warnOnUnsavedChanges: doNotCheck
        }
        confirmation {
            message: Demo database - recomputing creates a scoring snapshot dated today, next to the dataset's own. Your derogations will apply, but T_003 and the reference baseline will fail until the demo dataset is reloaded (fixtures/load_fixtures.sh). Continue?
            style: warning
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                  from v_environment_identity
                 where name = 'Service name'
                   and upper(value) like '%DEMO%'
                ```
        }
        comments {
            comments: Same as RESCORE, rendered only on the demo, same criterion as the second guard of fixtures/load_fixtures.sh. A snapshot dated today breaks T_003 assertion 11 and the baseline until the demo is reloaded, hence the warning.
        }
    )

    process rescore (
        name: Recompute Scoring
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                -- What the cron runs after a collect (compute_info_all.sh), at
                -- today's date: the inventory ETL, then the scoring, whose
                -- apply_exceptions attaches every derogation valid today. Both
                -- read the staging already loaded; no collect is involved.
                pkg_dbinv_inventory.load_all;
                pkg_dbinv_scoring.load_all;
                ```
        }
        execution {
            sequence: 10
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: RESCORE,RESCORE_DEMO
        }
        successMessage {
            successMessage: Scoring recomputed - derogations approved and valid today are now applied.
        }
    )

    branch back-to-derogations (
        name: Back to Derogations
        execution {
            sequence: 10
            point: afterProcessing
        }
        behavior {
            type: pageOrUrl
            target: {
                page: 70
            }
        }
    )

)

