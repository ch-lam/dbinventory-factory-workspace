page 83 (
    name: DB Inv. - Application Attachment
    alias: DB-INV-APPLICATION-ATTACHMENT
    title: DB Inv. - Application Attachment
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region attachment (
        name: Attachment
        title: Attachment
        type: staticContent
        source {
            htmlCode:
                ```
                <p>Attach at the highest level that is true. An application that
                owns a whole instance should be attached to the <strong>instance</strong>,
                not to each of its databases: the databases follow automatically,
                and they keep following when a new one is created.</p>
                <p>Attach a single database only when the instance is genuinely
                shared between applications.</p>
                ```
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        comments {
            comments: The advice in the region body is the whole economics of this screen. There are 514 databases against 97 instances: attaching at instance level is the difference between a data-entry effort that finishes and one that never does. It is written on the page rather than left to training, because whoever uses this screen in two years will not have been trained.
        }
    )

    region remove-warning (
        name: Detach
        title: Detach
        type: staticContent
        source {
            htmlCode:
                ```
                <p><strong>Detach this from the application?</strong></p>
                <p>Every database it covers goes back to the list of databases with no
                application - all the databases of an instance, when an instance is
                detached. Nothing is deleted: attaching the same thing again restores
                the coverage, and the journal keeps both moves.</p>
                ```
        }
        layout {
            sequence: 5
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        comments {
            comments: Shown only when the dialog is opened from the trash icon of the application screen (P83_MODE = REMOVE). It stands in for a confirmation prompt, which APEXlang cannot express on a button.
        }
        serverSideCondition {
            type: item=value
            item: P83_MODE
            value: REMOVE
        }
    )

    pageItem P83_APP_ENTITY_ID (
        type: hidden
        layout {
            sequence: 10
            region: @attachment
            slot: regionBody
        }
    )

    pageItem P83_MODE (
        type: hidden
        layout {
            sequence: 15
            region: @attachment
            slot: regionBody
        }
    )

    pageItem P83_APPLICATION_ID (
        type: hidden
        layout {
            sequence: 20
            region: @attachment
            slot: regionBody
        }
    )

    pageItem P83_PRESET_TYPE (
        type: hidden
        layout {
            sequence: 21
            region: @attachment
            slot: regionBody
        }
        comments {
            comments: Set by the links of page 80, with P83_PRESET_ID, to open this dialog on a given database or instance. Two items rather than P83_ENTITY directly, because its value carries a colon (DATABASE:12), which is the separator of a classic APEX URL.
        }
    )

    pageItem P83_PRESET_ID (
        type: hidden
        layout {
            sequence: 22
            region: @attachment
            slot: regionBody
        }
    )

    pageItem P83_APPLICATION_PICK (
        type: selectList
        label {
            label: Application
            alignment: right
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select a.app_code || ' - ' || a.app_name d,
                       a.application_id r
                  from ref_application a
                 where a.lifecycle_status <> 'RETIRED'
                 order by a.app_code
                ```
            displayNullValue: true
            nullDisplayValue: - select the application that owns it -
        }
        layout {
            sequence: 25
            region: @attachment
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        comments {
            comments: Only shown when the dialog is opened from the list of databases with no application on page 80, where the database is known and the application is not. From the application screen P83_APPLICATION_ID is already set and this item is not rendered, so its required validation does not fire either.
        }
        serverSideCondition {
            type: itemIsNull
            item: P83_APPLICATION_ID
        }
    )

    pageItem P83_ENTITY (
        type: selectOne
        label {
            label: Attach to
            alignment: right
        }
        lov {
            type: sharedComponent
            lov: @application-attachable-entity
        }
        layout {
            sequence: 30
            region: @attachment
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        help {
            helpText: Type to search. One list rather than a type and an identifier, so a host cannot be picked with a database id by mistake. Each entry says which level it is - Host, Instance or Database.
        }
        comments {
            comments: Select One rather than a plain select list: the list holds every host, instance and database of the estate, several hundred entries, and a select list with no search is not usable at that size. Read-only on an existing attachment, because there is no API to move an attachment - detach it and attach the right thing instead.
        }
        readOnly {
            type: itemIsNotNull
            item: P83_APP_ENTITY_ID
        }
    )

    pageItem P83_CURRENT (
        type: displayOnly
        label {
            label: Currently attached to
            alignment: right
        }
        layout {
            sequence: 40
            region: @attachment
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P83_APP_ENTITY_ID
        }
    )

    pageItem P83_NOTE (
        type: textarea
        label {
            label: Note
            alignment: right
        }
        layout {
            sequence: 50
            region: @attachment
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            height: 2
        }
        validation {
            maxLength: 400
        }
        help {
            helpText: Why the attachment is at this level, when that is not obvious.
        }
        readOnly {
            type: itemIsNotNull
            item: P83_APP_ENTITY_ID
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 10
            region: @attachment
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button detach (
        buttonName: DETACH
        label: Detach
        layout {
            sequence: 20
            region: @attachment
            slot: edit
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: submitPage
        }
        comments {
            comments: No confirmation prompt: APEXlang has no property for one, and confirmMessage is rejected. This one deserved a prompt more than most, since detaching an instance returns every database under it to the unclaimed list - eighteen of them in the case this was first tried on. The confirmation is the remove mode instead: the trash icon of the application screen opens this dialog with P83_MODE = REMOVE, which spells out the consequence before Detach is pressed. Detaching deactivates rather than deletes: attaching the same thing again reactivates the row (link_entity, since the unique key covers inactive rows) and restores the coverage, and the journal holds both moves.
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P83_APP_ENTITY_ID
        }
    )

    button save (
        buttonName: SAVE
        label: Attach
        layout {
            sequence: 30
            region: @attachment
            slot: edit
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: submitPage
        }
        serverSideCondition {
            type: itemIsNull
            item: P83_APP_ENTITY_ID
        }
    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-cancel-dialog (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process load-attachment (
        name: Load Attachment
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                if :P83_APP_ENTITY_ID is not null then
                   select e.application_id,
                          e.entity_type || ':' || e.entity_id,
                          e.note,
                          e.entity_type || ' ' || e.entity_id
                     into :P83_APPLICATION_ID, :P83_ENTITY, :P83_NOTE, :P83_CURRENT
                     from ref_application_entity e
                    where e.app_entity_id = :P83_APP_ENTITY_ID;
                elsif :P83_PRESET_TYPE in ( 'HOST', 'INSTANCE', 'DATABASE' ) then
                   :P83_ENTITY := :P83_PRESET_TYPE || ':' || :P83_PRESET_ID;
                end if;
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
    )

    process save-attachment (
        name: Save Attachment
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                   l_type ref_application_entity.entity_type%type;
                   l_id   number;
                   l_new  number;
                begin
                   l_type := substr(:P83_ENTITY, 1, instr(:P83_ENTITY, ':') - 1);
                   l_id   := to_number(substr(:P83_ENTITY, instr(:P83_ENTITY, ':') + 1));

                   -- link_entity checks that the entity exists before storing it.
                   -- No foreign key can do that on a polymorphic reference, and an
                   -- attachment pointing at nothing resolves to no database at all
                   -- -- which reads exactly like an application nobody attached.
                   -- From page 80 the application is picked here, from page 81 it
                   -- arrives with the dialog.
                   l_new := pkg_dbinv_application.link_entity(
                      p_application_id => nvl(:P83_APPLICATION_ID, :P83_APPLICATION_PICK),
                      p_entity_type    => l_type,
                      p_entity_id      => l_id,
                      p_note           => :P83_NOTE );

                   :P83_APP_ENTITY_ID := l_new;
                exception
                   when dup_val_on_index then
                      raise_application_error(-20051,
                         'This is already attached to the application.');
                end;
                ```
        }
        execution {
            sequence: 20
        }
        serverSideCondition {
            whenButtonPressed: @save
        }
        successMessage {
            successMessage: Attached - the databases underneath it are now covered
        }
    )

    process detach-attachment (
        name: Detach Attachment
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                pkg_dbinv_application.unlink_entity(
                   p_app_entity_id => :P83_APP_ENTITY_ID,
                   p_reason        => 'detached from the attachment screen' );
                ```
        }
        execution {
            sequence: 30
        }
        serverSideCondition {
            whenButtonPressed: @detach
        }
        successMessage {
            successMessage: Detached - it is deactivated, not deleted, so the history survives
        }
    )

    process close-attachment-dialog (
        name: Close Attachment Dialog
        type: closeDialog
        execution {
            sequence: 90
        }
    )

)
