page 26 (
    name: DB Inv. - Oracle Database
    alias: DB-INV-ORACLE-DATABASE
    title: DB Inv. - Oracle Database
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        fileUrls: #APP_FILES#css/nis2.css
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    advanced {
        reloadOnSubmit: always
    }

    region page-title (
        name: &P26_DATABASE_LABEL.
        type: staticContent
        layout {
            sequence: 1
            slot: body
        }
        appearance {
            template: @/title-bar
            templateOptions: #DEFAULT#
        }
    )

    region database-filter (
        name: Database Selection
        type: staticContent
        layout {
            sequence: 5
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
    )

    pageItem P26_DATABASE_ID (
        type: selectOne
        label {
            label: Database
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select h.hostname || ' / ' || i.instance_name || ' / ' || d.db_name d,
                       d.database_id r
                  from dim_database d
                  join dim_instance i on i.instance_id = d.instance_id
                  join dim_host h on h.host_id = i.host_id
                 where d.platform = 'ORACLE'
                   -- Aucun filtre a poser ici : depuis le 2026-09-05 load_dim_database ne cree
                   -- plus de ligne de grain base pour le CONTENEUR d'un CDB. Cette liste portait
                   -- le contournement, l'ETL porte desormais la correction -- il filtre sur
                   -- database_type, une colonne que la collecte ecrit vraiment, la ou il filtrait
                   -- sur count_pdb que personne n'alimente.
                 order by h.hostname, i.instance_name, d.db_name
                ```
        }
        layout {
            sequence: 10
            region: @database-filter
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        advanced {
            warnOnUnsavedChanges: ignore
        }
        help {
            helpText: Select the Oracle database (PDB) whose card is displayed below.
        }
    )

    pageItem P26_DATABASE_LABEL (
        type: hidden
        layout {
            sequence: 20
            region: @database-filter
            slot: regionBody
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select h.hostname || ' / ' || i.instance_name || ' / ' || d.db_name
                  from dim_database d
                  join dim_instance i on i.instance_id = d.instance_id
                  join dim_host h on h.host_id = i.host_id
                 where d.database_id = :P26_DATABASE_ID
                ```
            used: always
        }
    )

    region oracle-database-nis2 (
        name: NIS2 Posture
        title: NIS2 Posture
        type: classicReport
        comments {
            comments: Read-only synthesis band, at the grain of this database and its storage units only - the same perimeter as the Compliance Findings report at the bottom of this page. An instance-grain finding is deliberately NOT repeated here: one setting left wrong on the instance would otherwise redden every database it carries, once per database for a single fix. The bar's CSS lives once, on the global page p00000.
        }
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                -- La barre est assemblee ici plutot que par 24 colonnes cachees et un
                -- htmlExpression facon p10011-top-users : ces six pages se maintiennent
                -- a la main depuis que leur generateur a disparu, et l'autre forme leur
                -- couterait 300 lignes chacune pour le meme rendu.
                --
                -- apex_escape.html sur chaque donnee : le balisage est a nous, les
                -- donnees ne le sont pas. title et description de ref_nis2_domain sont
                -- saisissables, et un & y suffirait a casser la barre.
                select '<div class="nis2-bar">' ||
                       listagg( '<span class="nis2-seg ' || cls
                                || '" title="' || apex_escape.html( tip ) || '">'
                                || '<span class="nis2-value">' || apex_escape.html( badge ) || '</span>'
                                || '<span class="nis2-label">' || apex_escape.html( lbl ) || '</span>'
                                || '</span>', '' )
                          within group ( order by display_order )
                       || '</div>' bar
                  from ( select p.display_order,
                                p.nis2_domain_code lbl,
                                case p.status
                                   when 'NOT_ASSESSED' then '--'
                                   when 'DEROGATED'    then to_char( p.derogated )
                                   else to_char( p.open_gaps )
                                end badge,
                                -- le neutre est le defaut : une classe oubliee laisse un
                                -- troncon gris, elle ne peut pas faire passer un trou
                                -- pour un vert
                                case p.status
                                   when 'CRITICAL'  then 'is-critical'
                                   when 'WARNING'   then 'is-warning'
                                   when 'DEROGATED' then 'is-waived'
                                   when 'OK'        then 'is-ok'
                                   else 'is-none'
                                end cls,
                                p.title || ' - ' || p.summary tip
                           from v_nis2_posture p
                          where p.entity_type = 'DATABASE'
                            and p.entity_id = :P26_DATABASE_ID )
                ```
            pageItemsToSubmit: P26_DATABASE_ID
        }
        layout {
            sequence: 7
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--noPadding
            ]
            cssClasses: nis2-region
        }
        reportLayout {
            numberOfRows: 1
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--hideNoPagination
            ]
        }
        messages {
            whenNoDataFound: No NIS2 posture for this selection.
        }

        column BAR (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Article 21(2)
            }
            layout {
                sequence: 10
            }
            security {
                escapeSpecialChars: false
            }
        )

    )

    region oracle-database-identity (
        name: Database
        title: Database
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select d.db_name,
                       d.environment,
                       nvl(xd.pdb_state, d.db_state) db_state,
                       case xd.is_pdb when 1 then 'PDB' when 0 then 'Non-CDB' end db_kind,
                       xd.charset,
                       i.instance_name,
                       h.hostname
                  from dim_database d
                  join dim_instance i on i.instance_id = d.instance_id
                  join dim_host h on h.host_id = i.host_id
                  left join ext_oracle_database xd on xd.database_id = d.database_id
                 where d.database_id = :P26_DATABASE_ID
                ```
            pageItemsToSubmit: P26_DATABASE_ID
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--horizontalBorders
            ]
        }
        pagination {
            type: rowRangesXToYNoPagination
        }
        messages {
            whenNoDataFound: Select a database above.
        }

        column DB_NAME (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Database
            }
            layout {
                sequence: 10
            }
        )

        column ENVIRONMENT (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Environment
                alignment: center
            }
            layout {
                sequence: 20
                columnAlignment: center
            }
        )

        column DB_STATE (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: State
                alignment: center
            }
            layout {
                sequence: 30
                columnAlignment: center
            }
        )

        column DB_KIND (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Kind
                alignment: center
            }
            layout {
                sequence: 40
                columnAlignment: center
            }
        )

        column CHARSET (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Character Set
            }
            layout {
                sequence: 50
            }
        )

        column INSTANCE_NAME (
            reportColumnQueryId: 6
            derivedColumn: N
            heading {
                heading: Instance
            }
            layout {
                sequence: 60
            }
        )

        column HOSTNAME (
            reportColumnQueryId: 7
            derivedColumn: N
            heading {
                heading: Server
            }
            layout {
                sequence: 70
            }
        )

    )

    region oracle-database-applications (
        name: Applications
        title: Applications
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ea.app_code,
                       ea.app_name,
                       ea.criticality,
                       ea.data_sensitivity,
                       ea.attached_at,
                       ea.application_id
                  from v_entity_application ea
                 where ea.entity_type = 'DATABASE'
                   and ea.entity_id = :P26_DATABASE_ID
                ```
            pageItemsToSubmit: P26_DATABASE_ID
        }
        layout {
            sequence: 15
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        comments {
            comments: The registry read from the inventory rather than from the application. Without it the relation only exists one way and the question actually asked at the console -- whose is this, who do I call -- has no screen. The query goes through v_entity_application so this page and the application page cannot disagree about what "covered" means. attached_at is shown because it changes what detaching would do: a database reached because its whole instance belongs to the application is a different statement from one named explicitly.
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--horizontalBorders
            ]
        }
        messages {
            whenNoDataFound: No application claims this database - nobody has said whose it is
        }

        column APP_CODE (
            reportColumnQueryId: 1
            derivedColumn: N
            type: link
            heading {
                heading: Code
            }
            layout {
                sequence: 10
            }
            sorting {
                defaultSequence: 1
            }
            link {
                target: {
                    page: 81
                    items: {
                        P81_APPLICATION_ID: #APPLICATION_ID#
                    }
                    clearCache: 81
                }
                linkText: #APP_CODE#
            }
        )

        column APP_NAME (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Application
            }
            layout {
                sequence: 20
            }
        )

        column CRITICALITY (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Criticality
            }
            layout {
                sequence: 30
            }
        )

        column DATA_SENSITIVITY (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Data
            }
            layout {
                sequence: 40
            }
        )

        column ATTACHED_AT (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Attached at
            }
            layout {
                sequence: 50
            }
        )

        column APPLICATION_ID (
            reportColumnQueryId: 6
            derivedColumn: N
            type: hidden
            layout {
                sequence: 5
            }
        )

    )

    region oracle-database-tablespaces (
        name: Tablespaces & Capacity
        title: Tablespaces & Capacity
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select su.name tablespace_name,
                       fsc.size_mb,
                       fsc.used_mb,
                       fsc.free_mb,
                       fsc.pct_used,
                       t.warn_value,
                       t.crit_value,
                       case when fsc.pct_used >= t.crit_value then 'Critical'
                            when fsc.pct_used >= t.warn_value then 'Warning'
                            when fsc.pct_used is null then null
                            else 'OK'
                       end saturation
                  from dim_storage_unit su
                  left join fact_storage_capacity fsc
                    on fsc.storage_unit_id = su.storage_unit_id
                   and fsc.snapshot_date = ( select max(s.snapshot_date) from fact_storage_capacity s )
                  left join ref_threshold t
                    on t.control_code = 'ORACLE_CAPACITY_SATURATION'
                   and t.metric = 'pct_used'
                   and t.environment = '*'
                 where su.database_id = :P26_DATABASE_ID
                   and su.storage_type = 'TABLESPACE'
                 order by fsc.pct_used desc nulls last, su.name
                ```
            pageItemsToSubmit: P26_DATABASE_ID
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--horizontalBorders
            ]
        }
        pagination {
            type: rowRangesXToYOfZWithPagination
        }
        messages {
            whenNoDataFound: No tablespace collected for this database.
        }

        column TABLESPACE_NAME (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Tablespace
            }
            layout {
                sequence: 10
            }
        )

        column SIZE_MB (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Allocated (MB)
                alignment: end
            }
            layout {
                sequence: 20
                columnAlignment: end
            }
        )

        column USED_MB (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Used (MB)
                alignment: end
            }
            layout {
                sequence: 30
                columnAlignment: end
            }
        )

        column FREE_MB (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Free (MB)
                alignment: end
            }
            layout {
                sequence: 40
                columnAlignment: end
            }
        )

        column PCT_USED (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Used (%)
                alignment: end
            }
            layout {
                sequence: 50
                columnAlignment: end
            }
        )

        column WARN_VALUE (
            reportColumnQueryId: 6
            derivedColumn: N
            heading {
                heading: Warning (%)
                alignment: end
            }
            layout {
                sequence: 60
                columnAlignment: end
            }
        )

        column CRIT_VALUE (
            reportColumnQueryId: 7
            derivedColumn: N
            heading {
                heading: Critical (%)
                alignment: end
            }
            layout {
                sequence: 70
                columnAlignment: end
            }
        )

        column SATURATION (
            reportColumnQueryId: 8
            derivedColumn: N
            heading {
                heading: Status
                alignment: center
            }
            layout {
                sequence: 80
                columnAlignment: center
            }
        )

    )

    region oracle-database-users (
        name: Users
        title: Users
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select a.account_name,
                       a.account_type,
                       a.scope
                  from dim_account a
                 where a.database_id = :P26_DATABASE_ID
                   and a.platform = 'ORACLE'
                 order by a.account_name
                ```
            pageItemsToSubmit: P26_DATABASE_ID
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--horizontalBorders
            ]
        }
        pagination {
            type: rowRangesXToYOfZWithPagination
        }
        messages {
            whenNoDataFound: No account collected for this database.
        }

        column ACCOUNT_NAME (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: User
            }
            layout {
                sequence: 10
            }
        )

        column ACCOUNT_TYPE (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Type
                alignment: center
            }
            layout {
                sequence: 20
                columnAlignment: center
            }
        )

        column SCOPE (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Scope
                alignment: center
            }
            layout {
                sequence: 30
                columnAlignment: center
            }
        )

    )

    region oracle-database-findings (
        name: Compliance Findings
        title: Compliance Findings
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select rc.category,
                       r.title,
                       nvl( r.severity, rc.severity ) severity,
                       f.entity_type scope,
                       f.item_key,
                       f.observed_value,
                       f.expected_value,
                       case when f.exception_id is not null then 'Granted derogation'
                            when f.is_norm_exception = 1 then 'Accepted by the norm'
                            else 'Open'
                       end exception_status
                  from fact_control_finding f
                  join ref_control_rule r on r.rule_code = f.rule_code and r.active = 1
                  join ref_control rc on rc.control_code = r.control_code and rc.active = 1
                  join v_entity_ancestry a on a.entity_type = f.entity_type and a.entity_id = f.entity_id
                 where a.database_id = :P26_DATABASE_ID
                   and f.is_compliant = 0
                   and f.snapshot_date = ( select max(f2.snapshot_date) from fact_control_finding f2 )
                 order by rc.category, r.title, f.item_key
                ```
            pageItemsToSubmit: P26_DATABASE_ID
        }
        layout {
            sequence: 50
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--horizontalBorders
            ]
        }
        pagination {
            type: rowRangesXToYOfZWithPagination
        }
        messages {
            whenNoDataFound: No open finding on this database.
        }

        column CATEGORY (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Category
            }
            layout {
                sequence: 10
            }
        )

        column TITLE (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Rule
            }
            layout {
                sequence: 20
            }
        )

        column SEVERITY (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Severity
                alignment: center
            }
            layout {
                sequence: 30
                columnAlignment: center
            }
        )

        column SCOPE (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Grain
                alignment: center
            }
            layout {
                sequence: 40
                columnAlignment: center
            }
            comments {
                comments: DATABASE for a rule evaluated on the database itself, STORAGE for one evaluated on one of its tablespaces - both belong to this database through v_entity_ancestry.
            }
        )

        column ITEM_KEY (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Item
            }
            layout {
                sequence: 50
            }
        )

        column OBSERVED_VALUE (
            reportColumnQueryId: 6
            derivedColumn: N
            heading {
                heading: Observed
            }
            layout {
                sequence: 60
            }
        )

        column EXPECTED_VALUE (
            reportColumnQueryId: 7
            derivedColumn: N
            heading {
                heading: Expected
            }
            layout {
                sequence: 70
            }
        )

        column EXCEPTION_STATUS (
            reportColumnQueryId: 8
            derivedColumn: N
            heading {
                heading: Status
                alignment: center
            }
            layout {
                sequence: 80
                columnAlignment: center
            }
        )

    )

    dynamicAction reload-on-selection (
        name: Reload on selection
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P26_DATABASE_ID
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: apex.page.submit()
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    branch reload-same-page (
        name: Reload same page
        comments {
            comments: Hands control back to the same page after the selector submits it. Type page is "Show only": it re-renders inside the same request, with no redirect, so no URL and no checksum - which matters because this page requires arguments to have a checksum and a URL built in the browser cannot carry one. This branch REQUIRES the page attribute reloadOnSubmit = always: with its default onlyForSuccess, APEX refuses a Show Only branch at RUNTIME with APEX.BRANCH.SHOW_ONLY_NOT_SUPPORTED, which apex validate cannot catch.
        }
        execution {
            sequence: 10
            point: afterProcessing
        }
        behavior {
            type: page
            pageNumber: 26
        }
    )

)
