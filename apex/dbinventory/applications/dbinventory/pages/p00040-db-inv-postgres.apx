page 40 (
    name: DB Inv. - Postgres
    alias: DB-INV-POSTGRES
    title: DB Inv. - Postgres
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region postgres-hosts (
        name: PostgreSQL Servers
        title: PostgreSQL Servers
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                -- Une ligne par instance, comme les pages 20 et 30. Sur PostgreSQL
                -- instance_name EST le hostname -- la collecte ne remonte jamais le port dans
                -- les donnees, seulement dans la connexion -- donc il n'y a pas de colonne
                -- Instance a cote de Hostname : elle repeterait la meme valeur. La liste a donc
                -- une ligne par hote, et c'est une propriete de la collecte, pas un choix
                -- d'affichage. Voir pkg_dbinv_inventory.load_dim_host.
                select h.hostname,
                       h.environment,
                       h.license_type,
                       i.engine_version pg_version,
                       e.db_role,
                       i.port,
                       e.wal_level,
                       e.archive_mode,
                       e.max_connections,
                       e.shared_buffers_mb,
                       ( select count(*) from dim_database d where d.instance_id = i.instance_id ) database_count,
                       i.instance_id
                  from dim_instance i
                  join dim_host h on h.host_id = i.host_id
                  left join ext_postgres_instance e on e.instance_id = i.instance_id
                 where i.platform = 'POSTGRES'
                 order by h.hostname
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--horizontalBorders
            ]
        }
        pagination {
            type: rowRangesXToYOfZWithPagination
        }
        messages {
            whenNoDataFound: No PostgreSQL instance collected.
        }

        column HOSTNAME (
            reportColumnQueryId: 1
            derivedColumn: N
            type: link
            heading {
                heading: Hostname
            }
            layout {
                sequence: 10
            }
            link {
                target: {
                    page: 45
                    items: {
                        P45_INSTANCE_ID: #INSTANCE_ID#
                    }
                }
                linkText: #HOSTNAME#
            }
            sorting {
                sortable: false
            }
        )

        column ENVIRONMENT (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Environment
                alignment: center
            }
            layout {
                sequence: 20
                columnAlignment: center
            }
        )

        column LICENSE_TYPE (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: License
            }
            layout {
                sequence: 30
            }
        )

        column PG_VERSION (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Version
            }
            layout {
                sequence: 40
            }
        )

        column DB_ROLE (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Role
                alignment: center
            }
            layout {
                sequence: 50
                columnAlignment: center
            }
        )

        column PORT (
            reportColumnQueryId: 6
            derivedColumn: N
            heading {
                heading: Port
                alignment: end
            }
            layout {
                sequence: 60
                columnAlignment: end
            }
        )

        column WAL_LEVEL (
            reportColumnQueryId: 7
            derivedColumn: N
            heading {
                heading: WAL Level
            }
            layout {
                sequence: 70
            }
        )

        column ARCHIVE_MODE (
            reportColumnQueryId: 8
            derivedColumn: N
            heading {
                heading: Archive Mode
                alignment: center
            }
            layout {
                sequence: 80
                columnAlignment: center
            }
        )

        column MAX_CONNECTIONS (
            reportColumnQueryId: 9
            derivedColumn: N
            heading {
                heading: Max Conn.
                alignment: end
            }
            layout {
                sequence: 90
                columnAlignment: end
            }
        )

        column SHARED_BUFFERS_MB (
            reportColumnQueryId: 10
            derivedColumn: N
            heading {
                heading: Shared Buffers (MB)
                alignment: end
            }
            layout {
                sequence: 100
                columnAlignment: end
            }
        )

        column DATABASE_COUNT (
            reportColumnQueryId: 11
            derivedColumn: N
            heading {
                heading: Databases
                alignment: end
            }
            layout {
                sequence: 110
                columnAlignment: end
            }
        )

        column INSTANCE_ID (
            reportColumnQueryId: 12
            derivedColumn: N
            type: hidden
            layout {
                sequence: 120
            }
        )

    )

)
