    region pg-instance-databases (
        name: Databases
        title: Databases
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select d.db_name,
                       d.environment,
                       p.owner,
                       p.encoding,
                       p.collation,
                       p.tablespace,
                       sc.used_mb size_mb,
                       round( 100 * p.xid_age / 2147483648, 2 ) pct_xid_used,
                       d.database_id
                  from dim_database d
                  left join postgres_databases p
                    on p.hostname = ( select i.instance_name from dim_instance i where i.instance_id = d.instance_id )
                   and p.datname = d.db_name
                  left join dim_storage_unit su
                    on su.database_id = d.database_id
                   and su.storage_type = 'DATABASE'
                  left join fact_storage_capacity sc
                    on sc.storage_unit_id = su.storage_unit_id
                   and sc.snapshot_date = ( select max(s.snapshot_date) from fact_storage_capacity s )
                 where d.instance_id = :P45_INSTANCE_ID
                   and d.platform = 'POSTGRES'
                 order by d.db_name
                ```
            pageItemsToSubmit: P45_INSTANCE_ID
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
