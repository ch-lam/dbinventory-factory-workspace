page 45 (
    name: DB Inv. - Postgres Instance
    alias: DB-INV-POSTGRES-INSTANCE
    title: DB Inv. - Postgres Instance
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        fileUrls: #APP_FILES#css/nis2.css
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    advanced {
        reloadOnSubmit: always
    }

    region page-title (
        name: &P45_INSTANCE_LABEL.
        type: staticContent
        layout {
            sequence: 1
            slot: body
        }
        appearance {
            template: @/title-bar
            templateOptions: #DEFAULT#
        }
    )

    region instance-filter (
        name: Instance Selection
        type: staticContent
        layout {
            sequence: 5
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
    )

    pageItem P45_INSTANCE_ID (
        type: selectOne
        label {
            label: Instance
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select h.hostname d,
                       i.instance_id r
                  from dim_instance i
                  join dim_host h on h.host_id = i.host_id
                 where i.platform = 'POSTGRES'
                 order by h.hostname
                ```
        }
        layout {
            sequence: 10
            region: @instance-filter
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        advanced {
            warnOnUnsavedChanges: ignore
        }
        help {
            helpText: Select the PostgreSQL cluster whose card is displayed below.
        }
    )

    pageItem P45_INSTANCE_LABEL (
        type: hidden
        layout {
            sequence: 20
            region: @instance-filter
            slot: regionBody
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select h.hostname
                  from dim_instance i
                  join dim_host h on h.host_id = i.host_id
                 where i.instance_id = :P45_INSTANCE_ID
                ```
            used: always
        }
    )

    region pg-instance-nis2 (
        name: NIS2 Posture
        title: NIS2 Posture
        type: classicReport
        comments {
            comments: Read-only synthesis band. It rolls the whole chain up - the instance, its databases, their storage units - which is exactly the perimeter of the Compliance Findings report at the bottom of this page. Narrow one without the other and the band counts what the list does not show. The bar's CSS lives once, on the global page p00000.
        }
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                -- La barre est assemblee ici plutot que par 24 colonnes cachees et un
                -- htmlExpression facon p10011-top-users : ces six pages se maintiennent
                -- a la main depuis que leur generateur a disparu, et l'autre forme leur
                -- couterait 300 lignes chacune pour le meme rendu.
                --
                -- apex_escape.html sur chaque donnee : le balisage est a nous, les
                -- donnees ne le sont pas. title et description de ref_nis2_domain sont
                -- saisissables, et un & y suffirait a casser la barre.
                select '<div class="nis2-bar">' ||
                       listagg( '<span class="nis2-seg ' || cls
                                || '" title="' || apex_escape.html( tip ) || '">'
                                || '<span class="nis2-value">' || apex_escape.html( badge ) || '</span>'
                                || '<span class="nis2-label">' || apex_escape.html( lbl ) || '</span>'
                                || '</span>', '' )
                          within group ( order by display_order )
                       || '</div>' bar
                  from ( select p.display_order,
                                p.nis2_domain_code lbl,
                                case p.status
                                   when 'NOT_ASSESSED' then '--'
                                   when 'DEROGATED'    then to_char( p.derogated )
                                   else to_char( p.open_gaps )
                                end badge,
                                -- le neutre est le defaut : une classe oubliee laisse un
                                -- troncon gris, elle ne peut pas faire passer un trou
                                -- pour un vert
                                case p.status
                                   when 'CRITICAL'  then 'is-critical'
                                   when 'WARNING'   then 'is-warning'
                                   when 'DEROGATED' then 'is-waived'
                                   when 'OK'        then 'is-ok'
                                   else 'is-none'
                                end cls,
                                p.title || ' - ' || p.summary tip
                           from v_nis2_posture p
                          where p.entity_type = 'INSTANCE'
                            and p.entity_id = :P45_INSTANCE_ID )
                ```
            pageItemsToSubmit: P45_INSTANCE_ID
        }
        layout {
            sequence: 7
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--noPadding
            ]
            cssClasses: nis2-region
        }
        reportLayout {
            numberOfRows: 1
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--hideNoPagination
            ]
        }
        messages {
            whenNoDataFound: No NIS2 posture for this selection.
        }

        column BAR (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Article 21(2)
            }
            layout {
                sequence: 10
            }
            security {
                escapeSpecialChars: false
            }
        )

    )

    region pg-instance-host (
        name: Server
        title: Server
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select h.hostname,
                       h.environment,
                       h.license_type,
                       e.data_directory,
                       e.start_time,
                       ( select count(*) from dim_database d where d.instance_id = i.instance_id ) database_count
                  from dim_instance i
                  join dim_host h on h.host_id = i.host_id
                  left join ext_postgres_instance e on e.instance_id = i.instance_id
                 where i.instance_id = :P45_INSTANCE_ID
                ```
            pageItemsToSubmit: P45_INSTANCE_ID
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--horizontalBorders
            ]
        }
        pagination {
            type: rowRangesXToYNoPagination
        }
        messages {
            whenNoDataFound: Select an instance above.
        }

        column HOSTNAME (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Hostname
            }
            layout {
                sequence: 10
            }
            comments {
                comments: Also the instance name: the PostgreSQL collect never carries the port into the data, so one host is one cluster in this model. A second cluster on the same machine could not be told apart.
            }
        )

        column ENVIRONMENT (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Environment
                alignment: center
            }
