    region pg-instance-applications (
        name: Applications
        title: Applications
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ea.app_code,
                       ea.app_name,
                       ea.criticality,
                       ea.data_sensitivity,
                       ea.application_id
                  from v_entity_application ea
                 where ea.entity_type = 'INSTANCE'
                   and ea.entity_id = :P45_INSTANCE_ID
                ```
            pageItemsToSubmit: P45_INSTANCE_ID
        }
        layout {
            sequence: 15
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        comments {
            comments: The registry read from the inventory rather than from the application. Without it the relation only exists one way and the question actually asked at the console -- whose is this, who do I call -- has no screen. The query goes through v_entity_application so this page and the application page cannot disagree about what "covered" means.
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--horizontalBorders
            ]
        }
        messages {
            whenNoDataFound: No application claims this instance - nobody has said whose it is
        }

        column APP_CODE (
            reportColumnQueryId: 1
            derivedColumn: N
            type: link
            heading {
                heading: Code
            }
            layout {
                sequence: 10
            }
            sorting {
                defaultSequence: 1
            }
            link {
                target: {
                    page: 81
                    items: {
                        P81_APPLICATION_ID: #APPLICATION_ID#
                    }
                    clearCache: 81
                }
                linkText: #APP_CODE#
            }
        )

        column APP_NAME (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Application
            }
            layout {
                sequence: 20
            }
        )

