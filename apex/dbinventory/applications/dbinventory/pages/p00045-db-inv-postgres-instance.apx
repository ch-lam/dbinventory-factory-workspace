                sequence: 20
                columnAlignment: center
            }
        )

        column LICENSE_TYPE (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: License
            }
            layout {
                sequence: 30
            }
        )

        column DATA_DIRECTORY (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Data Directory
            }
            layout {
                sequence: 40
            }
        )

        column START_TIME (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Started
                alignment: center
            }
            layout {
                sequence: 50
                columnAlignment: center
            }
        )

        column DATABASE_COUNT (
            reportColumnQueryId: 6
            derivedColumn: N
            heading {
                heading: Databases
                alignment: end
            }
            layout {
                sequence: 60
                columnAlignment: end
            }
        )

