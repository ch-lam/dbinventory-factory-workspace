page 71 (
    name: DB Inv. - Derogation
    alias: DB-INV-DEROGATION
    title: DB Inv. - Derogation
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region decision (
        name: Decision
        title: Decision
        type: staticContent
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
    )

    region documents (
        name: Supporting Documents
        title: Supporting Documents
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select d.document_id,
                       d.doc_kind,
                       d.file_name,
                       d.file_size,
                       d.checksum_sha256,
                       d.uploaded_by,
                       d.uploaded_date
                  from ref_exception_document d
                 where d.exception_id = :P71_EXCEPTION_ID
                 order by d.uploaded_date
                ```
        }
        layout {
            sequence: 30
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--altRowsDefault
            ]
        }
        messages {
            whenNoDataFound: No document attached yet
        }

        column CHECKSUM_SHA256 (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: SHA-256
            }
            layout {
                sequence: 50
            }
            comments {
                comments: Shown in full on purpose: this is what an auditor compares against the file handed over.
            }
        )

        column DOCUMENT_ID (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Id
            }
            layout {
                sequence: 10
            }
        )

        column DOC_KIND (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Type
            }
            layout {
                sequence: 20
            }
        )

        column FILE_NAME (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: File
            }
            layout {
                sequence: 30
            }
        )

        column FILE_SIZE (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Bytes
            }
            layout {
                sequence: 40
            }
        )

        column UPLOADED_BY (
            reportColumnQueryId: 6
            derivedColumn: N
            heading {
                heading: Uploaded by
            }
            layout {
                sequence: 60
            }
        )

        column UPLOADED_DATE (
            reportColumnQueryId: 7
            derivedColumn: N
            heading {
                heading: Uploaded on
            }
            layout {
                sequence: 70
            }
        )

    )

    region history (
        name: History
        title: History
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select v.event_date,
                       v.event_type,
                       v.event_by,
                       v.note,
                       v.old_value,
                       v.new_value
                  from ref_exception_event v
                 where v.exception_id = :P71_EXCEPTION_ID
                 order by v.event_id desc
                ```
        }
        layout {
            sequence: 40
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--altRowsDefault
            ]
        }
        messages {
            whenNoDataFound: No event recorded yet
        }

        column EVENT_BY (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: By
            }
            layout {
                sequence: 30
            }
        )

        column EVENT_DATE (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: When
            }
            layout {
                sequence: 10
            }
        )

        column EVENT_TYPE (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Event
            }
            layout {
                sequence: 20
            }
        )

        column NEW_VALUE (
            reportColumnQueryId: 6
            derivedColumn: N
            heading {
                heading: After
            }
            layout {
                sequence: 60
            }
        )

        column NOTE (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Note
            }
            layout {
                sequence: 40
            }
        )

        column OLD_VALUE (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Before
            }
            layout {
                sequence: 50
            }
        )

    )

    region scope (
        name: Scope
        title: Scope
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
    )

    pageItem P71_APPROVER (
        type: textField
        label {
            label: Approver
            alignment: right
        }
        layout {
            sequence: 90
            region: @decision
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        help {
            helpText: Who signs the derogation off, typically the SSI or operations manager. It cannot be the person who requested it.
        }
    )

    pageItem P71_CREATED_BY (
        type: displayOnly
        label {
            label: Requested by
            alignment: right
        }
        layout {
            sequence: 80
            region: @decision
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
    )

    pageItem P71_DEVIATION_DATE (
        type: datePicker
        label {
            label: Deviation observed on
            alignment: right
        }
        layout {
            sequence: 20
            region: @decision
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        help {
            helpText: The day the deviation itself was observed and accepted, which is not the day this record was captured.
        }
        readOnly {
            type: expression
            plsqlExpression: :P71_STATUS <> 'DRAFT'
        }
    )

    pageItem P71_DOCUMENT_REF (
        type: textField
        label {
            label: External reference
            alignment: right
        }
        layout {
            sequence: 70
            region: @decision
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        help {
            helpText: Ticket, mail or EDM reference of the formalising document. Distinct from the files attached below.
        }
        readOnly {
            type: expression
            plsqlExpression: :P71_STATUS <> 'DRAFT'
        }
    )

    pageItem P71_DOC_KIND (
        type: selectList
        label {
            label: Document type
            alignment: right
        }
        lov {
            type: sharedComponent
            lov: @exception-doc-kind
            displayNullValue: false
        }
        layout {
            sequence: 10
            region: @documents
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
    )

    pageItem P71_END_DATE (
        type: datePicker
        label {
            label: Applies until
            alignment: right
        }
        layout {
            sequence: 40
            region: @decision
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        help {
            helpText: Leave empty for an open-ended derogation. Pushing this date back after approval sends the derogation back for approval.
        }
        readOnly {
            type: expression
            plsqlExpression: :P71_STATUS <> 'DRAFT'
        }
    )

    pageItem P71_ENTITY_ID (
        type: hidden
        layout {
            sequence: 30
            region: @scope
            slot: regionBody
        }
    )

    pageItem P71_ENTITY_TYPE (
        type: selectList
        label {
            label: Scope level
            alignment: right
        }
        lov {
            type: sharedComponent
            lov: @exception-entity-type
            displayNullValue: false
        }
        layout {
            sequence: 50
            region: @scope
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        help {
            helpText: The derogation cascades downwards: granted on a host it covers its instances, their databases and their storage units.
        }
    )

    pageItem P71_EXCEPTION_ID (
        type: hidden
        layout {
            sequence: 10
            region: @scope
            slot: regionBody
        }
    )

    pageItem P71_FINDING_ROWID (
        type: hidden
        layout {
            sequence: 15
            region: @scope
            slot: regionBody
        }
        comments {
            comments: The finding a new derogation is opened from. The scope is read from it server-side rather than passed in the URL, where APEX splits values on commas and truncated observed values such as "Oracle 18c (18.14.0.0.0), out of support since 2021-06-30".
        }
    )

    pageItem P71_ITEM_KEY (
        type: textField
        label {
            label: Item
            alignment: right
        }
        layout {
            sequence: 70
            region: @scope
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        help {
            helpText: The item inside the entity the derogation covers, or * for every item the rule evaluates.
        }
        readOnly {
            type: expression
            plsqlExpression: :P71_STATUS <> 'DRAFT'
        }
    )

    pageItem P71_JUSTIFICATION (
        type: textarea
        label {
            label: Justification
            alignment: right
        }
        layout {
            sequence: 60
            region: @decision
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        help {
            helpText: Why the deviation is accepted. This is what an auditor reads first.
        }
        readOnly {
            type: expression
            plsqlExpression: :P71_STATUS <> 'DRAFT'
        }
    )

    pageItem P71_NOTE (
        type: textarea
        label {
            label: Note
            alignment: right
        }
        layout {
            sequence: 100
            region: @decision
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        help {
            helpText: Attached to the transition in the audit trail: why it is submitted, approved, rejected, revoked or maintained.
        }
    )

    pageItem P71_OBSERVED_VALUE (
        type: textField
        label {
            label: Observed value
            alignment: right
        }
        layout {
            sequence: 80
            region: @scope
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        help {
            helpText: Pins the derogation to the value that was accepted. Leave * to cover any value; a setting drifting to another value then keeps its cover.
        }
        readOnly {
            type: expression
            plsqlExpression: :P71_STATUS <> 'DRAFT'
        }
    )

    pageItem P71_REVIEW_DUE_DATE (
        type: datePicker
        label {
            label: Review due
            alignment: right
        }
        layout {
            sequence: 50
            region: @decision
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        help {
            helpText: Defaults to one year after the derogation takes effect.
        }
        readOnly {
            type: expression
            plsqlExpression: :P71_STATUS <> 'DRAFT'
        }
    )

    pageItem P71_RULE_CODE (
        type: hidden
        layout {
            sequence: 20
            region: @scope
            slot: regionBody
        }
    )

    pageItem P71_RULE_TITLE (
        type: displayOnly
        label {
            label: Rule
            alignment: right
        }
        layout {
            sequence: 40
            region: @scope
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
    )

    pageItem P71_SCOPE_NAME (
        type: displayOnly
        label {
            label: Entity
            alignment: right
        }
        layout {
            sequence: 60
            region: @scope
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
    )

    pageItem P71_START_DATE (
        type: datePicker
        label {
            label: Applies from
            alignment: right
        }
        layout {
            sequence: 30
            region: @decision
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :P71_STATUS = 'DRAFT'
        }
    )

    pageItem P71_IN_FORCE_FROM (
        type: displayOnly
        label {
            label: Applies from
            alignment: right
        }
        layout {
            sequence: 31
            region: @decision
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :P71_STATUS <> 'DRAFT'
        }
        comments {
            comments: The exact instant the derogation applies from, to the second. A renewal comes into force at the second of its approval and the derogation it replaces covers up to that instant; the date picker, which edits a draft by the day, cannot show it.
        }
    )

    pageItem P71_STATUS (
        type: displayOnly
        label {
            label: Status
            alignment: right
        }
        layout {
            sequence: 10
            region: @decision
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
    )

    pageItem P71_UPLOAD (
        type: fileUpload
        label {
            label: Attach a file
        }
        storage {
            type: appTempFiles
        }
        layout {
            sequence: 20
            region: @documents
            slot: regionBody
        }
        appearance {
            template: @/optional-floating
        }
        help {
            helpText: Licence, vendor manual, signed approval. Each file is fingerprinted with SHA-256 when attached, so it can later be proven to be the one that was filed.
        }
        comments {
            comments: storage.type appTempFiles is load-bearing: the attach process reads the file from apex_application_temp_files. Left unset, the item inherits storage type DB_COLUMN, a BLOB column it has no source for, and the page dies at render with WWV_FLOW_NATIVE_ITEM.NO_VALID_BLOB_SOURCE. Until 2026-11-10 this was believed impossible to write in the .apx - the compiler metadata lists no such group - and was set in the builder after every import. Wrong: the block is accepted and applied by compiler 26.1.0+3102 and 26.2.0+3479 alike. T_001 check 2 still verifies it after each import.
        }
    )

    button approve (
        buttonName: APPROVE
        label: Approve
        layout {
            sequence: 40
            region: @decision
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :P71_STATUS = 'SUBMITTED'
        }
    )

    button attach (
        buttonName: ATTACH
        label: Attach
        layout {
            sequence: 30
            region: @documents
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :P71_EXCEPTION_ID is not null and :P71_STATUS in ( 'DRAFT', 'APPROVED' )
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 10
            region: @decision
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button record-review (
        buttonName: RECORD_REVIEW
        label: Record Review
        layout {
            sequence: 70
            region: @decision
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :P71_STATUS = 'APPROVED'
        }
    )

    button renew (
        buttonName: RENEW
        label: Renew
        layout {
            sequence: 65
            region: @decision
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :P71_STATUS = 'APPROVED'
        }
        comments {
            comments: An approved derogation is frozen. Renew captures a new draft with the same scope, chained to this one, which keeps covering until the renewal is approved and then becomes SUPERSEDED. That is how an approved derogation is extended or widened without rewriting a signed decision.
        }
    )

    button reject (
        buttonName: REJECT
        label: Reject
        layout {
            sequence: 50
            region: @decision
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :P71_STATUS = 'SUBMITTED'
        }
    )

    button revoke (
        buttonName: REVOKE
        label: Revoke
        layout {
            sequence: 60
            region: @decision
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :P71_STATUS = 'APPROVED' or ( :P71_STATUS = 'DRAFT' and :P71_EXCEPTION_ID is not null )
        }
    )

    button save (
        buttonName: SAVE
        label: Save
        layout {
            sequence: 20
            region: @decision
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :P71_STATUS = 'DRAFT'
        }
    )

    button submit-for-approval (
        buttonName: SUBMIT_FOR_APPROVAL
        label: Submit
        layout {
            sequence: 30
            region: @decision
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :P71_STATUS = 'DRAFT' and :P71_EXCEPTION_ID is not null
        }
    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-cancel-dialog (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process approve-derogation (
        name: Approve Derogation
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                pkg_dbinv_exception.approve(
                   p_exception_id => :P71_EXCEPTION_ID,
                   p_approver     => nvl(:P71_APPROVER, :APP_USER),
                   p_note         => :P71_NOTE );
                ```
        }
        execution {
            sequence: 40
        }
        advanced {
            executionMappingIdentifier: 4581098197192499
        }
        serverSideCondition {
            whenButtonPressed: @approve
        }
    )

    process attach-document (
        name: Attach Document
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                -- The instr form covers a multi-file upload too, where APEX puts a
                -- colon-separated list of names in the item.
                for f in ( select filename, mime_type, blob_content
                             from apex_application_temp_files
                            where instr(':' || :P71_UPLOAD || ':', ':' || name || ':') > 0 ) loop
                   declare
                      l_id number;
                   begin
                      l_id := pkg_dbinv_exception.add_document(
                                 p_exception_id => :P71_EXCEPTION_ID,
                                 p_file_name    => f.filename,
                                 p_content      => f.blob_content,
                                 p_mime_type    => f.mime_type,
                                 p_doc_kind     => nvl(:P71_DOC_KIND, 'OTHER') );
                   end;
                end loop;
                delete from apex_application_temp_files
                 where instr(':' || :P71_UPLOAD || ':', ':' || name || ':') > 0;
                ```
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 4580875413192499
        }
        serverSideCondition {
            whenButtonPressed: @attach
        }
    )

    process close-derogation-dialog (
        name: Close Derogation Dialog
        type: closeDialog
        comments {
            comments: Closes after every action that changes the derogation, not only Save, so the caller (pages 21/31/41, page 70) refreshes and shows the new status. Attach Document stays: it adds a file to the derogation being edited. A failing action raises an error and stops processing before this point, so the dialog stays open on it.
        }
        execution {
            sequence: 90
        }
        advanced {
            executionMappingIdentifier: 4581429391192499
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: SAVE,SUBMIT_FOR_APPROVAL,APPROVE,REJECT,REVOKE,RECORD_REVIEW
        }
    )

    process load-derogation (
        name: Load Derogation
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                if :P71_EXCEPTION_ID is not null then
                   select e.status, e.rule_code, e.entity_type, e.entity_id, e.item_key,
                          e.observed_value, e.deviation_date, e.start_date, e.end_date,
                          e.review_due_date, e.justification, e.document_ref, e.created_by,
                          v.rule_title, v.scope_name
                     into :P71_STATUS, :P71_RULE_CODE, :P71_ENTITY_TYPE, :P71_ENTITY_ID, :P71_ITEM_KEY,
                          :P71_OBSERVED_VALUE, :P71_DEVIATION_DATE, :P71_START_DATE, :P71_END_DATE,
                          :P71_REVIEW_DUE_DATE, :P71_JUSTIFICATION, :P71_DOCUMENT_REF, :P71_CREATED_BY,
                          :P71_RULE_TITLE, :P71_SCOPE_NAME
                     from ref_exception e
                     join v_exception_review v on v.exception_id = e.exception_id
                    where e.exception_id = :P71_EXCEPTION_ID;
                   -- Read from the table, not from P71_START_DATE: the item holds the
                   -- day as a string, the time is already gone.
                   select to_char( start_date, 'DD/MM/YYYY HH24:MI:SS' ) into :P71_IN_FORCE_FROM
                     from ref_exception where exception_id = :P71_EXCEPTION_ID;
                else
                   -- New derogation, opened from a finding: the scope is read from
                   -- the finding itself, so the technical keys are never typed by
                   -- hand. Only its ROWID travels in the URL: APEX splits URL
                   -- values on commas, which truncated observed values, and an
                   -- escaped value breaks on the backslash of a Windows login. A
                   -- truncated value never equals the finding's, so the
                   -- derogation silently covered nothing.
                   if :P71_FINDING_ROWID is not null then
                      select f.rule_code, f.entity_type, f.entity_id, f.item_key, f.observed_value
                        into :P71_RULE_CODE, :P71_ENTITY_TYPE, :P71_ENTITY_ID, :P71_ITEM_KEY, :P71_OBSERVED_VALUE
                        from fact_control_finding f
                       where f.rowid = chartorowid( translate( :P71_FINDING_ROWID, '-_', '+/' ) );
                   end if;
                   :P71_STATUS := 'DRAFT';
                   :P71_ITEM_KEY := nvl(:P71_ITEM_KEY, '*');
                   :P71_OBSERVED_VALUE := nvl(:P71_OBSERVED_VALUE, '*');
                   :P71_DEVIATION_DATE := nvl(:P71_DEVIATION_DATE, trunc(sysdate));
                   :P71_START_DATE := nvl(:P71_START_DATE, trunc(sysdate));
                   :P71_CREATED_BY := :APP_USER;
                   if :P71_RULE_CODE is not null then
                      select r.title into :P71_RULE_TITLE
                        from ref_control_rule r where r.rule_code = :P71_RULE_CODE;
                   end if;
                end if;
                ```
