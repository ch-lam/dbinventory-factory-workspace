page 81 (
    name: DB Inv. - Application
    alias: DB-INV-APPLICATION
    title: DB Inv. - Application
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region identity (
        name: Application
        title: Application
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        comments {
            comments: A full page rather than a modal, unlike the derogation screen. The registry has four sub-registers under the header, which a modal makes cramped, and a full page is also reachable by URL - so the page test can open it directly instead of having to find and follow a link, which is where that test has lied before.
        }
    )

    region software (
        name: Software and support
        title: Software and support
        type: staticContent
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        comments {
            comments: Kept apart from the identity block on purpose. Identity is what the application is; this is what it is made of and until when somebody else will fix it. The support end date is the one field here that turns into an incident on a known day, which is why it is a date and not a sentence in the description.
        }
    )

    region continuity (
        name: Continuity and data
        title: Continuity and data
        type: staticContent
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        comments {
            comments: The block the RSSI and the DPO read, and the reason the registry is worth filling in beyond a phone number. Recovery objectives say what a failure costs; data sensitivity says what a breach costs. Health data is its own value rather than a flavour of sensitive, because in this estate it is the common case and merging the two would hide the one answer the DPO came for.
        }
    )

    region attachments (
        name: Attachments
        title: Attachments
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select case ae.entity_type
                          when 'HOST' then 'Host'
                          when 'INSTANCE' then 'Instance'
                          else 'Database'
                       end level_label,
                       case ae.entity_type
                          when 'HOST' then ( select h.hostname from dim_host h
                                              where h.host_id = ae.entity_id )
                          when 'INSTANCE' then ( select i.instance_name from dim_instance i
                                                  where i.instance_id = ae.entity_id )
                          else ( select d.db_name from dim_database d
                                  where d.database_id = ae.entity_id )
                       end entity_name,
                       ae.note,
                       ae.created_by,
                       ae.created_date,
                       ae.app_entity_id,
                       'Detach' remove_link
                  from ref_application_entity ae
                 where ae.application_id = :P81_APPLICATION_ID
                   and ae.active = 1
                ```
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        comments {
            comments: The attachment rows, as opposed to the Databases region below which shows what they resolve to. Two attachments can cover thirty-six databases, so these are the rows you edit and that one is the consequence. Detaching happens here.
        }
        reportLayout {
            numberOfRows: 15
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--altRowsDefault
            ]
        }
        messages {
            whenNoDataFound: Nothing attached - this application covers no database
        }

        column APP_ENTITY_ID (
            reportColumnQueryId: 6
            derivedColumn: N
            type: hidden
            layout {
                sequence: 5
            }
        )

        column CREATED_BY (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Attached by
            }
            layout {
                sequence: 40
            }
        )

        column CREATED_DATE (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Attached on
            }
            layout {
                sequence: 50
            }
        )

        column ENTITY_NAME (
            reportColumnQueryId: 2
            derivedColumn: N
            type: link
            heading {
                heading: Attached to
            }
            layout {
                sequence: 20
            }
            link {
                target: {
                    page: 83
                    items: {
                        P83_APP_ENTITY_ID: #APP_ENTITY_ID#
                    }
                    clearCache: 83
                }
                linkText: #ENTITY_NAME#
            }
        )

        column LEVEL_LABEL (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Level
            }
            layout {
                sequence: 10
            }
        )

        column NOTE (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Note
            }
            layout {
                sequence: 30
            }
        )

        column REMOVE_LINK (
            reportColumnQueryId: 7
            derivedColumn: N
            type: link
            heading {
                heading: Detach
            }
            layout {
                sequence: 90
                columnAlignment: center
            }
            link {
                target: {
                    page: 83
                    items: {
                        P83_APP_ENTITY_ID: #APP_ENTITY_ID#
                        P83_MODE: REMOVE
                    }
                    clearCache: 83
                }
                linkText: <span class="fa fa-trash-o" aria-hidden="true"></span><span class="u-VisuallyHidden">Detach</span>
                linkAttributes: title="Detach"
            }
        )

    )

    region databases (
        name: Databases covered
        title: Databases covered
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select d.db_name,
                       d.platform,
                       d.environment,
                       i.instance_name,
                       h.hostname,
                       ad.attached_at
                  from v_application_database ad
                  join dim_database d on d.database_id = ad.database_id
                  join dim_instance i on i.instance_id = d.instance_id
                  join dim_host h on h.host_id = i.host_id
                 where ad.application_id = :P81_APPLICATION_ID
                ```
        }
        layout {
            sequence: 50
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        comments {
            comments: Shows what the cascade resolves, not the attachment rows. attached_at is displayed on purpose: a database listed because its whole instance belongs to this application is a different statement from one named explicitly, and detaching them is a different action.
        }
        reportLayout {
            numberOfRows: 25
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--altRowsDefault
            ]
        }
        messages {
            whenNoDataFound: No database attached yet
        }

        column ATTACHED_AT (
            reportColumnQueryId: 6
            derivedColumn: N
            heading {
                heading: Attached at
            }
            layout {
                sequence: 60
            }
        )

        column DB_NAME (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Database
            }
            layout {
                sequence: 10
            }
        )

        column ENVIRONMENT (
