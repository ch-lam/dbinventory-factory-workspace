        }
        behavior {
            action: submitPage
            warnOnUnsavedChanges: doNotCheck
        }
        comments {
            comments: warnOnUnsavedChanges is set to doNotCheck on purpose. Left out, a submit button takes the page default, which is to warn on this full page - and the browser then asked to confirm leaving the page on every Save, the one click that saves the changes it warns about. The page warning stays on for real navigation away.
        }
    )

    dynamicAction refresh-after-attachment-dialog (
        name: Refresh After Attachment Dialog
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @attachments
        }

        action refresh-attachments (
            action: refresh
            affectedElements {
                selectionType: region
                region: @attachments
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action refresh-databases (
            action: refresh
            affectedElements {
                selectionType: region
                region: @databases
            }
            execution {
                sequence: 20
                fireOnInit: false
