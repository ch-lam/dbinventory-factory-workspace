    region documents (
        name: Documentation
        title: Documentation
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select r.doc_kind,
                       r.title,
                       case when r.file_name is not null then r.file_name
                            else r.external_url end location,
                       r.review_state,
                       r.review_due_date,
                       r.review_rank,
                       r.document_id,
                       'Edit' edit_link,
                       'Remove' remove_link
                  from v_application_document_review r
                 where r.application_id = :P81_APPLICATION_ID
                ```
        }
        layout {
            sequence: 80
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        comments {
            comments: A document is stored, linked, or both. The location column shows the file name when there is one and the URL otherwise, so a reader can tell at a glance which documents live here and which only have a pointer. Upload happens on page 85, whose fileUpload item carries storage { type: appTempFiles } in its .apx (APEXLang compiler 26.2+); post_import.sh checks after every import that it held - see DEPLOY.md.
        }
        reportLayout {
            numberOfRows: 20
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--altRowsDefault
            ]
        }
        messages {
            whenNoDataFound: No documentation recorded
        }

