    region contacts (
        name: Named contacts
        title: Named contacts
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select t.label,
                       c.full_name,
                       c.job_title,
                       c.email,
                       c.phone,
                       c.ldap_login,
                       case c.is_primary when 1 then 'Yes' end first_to_try,
                       t.sort_order * 10 + ( 1 - c.is_primary ) sort_key,
                       c.contact_id,
                       'Edit' edit_link,
                       'Remove' remove_link
                  from ref_application_contact c
                  join ref_application_group_type t
                    on t.group_type_code = c.contact_role
                 where c.application_id = :P81_APPLICATION_ID
                   and c.active = 1
                ```
        }
        layout {
            sequence: 70
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        comments {
            comments: Sits directly under the groups because it answers the same question at a different range. The sort key puts the people marked first to try at the top of their role, which is the order somebody reads this list in when something is already broken.
        }
        reportLayout {
            numberOfRows: 20
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
