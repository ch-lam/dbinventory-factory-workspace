    process load-application (
        name: Load Application
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                if :P81_APPLICATION_ID is not null then
                   select a.app_code, a.app_name, a.description, a.criticality,
                          a.lifecycle_status, a.review_due_date,
                          nvl(to_char(a.last_review_date, 'YYYY-MM-DD')
                              || ' by ' || a.last_review_by, 'never'),
                          a.sourcing, a.vendor_name, a.product_version, a.support_end_date,
                          to_char(a.rto_minutes), to_char(a.rpo_minutes), a.service_window,
                          a.data_sensitivity, a.processing_register_ref
                     into :P81_APP_CODE, :P81_APP_NAME, :P81_DESCRIPTION, :P81_CRITICALITY,
                          :P81_LIFECYCLE_STATUS, :P81_REVIEW_DUE_DATE, :P81_LAST_REVIEW,
                          :P81_SOURCING, :P81_VENDOR_NAME, :P81_PRODUCT_VERSION, :P81_SUPPORT_END_DATE,
                          :P81_RTO_MINUTES, :P81_RPO_MINUTES, :P81_SERVICE_WINDOW,
                          :P81_DATA_SENSITIVITY, :P81_PROCESSING_REGISTER_REF
                     from ref_application a
                    where a.application_id = :P81_APPLICATION_ID;
                else
                   :P81_CRITICALITY := 'STANDARD';
                   :P81_LIFECYCLE_STATUS := 'ACTIVE';
                   :P81_LAST_REVIEW := 'never';
                   :P81_SOURCING := 'UNKNOWN';
                   :P81_DATA_SENSITIVITY := 'UNKNOWN';
                end if;
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
    )

    process save-application (
        name: Save Application
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                -- Writes go through the package, which validates and dates. The
                -- journal is written by a trigger either way, so a future screen
                -- that forgets this call still leaves a trace -- it just leaves
                -- one without a reason attached.
                declare
                   l_rto number;
                   l_rpo number;

                   -- Caught here rather than left to ORA-01722, which names a
                   -- conversion and not the box that was typed in.
                   function minutes ( p_value varchar2, p_label varchar2 ) return number is
                   begin
                      if p_value is null then
                         return null;
                      end if;
                      return to_number(trim(p_value));
                   exception
                      when others then
                         raise_application_error(-20053,
                            p_label || ' must be a number of minutes. Four hours is 240.');
                   end minutes;
                begin
                   l_rto := minutes(:P81_RTO_MINUTES, 'RTO');
                   l_rpo := minutes(:P81_RPO_MINUTES, 'RPO');

                   if :P81_APPLICATION_ID is null then
                      :P81_APPLICATION_ID := pkg_dbinv_application.create_application(
                         p_app_code         => :P81_APP_CODE,
                         p_app_name         => :P81_APP_NAME,
                         p_description      => :P81_DESCRIPTION,
                         p_criticality      => :P81_CRITICALITY,
                         p_lifecycle_status => :P81_LIFECYCLE_STATUS );
                   else
                      pkg_dbinv_application.update_application(
                         p_application_id   => :P81_APPLICATION_ID,
                         p_app_name         => :P81_APP_NAME,
                         p_description      => :P81_DESCRIPTION,
                         p_criticality      => :P81_CRITICALITY,
                         p_lifecycle_status => :P81_LIFECYCLE_STATUS,
                         p_note             => 'edited from the application screen' );
                   end if;

                   -- Both branches, on purpose. This used to run only on update,
                   -- so a review date typed on the creation screen was dropped
                   -- without a word and the entry came back as never planned.
                   pkg_dbinv_application.set_profile(
                      p_application_id   => :P81_APPLICATION_ID,
                      p_sourcing         => :P81_SOURCING,
                      p_vendor_name      => :P81_VENDOR_NAME,
                      p_product_version  => :P81_PRODUCT_VERSION,
                      p_support_end_date => :P81_SUPPORT_END_DATE,
                      p_rto_minutes      => l_rto,
                      p_rpo_minutes      => l_rpo,
                      p_service_window   => :P81_SERVICE_WINDOW,
                      p_data_sensitivity => :P81_DATA_SENSITIVITY,
                      p_register_ref     => :P81_PROCESSING_REGISTER_REF,
                      p_review_due_date  => :P81_REVIEW_DUE_DATE,
                      p_note             => 'edited from the application screen' );
                end;
                ```
        }
        execution {
            sequence: 20
        }
        serverSideCondition {
            whenButtonPressed: @save
        }
        successMessage {
            successMessage: Application saved
        }
    )

    process review-application (
        name: Record Review
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                pkg_dbinv_application.record_review(
                   p_application_id => :P81_APPLICATION_ID,
                   p_note           => 'reviewed from the application screen',
                   p_next_months    => 12 );
                ```
        }
        execution {
            sequence: 30
        }
        serverSideCondition {
            whenButtonPressed: @record-review
        }
        successMessage {
            successMessage: Review recorded, next one due in 12 months
        }
    )

)
