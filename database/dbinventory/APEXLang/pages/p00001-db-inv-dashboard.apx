page 1 (
    name: DB Inv. - Dashboard
    alias: DB-INV-DASHBOARD
    title: DB Inv. -  Dashboard
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region page-title (
        name: DB Inv. -  Dashboard
        type: staticContent
        layout {
            sequence: 1
            slot: body
        }
        appearance {
            template: @/title-bar
            templateOptions: #DEFAULT#
        }
    )

    region compliance (
        name: Scoring Activity
        title: Scoring Activity
        type: cards
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                with latest as (
                    select platform,
                           score_domain,
                           max(snapshot_date) snapshot_date
                      from fact_scoring
                     where entity_type = 'ENVIRONMENT'
                     group by platform, score_domain
                ), agg as (
                    select f.platform,
                           f.score_domain,
                           f.snapshot_date,
                           round(avg(f.score_value)) score_value
                      from fact_scoring f
                      join latest l
                        on l.platform      = f.platform
                       and l.score_domain  = f.score_domain
                       and l.snapshot_date = f.snapshot_date
                     where f.entity_type = 'ENVIRONMENT'
                     group by f.platform, f.score_domain, f.snapshot_date
                )
                select initcap(platform)||' '||initcap(score_domain) scoring_type,
                       to_char(snapshot_date, 'DD/MM/YYYY') last_scoring_date,
                       score_value||'%' last_scoring_value,
                       case when score_value >= 90 then 'u-color-4-border'
                            when score_value >= 70 then 'u-color-7-border'
                            else 'u-color-1-border' end scoring_card_class,
                       'fa fa-shield' SCORING_ICON,
                       case when score_value >= 90 then 'OK'
                            when score_value >= 70 then 'Warning'
                            else 'Critical' end scoring_status,
                       case when score_value >= 90 then 'u-color-4'
                            when score_value >= 70 then 'u-color-7'
                            else 'u-color-1' end status_color,
                       initcap(score_domain)||' score is '||score_value||'%, '
                       ||case when score_value >= 90 then 'all checks passed.'
                              when score_value >= 70 then 'some checks need improvement.'
                              else 'several checks are failing.' end scoring_label,
                       apex_page.get_url( p_page => case platform when 'ORACLE' then 2 when 'MSSQL' then 3 when 'POSTGRES' then 4 else 1 end ) details_apex_page_number,
                       row_number() over ( order by platform, score_domain ) scoring_order
                  from agg
                 order by scoring_order asc
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/cards-container
            templateOptions: [
                #DEFAULT#
                t-CardsRegion--hideHeader js-addHiddenHeadingRoleDesc
            ]
        }
        componentAppearance {
            gridColumns: 4
        }
        card {
            primaryKeyColumn1: SCORING_TYPE
        }
        title {
            column: SCORING_TYPE
        }
        body {
            column: SCORING_LABEL
        }
        secondaryBody {
            column: LAST_SCORING_DATE
        }
        iconAndBadge {
            badgeColumn: LAST_SCORING_VALUE
            badgeLabel: &SCORING_STATUS.
            badgeCssClasses: &STATUS_COLOR.
        }

        action action (
            label: View Details
            layout {
                sequence: 10
            }
            behavior {
                type: redirectUrl
                targetUrl: &DETAILS_APEX_PAGE_NUMBER.
            }
        )

    )

    region environment-distribution (
        name: Environments
        title: Environments
        type: chart
        layout {
            sequence: 40
            slot: body
            startNewRow: false
            columnSpan: 4
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                i-h320
                t-Region--scrollBody
            ]
        }
        chart {
            type: pie
        }
        legend {
            position: bottom
        }

        series environments (
            name: Environment
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select nvl(environment, 'UNKNOWN') as label,
                           count(*) as value
                      from dim_host
                     group by nvl(environment, 'UNKNOWN')
                     order by value desc
                    ```
            }
            columnMapping {
                label: LABEL
                value: VALUE
            }
        )

    )

    region mssql-versions (
        name: MySQL : Versions
        title: MySQL : Versions
        type: chart
        layout {
            sequence: 90
            slot: body
            startNewRow: false
            columnSpan: 4
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                i-h320
                t-Region--scrollBody
            ]
        }
        chart {
            type: pie
        }
        legend {
            position: bottom
        }

        series mssql-versions (
            name: MySQL Versions
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select nvl(engine_version, 'UNKNOWN') as label,
                           count(*) as value
                      from dim_instance
                     where platform = 'MYSQL'
                     group by nvl(engine_version, 'UNKNOWN')
                     order by value desc
                    ```
            }
            columnMapping {
                label: LABEL
                value: VALUE
            }
        )

    )

