page 1 (
    name: DB Inv. - Dashboard
    alias: DB-INV-DASHBOARD
    title: DB Inv. -  Dashboard
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region compliance (
        name: Compliance & Security
        title: Compliance & Security
        type: cards
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                with latest as (
                    select platform,
                           score_domain,
                           max(snapshot_date) snapshot_date
                      from fact_scoring
                     where entity_type = 'ENVIRONMENT'
                     group by platform, score_domain
                ), agg as (
                    select f.platform,
                           f.score_domain,
                           f.snapshot_date,
                           round(avg(f.score_value)) score_value
                      from fact_scoring f
                      join latest l
                        on l.platform      = f.platform
                       and l.score_domain  = f.score_domain
                       and l.snapshot_date = f.snapshot_date
                     where f.entity_type = 'ENVIRONMENT'
                     group by f.platform, f.score_domain, f.snapshot_date
                )
                select initcap(platform)||' '||initcap(score_domain) scoring_type,
                       to_char(snapshot_date, 'DD/MM/YYYY') last_scoring_date,
                       score_value||'%' last_scoring_value,
                       case when score_value >= 90 then 'u-color-4-border'
                            when score_value >= 70 then 'u-color-7-border'
                            else 'u-color-9-border' end scoring_card_class,
                       'fa fa-shield' SCORING_ICON,
                       case when score_value >= 90 then 'OK'
                            when score_value >= 70 then 'Warning'
                            else 'Critical' end scoring_status,
                       case when score_value >= 90 then 'u-color-4'
                            when score_value >= 70 then 'u-color-7'
                            else 'u-color-9' end status_color,
                       initcap(score_domain)||' score is '||score_value||'%, '
                       ||case when score_value >= 90 then 'all checks passed.'
                              when score_value >= 70 then 'some checks need improvement.'
                              else 'several checks are failing.' end scoring_label,
                       apex_page.get_url( p_page => case platform when 'ORACLE' then 21 when 'MSSQL' then 31 when 'POSTGRES' then 41 when 'MYSQL' then 51 else 1 end ) details_apex_page_number,
                       row_number() over ( order by platform, score_domain ) scoring_order
                  from agg
                 order by scoring_order asc
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/cards-container
            templateOptions: [
                #DEFAULT#
                t-CardsRegion--hideHeader js-addHiddenHeadingRoleDesc
            ]
        }
        componentAppearance {
            gridColumns: 4
        }
        card {
            cssClasses: &SCORING_CARD_CLASS.
            primaryKeyColumn1: SCORING_TYPE
        }
        title {
            column: SCORING_TYPE
        }
        subtitle {
            cssClasses: &SCORING_CARD_CLASS.
        }
        body {
            column: SCORING_LABEL
        }
        secondaryBody {
            column: LAST_SCORING_DATE
        }
        iconAndBadge {
            badgeColumn: LAST_SCORING_VALUE
            badgeLabel: &SCORING_STATUS.
            badgeCssClasses: &STATUS_COLOR.
        }

        action action (
            label: View Details
            layout {
                sequence: 10
            }
            behavior {
                type: redirectUrl
                targetUrl: &DETAILS_APEX_PAGE_NUMBER.
            }
            appearance {
                cssClasses: &SCORING_CARD_CLASS.
            }
        )

    )

    region databases (
        name: Databases
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select 
                  ( Select COUNT(*) From DIM_DATABASE Where PLATFORM = 'ORACLE') ORACLE,
                  ( Select COUNT(*) From DIM_DATABASE Where PLATFORM = 'MSSQL' And db_name Not In ( 'master', 'msdb', 'tempdb', 'model')) MSSQL,
                  -- 'postgres' est ecartee comme master/msdb/tempdb/model le sont
                  -- au-dessus : c'est la base de maintenance du cluster, pas une base
                  -- applicative. template0/template1 ne sont deja pas collectees.
                  ( Select COUNT(*) From DIM_DATABASE Where PLATFORM = 'POSTGRES' And db_name <> 'postgres' ) POSTGRES,
                  ( Select COUNT(*) From DIM_DATABASE Where PLATFORM = 'MYSQL') MYSQL
                From DUAL;
                
                ```
        }
        layout {
            sequence: 30
            slot: body
            column: 1
            columnSpan: 12
        }
        appearance {
            template: @/blank-with-attributes-no-grid
            templateOptions: [
                #DEFAULT#
                t-Form--stretchInputs
            ]
        }
        reportLayout {
            numberOfRows: 1
        }
        componentAppearance {
            template: @/badge-list
            templateOptions: [
                #DEFAULT#
                u-colors
                t-BadgeList--large
                t-BadgeList--dash
                t-BadgeList--fixed
                t-Report--hideNoPagination
            ]
        }

        column MSSQL (
            reportColumnQueryId: 2
            derivedColumn: N
            type: link
            heading {
                heading: MSSQL
                alignment: end
            }
            layout {
                sequence: 20
                columnAlignment: end
            }
            link {
                target: {
                    page: 30
                }
                linkText: #MSSQL#
            }
        )

        column MYSQL (
            reportColumnQueryId: 4
            derivedColumn: N
            type: link
            heading {
                heading: MySQL
                alignment: end
            }
            layout {
                sequence: 40
                columnAlignment: end
            }
            link {
                target: {
                    page: 50
                }
                linkText: #MYSQL#
            }
        )

        column ORACLE (
            reportColumnQueryId: 1
            derivedColumn: N
            type: link
            heading {
                heading: Oracle
                alignment: end
            }
            layout {
                sequence: 10
                columnAlignment: end
            }
            link {
                target: {
                    page: 20
                }
                linkText: #ORACLE#
            }
        )

        column POSTGRES (
            reportColumnQueryId: 3
            derivedColumn: N
            type: link
            heading {
                heading: PostGres
                alignment: end
            }
            layout {
                sequence: 30
                columnAlignment: end
            }
            link {
                target: {
                    page: 40
                }
                linkText: #POSTGRES#
            }
        )

    )

    region environment-distribution (
        name: Environments
        title: Environments
        type: chart
        layout {
            sequence: 50
            slot: body
            startNewRow: false
            columnSpan: 4
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                i-h320
                t-Region--stacked
                t-Region--scrollBody
            ]
        }
        tooltip {
            show: false
        }
        legend {
            show: false
        }

        series environments (
            name: Environment
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select nvl(environment, 'UNKNOWN') as label,
                           count(*) as value
                      from dim_host
                     group by nvl(environment, 'UNKNOWN')
                     order by value desc
                    ```
            }
            columnMapping {
                label: LABEL
                value: VALUE
            }
            label {
                show: true
            }
        )

        axis x (
            name: x
        )

        axis y (
            name: y
            value {
                format: decimal
                decimalPlaces: 0
                formatScaling: none
            }
        )

    )

    region mssql-versions_1 (
        name: MSSQL : Versions
        title: MSSQL : Versions
        type: chart
        layout {
            sequence: 70
            slot: body
            columnSpan: 4
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                i-h320
                t-Region--scrollBody
            ]
        }
        chart {
            type: donut
        }
        settings {
            pieSelectionEffect: highlightAndExplode
        }
        value {
            format: decimal
            decimalPlaces: 0
            formatScaling: none
        }
        legend {
            position: bottom
        }

        series mssql-versions (
            name: MSSQL Versions
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    With SQL_VERSIONS As
                      ( select decode( substr( engine_version, 1, instr( engine_version, '.')-1), 10, 'SQL 2008/2008 R2', 11, 'SQL 2012', 12, 'SQL 2014', 13, 'SQL 2016', 14, 'SQL 2017', 15, 'SQL 2019', 16, 'SQL 2022', 17, 'SQL 2025', 'Unknown Yet') SQL_VERSION
                         from dim_instance where platform = 'MSSQL' )
                    select SQL_VERSION as label,
                           count(*) as value
                      from SQL_VERSIONS
                     group by SQL_VERSION order by value desc
                    ```
            }
            columnMapping {
                label: LABEL
                value: VALUE
            }
        )

    )

    region mysql-versions (
        name: MySQL: Versions
        title: MySQL : Versions
        type: chart
        layout {
            sequence: 90
            slot: body
            startNewRow: false
            columnSpan: 4
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                i-h320
                t-Region--scrollBody
            ]
        }
        chart {
            type: donut
        }
        settings {
            pieSelectionEffect: highlightAndExplode
        }
        value {
            format: decimal
            decimalPlaces: 0
            formatScaling: none
        }
        legend {
            position: bottom
        }

        series mysql-versions (
            name: MySQL Versions
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    -- Une version MySQL se lit sur majeure.mineure (5.7, 8.0, 8.4) :
                    -- 8.0 et 8.4 sont deux versions distinctes, pas deux correctifs
                    -- d'une meme majeure. Rien n'est collecte sur MySQL aujourd'hui,
                    -- mais ce graphe heritait de la table des noms SQL Server et
                    -- aurait affiche « SQL 2019 » pour une instance en 8.0.
                    With MYSQL_VERSIONS As
                      ( select nvl( regexp_substr( engine_version, '^\d+\.\d+' ), 'Unknown' ) MYSQL_VERSION
                          from dim_instance where platform = 'MYSQL' )
                    select 'MySQL ' || MYSQL_VERSION as label,
                           count(*) as value
                      from MYSQL_VERSIONS
                     group by MYSQL_VERSION
                     order by MYSQL_VERSION
                    ```
            }
            columnMapping {
                label: LABEL
                value: VALUE
            }
        )

    )

    region oracle-versions (
        name: Oracle : Versions
        title: Oracle : Versions
        type: chart
        layout {
            sequence: 60
            slot: body
            startNewRow: false
            columnSpan: 4
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                i-h320
                t-Region--scrollBody
            ]
        }
        chart {
            type: donut
        }
        settings {
            pieSelectionEffect: highlightAndExplode
        }
        value {
            format: decimal
            decimalPlaces: 0
            formatScaling: none
        }
        legend {
            position: bottom
        }

        series oracle-versions (
            name: Oracle Versions
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    with ENG_VERSIONS As ( select nvl(substr(engine_version, 1, instr( engine_version, '.', 1, 2)-1), 'UNKNOWN') ENG_VERSION from dim_instance where platform = 'ORACLE')
                     select eng_version label, count(*) value from ENG_VERSIONS
                     group by ENG_VERSION
                     order by value desc
                    ```
            }
            columnMapping {
                label: LABEL
                value: VALUE
            }
        )

    )

    region os-type-distribution (
        name: OS Types
        title: OS Types
        type: chart
        layout {
            sequence: 40
            slot: body
            columnSpan: 4
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                i-h320
                t-Region--scrollBody
            ]
        }
        chart {
            type: donut
        }
        settings {
            pieSelectionEffect: highlightAndExplode
        }
        value {
            format: decimal
            decimalPlaces: 0
            formatScaling: none
        }
        legend {
            position: bottom
        }

        series os-type-series (
            name: OS Type
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    With OS_TYPES As ( select NVL(OS_TYPE, 'Unkonwn') OS_TYPE From dim_host )
                    Select Decode ( OS_TYPE, '6.1', 'WinServer 2008 R2', '6.3', 'WinServer 2012 R2', '10.0', 'WinServer 2016+', OS_TYPE ) label, 
                           count(*) VALUE
                    from OS_TYPES group by os_type
                     order by value desc
                    ```
            }
            columnMapping {
                label: LABEL
                value: VALUE
            }
        )

    )

    region postgres-versions (
        name: PostGres : Versions
        title: PostGres : Versions
        type: chart
        layout {
            sequence: 80
            slot: body
            startNewRow: false
            columnSpan: 4
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                i-h320
                t-Region--scrollBody
            ]
        }
        chart {
            type: donut
        }
        settings {
            pieSelectionEffect: highlightAndExplode
        }
        value {
            format: decimal
            decimalPlaces: 0
            formatScaling: none
        }
        legend {
            position: bottom
        }

        series mssql-versions (
            name: PostGres Versions
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    -- Groupe par MAJEURE. Depuis la version 10, PostgreSQL numerote
                    -- une majeure sur une SEULE composante : 16.4 est la majeure 16,
                    -- minor 4. C'est aussi le grain du calendrier de fin de support
                    -- dans product_support, donc une tranche de ce graphe correspond
                    -- exactement a une date de support et non a plusieurs.
                    --
                    -- Tri numerique, pas alphabetique : en texte, '9' passe apres '16'.
                    With PG_MAJOR As
                      ( select nvl( regexp_substr( engine_version, '^\d+' ), 'Unknown' ) MAJOR_VERSION
                          from dim_instance where platform = 'POSTGRES' )
                    select 'PostgreSQL ' || MAJOR_VERSION as label,
                           count(*) as value
                      from PG_MAJOR
                     group by MAJOR_VERSION
                     order by to_number( regexp_substr( MAJOR_VERSION, '\d+' ) ) nulls last
                    ```
            }
            columnMapping {
                label: LABEL
                value: VALUE
            }
        )

    )

)

