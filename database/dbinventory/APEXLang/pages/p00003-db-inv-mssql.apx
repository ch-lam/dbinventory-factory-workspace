page 3 (
    name: DB Inv. - MSSQL
    alias: DB-INV-MSSQL
    title: DB Inv. - MSSQL
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb-nav (
        name: DB Inv. - MSSQL
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 1
            slot: body
        }
        appearance {
            template: @/title-bar
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region mssql-hosts (
        name: MSSQL Instances
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select h.hostname,
                       i.instance_name,
                       h.environment,
                       i.engine_version mssql_product_version,
                       i.edition mssql_edition,
                       i.collation,
                       h.os_type,
                       xh.is_clustered,
                       xh.activenodename,
                       h.num_cpus,
                       h.memory_gb,
                       xi.service_account
                  from dim_instance i
                  join dim_host h on h.host_id = i.host_id
                  left join ext_mssql_host xh on xh.host_id = h.host_id
                  left join ext_mssql_instance xi on xi.instance_id = i.instance_id
                 where i.platform = 'MSSQL'
                 order by h.hostname, i.instance_name
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--horizontalBorders
            ]
        }
        pagination {
            type: rowRangesXToYOfZWithPagination
        }
        messages {
            whenNoDataFound: No data found.
        }

        column ACTIVENODENAME (
            reportColumnQueryId: 9
            derivedColumn: N
            heading {
                heading: Active Node
            }
            layout {
                sequence: 90
            }
            sorting {
                sortable: false
            }
        )

        column COLLATION (
            reportColumnQueryId: 6
            derivedColumn: N
            heading {
                heading: Collation
            }
            layout {
                sequence: 60
            }
            sorting {
                sortable: false
            }
        )

        column ENVIRONMENT (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Environment
                alignment: center
            }
            layout {
                sequence: 30
                columnAlignment: center
            }
            sorting {
                sortable: false
            }
        )

        column HOSTNAME (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Hostname
            }
            layout {
                sequence: 10
            }
            sorting {
                sortable: false
            }
            comments {
                comments: Display Label: Hostname. Display in Report: true. Display in Form: false. Format Mask: none. Value Required: false. Read Only: true. Primary Display Column: true. Authorization Scheme: none.
            }
        )

        column INSTANCE_NAME (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Instance
            }
            layout {
                sequence: 20
            }
            sorting {
                sortable: false
            }
        )

        column IS_CLUSTERED (
            reportColumnQueryId: 8
            derivedColumn: N
            heading {
                heading: Clustered
                alignment: center
            }
            layout {
                sequence: 80
                columnAlignment: center
            }
            sorting {
                sortable: false
            }
        )

        column MEMORY_GB (
            reportColumnQueryId: 11
            derivedColumn: N
            heading {
                heading: Memory (GB)
                alignment: end
            }
            layout {
                sequence: 110
                columnAlignment: end
            }
            sorting {
                sortable: false
            }
        )

        column MSSQL_EDITION (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Edition
            }
            layout {
                sequence: 50
            }
            sorting {
                sortable: false
            }
        )

        column MSSQL_PRODUCT_VERSION (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Version
            }
            layout {
                sequence: 40
            }
            sorting {
                sortable: false
            }
        )

        column NUM_CPUS (
            reportColumnQueryId: 10
            derivedColumn: N
            heading {
                heading: CPUs
                alignment: end
            }
            layout {
                sequence: 100
                columnAlignment: end
            }
            sorting {
                sortable: false
            }
        )

        column OS_TYPE (
            reportColumnQueryId: 7
            derivedColumn: N
            heading {
                heading: OS Type
            }
            layout {
                sequence: 70
            }
            sorting {
                sortable: false
            }
        )

        column SERVICE_ACCOUNT (
            reportColumnQueryId: 12
            derivedColumn: N
            heading {
                heading: Service Account
            }
            layout {
                sequence: 120
            }
            sorting {
                sortable: false
            }
        )

    )

)

