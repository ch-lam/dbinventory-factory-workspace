page 4 (
    name: DB Inv. - Postgres
    alias: DB-INV-POSTGRES
    title: DB Inv. - Postgres
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region page-title (
        name: DB Inv. - Postgres
        type: staticContent
        layout {
            sequence: 1
            slot: body
        }
        appearance {
            template: @/title-bar
            templateOptions: #DEFAULT#
        }
    )

    region postgres-hosts (
        name: PostgreSQL Hosts
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select hostname,
                       environment,
                       license_type,
                       pg_version,
                       db_role,
                       port,
                       wal_level,
                       archive_mode,
                       max_connections,
                       shared_buffers_mb,
                       data_directory
                  from postgres_hosts
                 order by hostname
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--horizontalBorders
            ]
        }
        pagination {
            type: rowRangesXToYOfZWithPagination
        }
        messages {
            whenNoDataFound: No data found.
        }

        column ARCHIVE_MODE (
            reportColumnQueryId: 8
            derivedColumn: N
            heading {
                heading: Archive Mode
                alignment: center
            }
            layout {
                sequence: 80
                columnAlignment: center
            }
        )

        column DATA_DIRECTORY (
            reportColumnQueryId: 11
            derivedColumn: N
            heading {
                heading: Data Directory
            }
            layout {
                sequence: 110
            }
        )

        column DB_ROLE (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Role
                alignment: center
            }
            layout {
                sequence: 50
                columnAlignment: center
            }
        )

        column ENVIRONMENT (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Environment
                alignment: center
            }
            layout {
                sequence: 20
                columnAlignment: center
            }
        )

        column HOSTNAME (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Hostname
            }
            layout {
                sequence: 10
            }
            comments {
                comments: Display Label: Hostname. Display in Report: true. Display in Form: false. Format Mask: none. Value Required: false. Read Only: true. Primary Display Column: true. Authorization Scheme: none.
            }
        )

        column LICENSE_TYPE (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: License
            }
            layout {
                sequence: 30
            }
        )

        column MAX_CONNECTIONS (
            reportColumnQueryId: 9
            derivedColumn: N
            heading {
                heading: Max Conn.
                alignment: end
            }
            layout {
                sequence: 90
                columnAlignment: end
            }
        )

        column PG_VERSION (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Version
            }
            layout {
                sequence: 40
            }
        )

        column PORT (
            reportColumnQueryId: 6
            derivedColumn: N
            heading {
                heading: Port
                alignment: end
            }
            layout {
                sequence: 60
                columnAlignment: end
            }
        )

        column SHARED_BUFFERS_MB (
            reportColumnQueryId: 10
            derivedColumn: N
            heading {
                heading: Shared Buffers (MB)
                alignment: end
            }
            layout {
                sequence: 100
                columnAlignment: end
            }
        )

        column WAL_LEVEL (
            reportColumnQueryId: 7
            derivedColumn: N
            heading {
                heading: WAL Level
            }
            layout {
                sequence: 70
            }
        )

    )

)

