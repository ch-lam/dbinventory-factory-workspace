page 7 (
    name: DB Inv. - Oracle Server
    alias: DB-INV-ORACLE-SERVER
    title: DB Inv. - Oracle Server
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region oracle-server-identity (
        name: Server Identity Card
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select 10 as seq, 'Hostname' as attribute, h.hostname as attr_value from oracle_hosts h where h.hostname = :P7_HOSTNAME
                union all
                select 20 as seq, 'Environment' as attribute, h.environment as attr_value from oracle_hosts h where h.hostname = :P7_HOSTNAME
                union all
                select 30 as seq, 'License Type' as attribute, h.license_type as attr_value from oracle_hosts h where h.hostname = :P7_HOSTNAME
                union all
                select 40 as seq, 'OS Type' as attribute, h.os_type as attr_value from oracle_hosts h where h.hostname = :P7_HOSTNAME
                union all
                select 50 as seq, 'CPUs' as attribute, to_char(h.num_cpus) as attr_value from oracle_hosts h where h.hostname = :P7_HOSTNAME
                union all
                select 60 as seq, 'Memory (GB)' as attribute, to_char(h.memory_gb) as attr_value from oracle_hosts h where h.hostname = :P7_HOSTNAME
                 order by 1
                ```
            pageItemsToSubmit: P7_HOSTNAME
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--horizontalBorders
            ]
        }
        pagination {
            type: rowRangesXToYNoPagination
        }
        messages {
            whenNoDataFound: Select a server above to view its identity card.
        }

        column ATTRIBUTE (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Attribute
            }
            layout {
                sequence: 10
            }
            comments {
                comments: Display Label: Attribute. Display in Report: true. Display in Form: false. Format Mask: none. Value Required: false. Read Only: true. Primary Display Column: true. Authorization Scheme: none.
            }
        )

        column ATTR_VALUE (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Value
            }
            layout {
                sequence: 20
            }
        )

        column SEQ (
            reportColumnQueryId: 1
            derivedColumn: N
            type: hidden
            layout {
                sequence: 5
            }
        )

    )

    region page-title (
        name: DB Inv. - Oracle Server
        type: staticContent
        layout {
            sequence: 1
            slot: body
        }
        appearance {
            template: @/title-bar
            templateOptions: #DEFAULT#
        }
    )

    region server-filter (
        name: Server Selection
        type: staticContent
        layout {
            sequence: 5
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
    )

    pageItem P7_HOSTNAME (
        type: selectList
        label {
            label: Server
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select hostname d,
                       hostname r
                  from dim_host
                 where platform = 'ORACLE'
                 order by hostname
                ```
            displayNullValue: false
        }
        layout {
            sequence: 10
            region: @server-filter
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        advanced {
            warnOnUnsavedChanges: ignore
        }
        help {
            helpText: Select the Oracle host whose identity card is displayed below.
        }
    )

    dynamicAction refresh-server-identity (
        name: Refresh Server Identity
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P7_HOSTNAME
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @oracle-server-identity
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

