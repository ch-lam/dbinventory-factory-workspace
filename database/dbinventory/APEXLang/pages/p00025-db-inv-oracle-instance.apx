    )

    region oracle-instance-scoring (
        name: Scores
        title: Scores
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select sc.score_domain,
                       sc.score_value,
                       sc.max_score,
                       round( 100 * sc.score_value / nullif(sc.max_score, 0), 1 ) pct,
                       sc.status,
                       to_char(sc.snapshot_date, 'DD/MM/YYYY') snapshot_date,
                       sc.data_age_days
                  from fact_scoring sc
                 where sc.entity_type = 'INSTANCE'
                   and sc.entity_id = :P25_INSTANCE_ID
                   and sc.snapshot_date = ( select max(s2.snapshot_date) from fact_scoring s2 )
                 order by sc.score_domain
                ```
            pageItemsToSubmit: P25_INSTANCE_ID
        }
        layout {
            sequence: 50
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--horizontalBorders
            ]
        }
        pagination {
            type: rowRangesXToYNoPagination
        }
        messages {
            whenNoDataFound: No score computed for this instance.
        }

        column SCORE_DOMAIN (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Domain
            }
            layout {
                sequence: 10
            }
        )

        column SCORE_VALUE (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Score
                alignment: end
            }
            layout {
                sequence: 20
                columnAlignment: end
            }
        )

        column MAX_SCORE (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Max
                alignment: end
            }
            layout {
                sequence: 30
                columnAlignment: end
            }
        )

        column PCT (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: %
                alignment: end
            }
            layout {
                sequence: 40
                columnAlignment: end
            }
        )

        column STATUS (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Status
                alignment: center
            }
            layout {
                sequence: 50
                columnAlignment: center
            }
        )

        column SNAPSHOT_DATE (
            reportColumnQueryId: 6
            derivedColumn: N
            heading {
                heading: Snapshot
                alignment: center
            }
            layout {
                sequence: 60
                columnAlignment: center
            }
        )

        column DATA_AGE_DAYS (
            reportColumnQueryId: 7
            derivedColumn: N
            heading {
                heading: Data age (days)
                alignment: end
