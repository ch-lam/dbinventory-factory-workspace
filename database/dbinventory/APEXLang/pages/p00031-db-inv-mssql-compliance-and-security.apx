    region postgres-versions (
        name: MSSQL : Support Status
        title: MSSQL : Support Status
        type: chart
        layout {
            sequence: 80
            slot: body
            startNewRow: false
            columnSpan: 4
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                i-h320
                t-Region--scrollBody
            ]
        }
        chart {
            type: donut
        }
        settings {
            pieSelectionEffect: highlightAndExplode
        }
        value {
            format: decimal
            decimalPlaces: 0
            formatScaling: none
        }
        legend {
            position: bottom
        }

        series mssql-versions (
            name: MSSQL Support Status
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    With SUP As ( select instance_name, case when fc.control_code is null then null
                                              when fc.is_compliant = 0 then 'Out of support'
                                              when fc.has_exception = 1 then 'Extended (ESU)'
                                              else 'Supported'
                                              end support_status
                                         from dim_instance i
                                         left join fact_compliance fc
                                           on fc.entity_type = 'INSTANCE'
                                          and fc.entity_id = i.instance_id
                                          and fc.control_code = 'MSSQL_OUT_OF_SUPPORT'
                                          and fc.snapshot_date = ( select max(f2.snapshot_date) from fact_compliance f2 )
                                        where i.platform = 'MSSQL' )
                    Select Count(distinct instance_name) Value, support_status label from SUP group by support_status;
                    ```
            }
            columnMapping {
                label: LABEL
                value: VALUE
            }
        )

    )

    region granted-exceptions (
        name: Granted Exceptions
        title: Granted Exceptions
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select e.exception_id,
                       case when e.active = 0 then 'Disabled'
                            when e.end_date is not null and e.end_date < trunc(sysdate) then 'Expired'
                            when e.start_date > trunc(sysdate) then 'Not started'
                            when nvl( ( select count(*) from fact_control_finding f where f.exception_id = e.exception_id and f.snapshot_date = ( select max(f2.snapshot_date) from fact_control_finding f2 ) ), 0 ) = 0 then 'Active, covers nothing'
                            else 'Active'
                       end status,
                       r.title rule_title,
                       e.entity_type scope,
                       nvl( nvl( i.instance_name, d.db_name ), h.hostname ) scope_name,
                       e.item_key,
                       e.observed_value,
                       ( select count(*) from fact_control_finding f where f.exception_id = e.exception_id and f.snapshot_date = ( select max(f2.snapshot_date) from fact_control_finding f2 ) ) covered_today,
                       e.start_date,
                       e.end_date,
                       e.review_due_date,
                       e.approved_by,
                       e.document_ref,
                       e.justification
                  from ref_exception e
                  join ref_control_rule r on r.rule_code = e.rule_code
                  join ref_control rc on rc.control_code = r.control_code and rc.platform = 'MSSQL'
                  left join dim_host h on e.entity_type = 'HOST' and h.host_id = e.entity_id
                  left join dim_instance i on e.entity_type = 'INSTANCE' and i.instance_id = e.entity_id
                  left join dim_database d on e.entity_type = 'DATABASE' and d.database_id = e.entity_id
                 order by e.exception_id
                ```
        }
        layout {
            sequence: 120
            slot: body
            startNewRow: true
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        reportLayout {
            numberOfRows: 30
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
        }
        pagination {
            type: rowRangesXToYOfZWithPagination
            displayPosition: topAndBottomRight
        }
        messages {
            whenNoDataFound: No documented derogation has been granted on MSSQL yet
        }
        printing {
            enabled: true
        }
        output {
            linkText: Print
            format: pdf
        }
        pageHeader {
            pageHeaderText: Granted Exceptions
        }

