page 31 (
    name: DB Inv. - MSSQL Compliance and Security
    alias: DB-INV-MSSQL-COMPLIANCE-AND-SECURITY
    title: DB Inv. - MSSQL Compliance and Security
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region employees_1 (
        name: Non Compliance Issues
        title: Non Compliance Issues
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select i.instance_name,
                       rc.category,
                       r.title,
                       nvl( r.severity, rc.severity ) severity,
                       f.entity_type scope,
                       f.observed_value,
                       d.db_name,
                       f.item_key,
                       f.expected_value,
                       case when f.exception_id is not null then 'Granted derogation'
                            when f.is_norm_exception = 1 then 'Accepted by the norm'
                            else 'Open'
                       end exception_status,
                       e.justification
                  from fact_control_finding f
                  join ref_control_rule r
                    on r.rule_code = f.rule_code
                   and r.active = 1
                  join ref_control rc
                    on rc.control_code = r.control_code
                   and rc.score_domain = 'SECURITY'
                   and rc.active = 1
                  join v_entity_ancestry a on a.entity_type = f.entity_type and a.entity_id = f.entity_id
                  join dim_instance i on i.instance_id = a.instance_id
                  left join dim_database d on d.database_id = a.database_id
                  left join ref_exception e on e.exception_id = f.exception_id
                 where i.platform = 'MSSQL'
                   and f.is_compliant = 0
                   and f.snapshot_date = ( select max(f2.snapshot_date) from fact_control_finding f2 )
                ```
        }
        layout {
            sequence: 110
            slot: body
            startNewRow: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        reportLayout {
            numberOfRows: 60
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
        }
        pagination {
            type: rowRangesXToYOfZWithPagination
            displayPosition: topAndBottomRight
        }
        messages {
            whenNoDataFound: No Compliance Issues matches your criterias
            whenMoreDataFound: Too much issues matches your criteria, please add some filtering to see less than 2000 rows.
        }
        printing {
            enabled: true
        }
        output {
            linkText: Print
            format: pdf
        }
        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Non Compliance Issues
        }

        column CATEGORY (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Category
            }
            layout {
                sequence: 20
            }
        )

        column INSTANCE_NAME (
            reportColumnQueryId: 1
            derivedColumn: N
            type: link
            heading {
                heading: Instance Name
            }
            layout {
                sequence: 60
            }
            link {
                target: {
                    page: 35
                    items: {
                        P35_HOSTNAME: #INSTANCE_NAME#
                    }
                }
                linkText: #INSTANCE_NAME#
            }
        )

        column OBSERVED_VALUE (
            reportColumnQueryId: 6
            derivedColumn: N
            heading {
                heading: Observed Value
            }
            layout {
                sequence: 70
            }
        )

        column DB_NAME (
            reportColumnQueryId: 7
            derivedColumn: N
            heading {
                heading: Database
            }
            layout {
                sequence: 65
            }
        )

        column ITEM_KEY (
            reportColumnQueryId: 8
            derivedColumn: N
            heading {
                heading: Item
            }
            layout {
                sequence: 68
            }
        )

        column EXPECTED_VALUE (
            reportColumnQueryId: 9
            derivedColumn: N
            heading {
                heading: Expected Value
            }
            layout {
                sequence: 75
            }
        )

        column EXCEPTION_STATUS (
