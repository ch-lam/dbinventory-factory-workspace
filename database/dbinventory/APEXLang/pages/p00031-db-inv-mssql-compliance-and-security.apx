    region mssql-versions_1 (
        name: MSSQL : Versions
        title: MSSQL : Versions
        type: chart
        layout {
            sequence: 70
            slot: body
            columnSpan: 4
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                i-h320
                t-Region--scrollBody
            ]
        }
        chart {
            type: donut
        }
        settings {
            pieSelectionEffect: highlightAndExplode
        }
        value {
            format: decimal
            decimalPlaces: 0
            formatScaling: none
        }
        legend {
            position: bottom
        }

        series mssql-versions (
            name: MSSQL Versions
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    With SQL_VERSIONS As
                      ( select decode( substr( engine_version, 1, instr( engine_version, '.')-1), 10, 'SQL 2008/2008 R2', 11, 'SQL 2012', 12, 'SQL 2014', 13, 'SQL 2016', 14, 'SQL 2017', 15, 'SQL 2019', 16, 'SQL 2022', 17, 'SQL 2025', 'Unknown Yet') SQL_VERSION
                         from dim_instance where platform = 'MSSQL' )
                    select SQL_VERSION as label,
                           count(*) as value
                      from SQL_VERSIONS
                     group by SQL_VERSION order by value desc
                    ```
            }
            columnMapping {
                label: LABEL
                value: VALUE
            }
        )

    )

    region mssql-open-noncompliance (
        name: MSSQL : Open Non Compliance
        title: MSSQL : Open Non Compliance
        type: chart
        layout {
            sequence: 90
            slot: body
            startNewRow: false
            columnSpan: 4
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                i-h320
                t-Region--scrollBody
            ]
        }
        chart {
            type: donut
        }
        settings {
            pieSelectionEffect: highlightAndExplode
        }
        value {
            format: decimal
            decimalPlaces: 0
            formatScaling: none
        }
        legend {
            position: bottom
        }

        series mssql-open-noncompliance (
            name: MSSQL Open Non Compliance by Severity
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    With COMP_ISSUES As
                    ( select nvl( r.severity, rc.severity ) severity
                        from fact_control_finding f
                        join ref_control_rule r
                          on r.rule_code = f.rule_code
                         and r.active = 1
                        join ref_control rc
                          on rc.control_code = r.control_code
                         and rc.score_domain = 'SECURITY'
                         and rc.active = 1
                        join v_entity_ancestry a on a.entity_type = f.entity_type and a.entity_id = f.entity_id
                        join dim_instance i on i.instance_id = a.instance_id
                       where i.platform = 'MSSQL'
                         and f.is_compliant = 0
                         and f.exception_id is null
                         and f.is_norm_exception = 0
                         and f.snapshot_date = ( select max(f2.snapshot_date) from fact_control_finding f2 ) )
                    Select COUNT(*) value, InitCAP(SEVERITY) label From COMP_ISSUES Group By InitCAP(SEVERITY)
                    ```
            }
            columnMapping {
                label: LABEL
                value: VALUE
            }
        )

    )

