            layout {
                sequence: 60
                columnAlignment: center
            }
        )

        column SUPPORT_STATUS (
            reportColumnQueryId: 7
            derivedColumn: N
            heading {
                heading: Status
                alignment: center
            }
            layout {
                sequence: 70
                columnAlignment: center
            }
        )

    )

    region mssql-instance-databases (
        name: Databases
        title: Databases
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select d.db_name,
                       d.environment,
                       d.db_state,
                       xd.recovery_model,
                       xd.compatibility_level,
                       xd.agname,
                       ( select round(sum(fsc.size_mb))
                           from fact_storage_capacity fsc
                           join dim_storage_unit su on su.storage_unit_id = fsc.storage_unit_id
                          where su.database_id = d.database_id
                            and fsc.snapshot_date = ( select max(s.snapshot_date) from fact_storage_capacity s ) ) size_mb,
                       fb.hours_since_backup,
                       d.database_id
                  from dim_database d
                  left join ext_mssql_database xd on xd.database_id = d.database_id
                  left join fact_backup fb
                    on fb.database_id = d.database_id
                   and fb.snapshot_date = ( select max(b.snapshot_date) from fact_backup b )
                 where d.instance_id = :P35_INSTANCE_ID
                   and d.platform = 'MSSQL'
                 order by d.db_name
                ```
            pageItemsToSubmit: P35_INSTANCE_ID
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--horizontalBorders
            ]
        }
        pagination {
            type: rowRangesXToYOfZWithPagination
        }
        messages {
            whenNoDataFound: No database collected on this instance.
        }

        column DB_NAME (
            reportColumnQueryId: 1
            derivedColumn: N
            type: link
            heading {
                heading: Database
            }
            layout {
                sequence: 10
            }
            link {
                target: {
                    page: 36
                    items: {
                        P36_DATABASE_ID: #DATABASE_ID#
                    }
                }
                linkText: #DB_NAME#
            }
            sorting {
                sortable: false
            }
