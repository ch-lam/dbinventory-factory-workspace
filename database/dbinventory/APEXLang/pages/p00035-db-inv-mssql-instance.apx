            layout {
                sequence: 70
                columnAlignment: end
            }
            comments {
                comments: The age of the collect the score rests on. A score says nothing without it.
            }
        )

    )

    region mssql-instance-parameters (
        name: Parameters (sp_configure / registry)
        title: Parameters (sp_configure / registry)
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select p.source,
                       p.parameter_name,
                       fcp.config_value,
                       fcp.run_value,
                       fcp.value_text
                  from fact_config_parameter fcp
                  join dim_parameter p on p.parameter_id = fcp.parameter_id
                 where fcp.instance_id = :P35_INSTANCE_ID
                   and fcp.snapshot_date = ( select max(f2.snapshot_date) from fact_config_parameter f2 )
                 order by p.source, p.parameter_name
                ```
            pageItemsToSubmit: P35_INSTANCE_ID
        }
        layout {
            sequence: 60
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--horizontalBorders
            ]
        }
        pagination {
            type: rowRangesXToYOfZWithPagination
        }
        messages {
            whenNoDataFound: No parameter collected for this instance.
        }

        column SOURCE (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Source
                alignment: center
            }
            layout {
                sequence: 10
                columnAlignment: center
            }
        )

        column PARAMETER_NAME (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Parameter
            }
            layout {
                sequence: 20
            }
        )

        column CONFIG_VALUE (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Config Value
                alignment: end
            }
            layout {
                sequence: 30
                columnAlignment: end
            }
        )

        column RUN_VALUE (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Run Value
                alignment: end
            }
            layout {
                sequence: 40
                columnAlignment: end
            }
        )

        column VALUE_TEXT (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Value
            }
            layout {
                sequence: 50
            }
        )

    )

    region mssql-instance-findings (
        name: Compliance Findings
        title: Compliance Findings
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select rc.category,
                       r.title,
                       nvl( r.severity, rc.severity ) severity,
                       f.item_key,
                       f.observed_value,
                       f.expected_value,
                       case when f.exception_id is not null then 'Granted derogation'
                            when f.is_norm_exception = 1 then 'Accepted by the norm'
                            else 'Open'
                       end exception_status,
                       f.entity_type scope
                  from fact_control_finding f
                  join ref_control_rule r on r.rule_code = f.rule_code and r.active = 1
                  join ref_control rc on rc.control_code = r.control_code and rc.active = 1
                  join v_entity_ancestry a on a.entity_type = f.entity_type and a.entity_id = f.entity_id
                 where a.instance_id = :P35_INSTANCE_ID
                   and f.is_compliant = 0
                   and f.snapshot_date = ( select max(f2.snapshot_date) from fact_control_finding f2 )
                 order by rc.category, r.title, f.item_key
                ```
            pageItemsToSubmit: P35_INSTANCE_ID
        }
        layout {
            sequence: 70
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--horizontalBorders
            ]
        }
        pagination {
            type: rowRangesXToYOfZWithPagination
        }
        messages {
            whenNoDataFound: No open finding at instance level.
        }

        column CATEGORY (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Category
            }
            layout {
                sequence: 10
            }
        )

        column TITLE (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Rule
            }
            layout {
                sequence: 20
            }
        )

        column SEVERITY (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Severity
                alignment: center
            }
            layout {
                sequence: 30
                columnAlignment: center
            }
        )

        column SCOPE (
            reportColumnQueryId: 8
            derivedColumn: N
            heading {
                heading: Grain
                alignment: center
            }
            layout {
                sequence: 35
                columnAlignment: center
            }
            comments {
                comments: INSTANCE for a rule evaluated on the instance itself, DATABASE or STORAGE for one evaluated below it - all three belong to this instance through v_entity_ancestry, and all three are counted by the NIS2 band above.
            }
        )

        column ITEM_KEY (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Item
            }
            layout {
                sequence: 40
            }
        )

        column OBSERVED_VALUE (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Observed
            }
            layout {
                sequence: 50
            }
        )

        column EXPECTED_VALUE (
            reportColumnQueryId: 6
            derivedColumn: N
            heading {
                heading: Expected
            }
            layout {
                sequence: 60
            }
        )

        column EXCEPTION_STATUS (
            reportColumnQueryId: 7
            derivedColumn: N
            heading {
                heading: Status
                alignment: center
            }
            layout {
                sequence: 70
                columnAlignment: center
            }
        )

    )

    dynamicAction reload-on-selection (
        name: Reload on selection
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P35_INSTANCE_ID
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: apex.page.submit()
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    branch reload-same-page (
        name: Reload same page
        comments {
            comments: Hands control back to the same page after the selector submits it. Type page is "Show only": it re-renders inside the same request, with no redirect, so no URL and no checksum - which matters because this page requires arguments to have a checksum and a URL built in the browser cannot carry one. This branch REQUIRES the page attribute reloadOnSubmit = always: with its default onlyForSuccess, APEX refuses a Show Only branch at RUNTIME with APEX.BRANCH.SHOW_ONLY_NOT_SUPPORTED, which apex validate cannot catch.
        }
        execution {
            sequence: 10
            point: afterProcessing
        }
        behavior {
            type: page
            pageNumber: 35
        }
    )

)
