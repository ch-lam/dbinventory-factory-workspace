    region mssql-instance-identity (
        name: Instance
        title: Instance
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select i.instance_name,
                       i.edition,
                       i.collation,
                       i.port,
                       case
                          when regexp_like(i.install_date, '^[0-9]{8}$')
                             then to_char(to_date(i.install_date, 'YYYYMMDD'), 'DD/MM/YYYY')
                          else i.install_date
                       end install_date,
                       xi.max_dop,
                       xi.parallel_threshold,
                       xi.min_memory,
                       xi.max_memory,
                       case xi.xp_cmdshell_enabled when 1 then 'Enabled' when 0 then 'Disabled' end xp_cmdshell,
                       xi.service_account
                  from dim_instance i
                  left join ext_mssql_instance xi on xi.instance_id = i.instance_id
                 where i.instance_id = :P35_INSTANCE_ID
                ```
            pageItemsToSubmit: P35_INSTANCE_ID
        }
        layout {
            sequence: 20
            slot: body
        }
