            }
        )

        column AGNAME (
            reportColumnQueryId: 6
            derivedColumn: N
            heading {
                heading: Availability Group
            }
            layout {
                sequence: 60
            }
        )

        column SIZE_MB (
            reportColumnQueryId: 7
            derivedColumn: N
            heading {
                heading: Size (MB)
                alignment: end
            }
            layout {
                sequence: 70
                columnAlignment: end
            }
        )

        column HOURS_SINCE_BACKUP (
            reportColumnQueryId: 8
            derivedColumn: N
            heading {
                heading: Hours Since Backup
                alignment: end
