page 35 (
    name: DB Inv. - MSSQL Instance
    alias: DB-INV-MSSQL-INSTANCE
    title: DB Inv. - MSSQL Instance
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        fileUrls: #APP_FILES#css/nis2.css
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    advanced {
        reloadOnSubmit: always
    }

    region page-title (
        name: &P35_INSTANCE_LABEL.
        type: staticContent
        layout {
            sequence: 1
            slot: body
        }
        appearance {
            template: @/title-bar
            templateOptions: #DEFAULT#
        }
    )

    region instance-filter (
        name: Instance Selection
        type: staticContent
        layout {
            sequence: 5
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
    )

    pageItem P35_INSTANCE_ID (
        type: selectOne
        label {
            label: Instance
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select h.hostname || ' / ' || i.instance_name d,
                       i.instance_id r
                  from dim_instance i
                  join dim_host h on h.host_id = i.host_id
                 where i.platform = 'MSSQL'
                 order by h.hostname, i.instance_name
                ```
        }
        layout {
            sequence: 10
            region: @instance-filter
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        advanced {
            warnOnUnsavedChanges: ignore
        }
        help {
            helpText: Select the SQL Server instance whose card is displayed below.
        }
    )

    pageItem P35_INSTANCE_LABEL (
        type: hidden
        layout {
            sequence: 20
            region: @instance-filter
            slot: regionBody
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select h.hostname || ' / ' || i.instance_name
                  from dim_instance i
                  join dim_host h on h.host_id = i.host_id
                 where i.instance_id = :P35_INSTANCE_ID
                ```
            used: always
        }
    )

    region mssql-instance-nis2 (
        name: NIS2 Posture
        title: NIS2 Posture
        type: classicReport
        comments {
            comments: Read-only synthesis band. It rolls the whole chain up - the instance, its databases, their storage units - which is exactly the perimeter of the Compliance Findings report at the bottom of this page. Narrow one without the other and the band counts what the list does not show. The bar's CSS lives once, on the global page p00000.
        }
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                -- La barre est assemblee ici plutot que par 24 colonnes cachees et un
                -- htmlExpression facon p10011-top-users : ces six pages se maintiennent
                -- a la main depuis que leur generateur a disparu, et l'autre forme leur
                -- couterait 300 lignes chacune pour le meme rendu.
                --
                -- apex_escape.html sur chaque donnee : le balisage est a nous, les
                -- donnees ne le sont pas. title et description de ref_nis2_domain sont
                -- saisissables, et un & y suffirait a casser la barre.
                select '<div class="nis2-bar">' ||
                       listagg( '<span class="nis2-seg ' || cls
                                || '" title="' || apex_escape.html( tip ) || '">'
                                || '<span class="nis2-value">' || apex_escape.html( badge ) || '</span>'
                                || '<span class="nis2-label">' || apex_escape.html( lbl ) || '</span>'
                                || '</span>', '' )
                          within group ( order by display_order )
                       || '</div>' bar
                  from ( select p.display_order,
                                p.nis2_domain_code lbl,
                                case p.status
                                   when 'NOT_ASSESSED' then '--'
                                   when 'DEROGATED'    then to_char( p.derogated )
                                   else to_char( p.open_gaps )
                                end badge,
                                -- le neutre est le defaut : une classe oubliee laisse un
                                -- troncon gris, elle ne peut pas faire passer un trou
                                -- pour un vert
                                case p.status
                                   when 'CRITICAL'  then 'is-critical'
                                   when 'WARNING'   then 'is-warning'
                                   when 'DEROGATED' then 'is-waived'
                                   when 'OK'        then 'is-ok'
                                   else 'is-none'
                                end cls,
                                p.title || ' - ' || p.summary tip
                           from v_nis2_posture p
                          where p.entity_type = 'INSTANCE'
                            and p.entity_id = :P35_INSTANCE_ID )
                ```
            pageItemsToSubmit: P35_INSTANCE_ID
        }
        layout {
            sequence: 7
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--noPadding
            ]
            cssClasses: nis2-region
        }
        reportLayout {
            numberOfRows: 1
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--hideNoPagination
            ]
        }
        messages {
            whenNoDataFound: No NIS2 posture for this selection.
        }

        column BAR (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Article 21(2)
            }
            layout {
                sequence: 10
            }
            security {
                escapeSpecialChars: false
            }
        )

    )

    region mssql-instance-host (
        name: Server
        title: Server
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select h.hostname,
                       h.environment,
                       h.license_type,
                       h.os_type,
                       h.num_cpus,
                       h.memory_gb,
                       case xh.is_clustered when 1 then 'Yes' when 0 then 'No' end is_clustered,
                       xh.activenodename,
                       ( select count(*) from dim_instance i2 where i2.host_id = h.host_id ) instance_count
                  from dim_instance i
                  join dim_host h on h.host_id = i.host_id
                  left join ext_mssql_host xh on xh.host_id = h.host_id
                 where i.instance_id = :P35_INSTANCE_ID
                ```
            pageItemsToSubmit: P35_INSTANCE_ID
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--horizontalBorders
            ]
        }
        pagination {
            type: rowRangesXToYNoPagination
        }
        messages {
            whenNoDataFound: Select an instance above.
        }

        column HOSTNAME (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Hostname
            }
            layout {
                sequence: 10
            }
        )

