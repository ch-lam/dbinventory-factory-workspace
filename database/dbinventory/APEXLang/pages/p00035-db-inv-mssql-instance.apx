        column APPLICATION_ID (
            reportColumnQueryId: 5
            derivedColumn: N
            type: hidden
            layout {
                sequence: 5
            }
        )

    )

    region mssql-instance-version (
        name: Version & Support
        title: Version & Support
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select i.engine_version,
                       ps.display_name release_name,
                       ps.current_patch_name,
                       ps.current_patch_level,
                       to_char(ps.end_of_support_date, 'DD/MM/YYYY') premier_support_end,
                       to_char(ps.end_of_ext_support_date, 'DD/MM/YYYY') extended_support_end,
                       case when fc.control_code is null then 'Not assessed'
                            when fc.is_compliant = 0    then 'Out of support'
                            when fc.has_exception = 1   then 'Extended support'
                            else 'Supported'
                       end support_status
                  from dim_instance i
                  left join product_support ps
                    on ps.product_company = 'MICROSOFT'
                   and ps.product_type = 'MSSQL'
                   and ps.product_version = substr( i.engine_version, 1, instr(i.engine_version, '.', 1, 2) - 1 )
                  left join fact_compliance fc
                    on fc.entity_type = 'INSTANCE'
                   and fc.entity_id = i.instance_id
                   and fc.control_code = 'MSSQL_OUT_OF_SUPPORT'
                   and fc.snapshot_date = ( select max(f2.snapshot_date) from fact_compliance f2 )
                 where i.instance_id = :P35_INSTANCE_ID
                ```
            pageItemsToSubmit: P35_INSTANCE_ID
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--horizontalBorders
            ]
        }
        pagination {
            type: rowRangesXToYNoPagination
        }
        messages {
            whenNoDataFound: Select an instance above.
        }

        column ENGINE_VERSION (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Build
            }
            layout {
                sequence: 10
            }
        )

        column RELEASE_NAME (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Release
            }
            layout {
                sequence: 20
            }
        )

        column CURRENT_PATCH_NAME (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Latest CU
            }
            layout {
                sequence: 30
            }
        )

        column CURRENT_PATCH_LEVEL (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Latest Build
            }
            layout {
                sequence: 40
            }
        )

        column PREMIER_SUPPORT_END (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Mainstream Ends
                alignment: center
            }
            layout {
                sequence: 50
                columnAlignment: center
            }
        )

        column EXTENDED_SUPPORT_END (
            reportColumnQueryId: 6
            derivedColumn: N
            heading {
                heading: Extended Ends
                alignment: center
