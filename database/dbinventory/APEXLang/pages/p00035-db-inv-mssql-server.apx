    region instance-parameters (
        name: Parameters (sp_configure / registry)
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select i.instance_name,
                       p.source,
                       p.parameter_name,
                       fcp.config_value,
                       fcp.run_value,
                       fcp.value_text
                  from fact_config_parameter fcp
                  join dim_instance i on i.instance_id = fcp.instance_id
                  join dim_parameter p on p.parameter_id = fcp.parameter_id
                 where i.host_id = :P35_HOST_ID
                   and fcp.snapshot_date = ( select max(f2.snapshot_date) from fact_config_parameter f2 )
                 order by i.instance_name, p.source, p.parameter_name
                ```
