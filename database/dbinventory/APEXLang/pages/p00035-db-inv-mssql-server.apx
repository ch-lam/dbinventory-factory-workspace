    region host-summary (
        name: Server
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select h.hostname,
                       h.environment,
                       h.license_type,
                       h.os_type,
                       h.num_cpus,
                       h.memory_gb,
                       case xh.is_clustered when 1 then 'Yes' when 0 then 'No' end is_clustered,
                       xh.activenodename,
                       xh.clusternode1,
                       xh.clusternode2,
                       ( select count(*) from dim_instance i where i.host_id = h.host_id ) instance_count,
                       ( select count(*) from dim_database d join dim_instance i2 on i2.instance_id = d.instance_id where i2.host_id = h.host_id ) database_count
                  from dim_host h
                  left join ext_mssql_host xh on xh.host_id = h.host_id
                 where h.host_id = :P35_HOST_ID
                ```
            pageItemsToSubmit: P35_HOST_ID
        }
        layout {
            sequence: 10
            slot: body
        }
