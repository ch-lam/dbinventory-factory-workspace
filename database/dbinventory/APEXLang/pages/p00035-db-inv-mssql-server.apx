    region instance-security (
        name: Compliance Score
        title: Compliance Score
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select i.instance_name,
                       sc.score_value,
                       sc.max_score,
                       sc.status,
                       sc.snapshot_date
                  from dim_instance i
                  left join fact_scoring sc
                    on sc.entity_type = 'INSTANCE'
                   and sc.entity_id = i.instance_id
                   and sc.score_domain = 'SECURITY'
                   and sc.snapshot_date = ( select max(s2.snapshot_date) from fact_scoring s2 )
                 where i.host_id = :P35_HOST_ID
                   and i.platform = 'MSSQL'
                 order by i.instance_name
                ```
            pageItemsToSubmit: P35_HOST_ID
