    pageItem P35_HOSTNAME (
        type: hidden
        layout {
            sequence: 20
            region: @host-summary
            slot: regionBody
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select h.hostname
                  from dim_host h
                 where h.host_id = :P35_HOST_ID
                ```
            used: always
        }
    )

    pageItem P35_HOST_ID (
        type: hidden
