page 35 (
    name: DB Inv. - MSSQL Server
    alias: DB-INV-MSSQL-SERVER
    title: DB Inv. - MSSQL Server
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    help {
        helpText:
            ```html
            <p>Identity card of a single MSSQL server. The top banner describes the host
            (hardware, OS, cluster); every section below shows one row per SQL Server
            instance running on that host.</p>
            <p>Database attributes are summarised only - use the MSSQL databases page for
            per-database detail.</p>
            ```
    }

    region host-databases (
        name: Databases
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select i.instance_name,
                       d.db_name,
                       d.db_state,
                       xd.recovery_model,
                       xd.compatibility_level,
                       xd.collation,
                       xd.agname,
                       xd.agtype,
                       ( select sum(fsc.size_mb) from fact_storage_capacity fsc join dim_storage_unit su on su.storage_unit_id = fsc.storage_unit_id where su.database_id = d.database_id and fsc.snapshot_date = ( select max(s.snapshot_date) from fact_storage_capacity s ) ) size_mb,
                       fb.last_full_date,
                       fb.hours_since_backup
                  from dim_database d
                  join dim_instance i on i.instance_id = d.instance_id
                  left join ext_mssql_database xd on xd.database_id = d.database_id
                  left join fact_backup fb
                    on fb.database_id = d.database_id
                   and fb.snapshot_date = ( select max(b.snapshot_date) from fact_backup b )
                 where i.host_id = :P35_HOST_ID
                   and d.platform = 'MSSQL'
                 order by i.instance_name, d.db_name
                ```
            pageItemsToSubmit: P35_HOST_ID
        }
        layout {
            sequence: 70
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--horizontalBorders
            ]
        }
        pagination {
            type: rowRangesXToYOfZWithPagination
        }
        messages {
            whenNoDataFound: No database found on this server.
        }

        column COLLATION (
            reportColumnQueryId: 6
            derivedColumn: N
            heading {
                heading: Collation
            }
            layout {
                sequence: 60
            }
            sorting {
                sortable: false
            }
        )

