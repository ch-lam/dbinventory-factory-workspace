    region instance-version (
        name: Version & Support
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select i.instance_name,
                       i.edition,
                       i.engine_version,
                       i.collation,
                       i.port,
                       case
                          when regexp_like(i.install_date, '^[0-9]{8}$')
                             then to_char(to_date(i.install_date, 'YYYYMMDD'), 'DD/MM/YYYY')
                          else i.install_date
                       end install_date,
                       case when fc.control_code is null then null
                            when fc.is_compliant = 0 then 'Out of support'
                            when fc.has_exception = 1 then 'Extended (ESU)'
                            else 'Supported'
                       end support_status,
                       fc.observed_value support_detail
                  from dim_instance i
                  left join fact_compliance fc
                    on fc.entity_type = 'INSTANCE'
                   and fc.entity_id = i.instance_id
                   and fc.control_code = 'MSSQL_OUT_OF_SUPPORT'
                   and fc.snapshot_date = ( select max(f2.snapshot_date) from fact_compliance f2 )
                 where i.host_id = :P35_HOST_ID
                   and i.platform = 'MSSQL'
                 order by i.instance_name
                ```
            pageItemsToSubmit: P35_HOST_ID
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
