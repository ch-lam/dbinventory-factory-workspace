    region instance-config (
        name: Configuration
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select i.instance_name,
                       xi.max_dop,
                       xi.parallel_threshold,
                       xi.min_memory,
                       xi.max_memory,
                       case xi.xp_cmdshell_enabled when 1 then 'Enabled' when 0 then 'Disabled' end xp_cmdshell,
                       xi.service_account
                  from dim_instance i
                  left join ext_mssql_instance xi on xi.instance_id = i.instance_id
                 where i.host_id = :P35_HOST_ID
                   and i.platform = 'MSSQL'
                 order by i.instance_name
