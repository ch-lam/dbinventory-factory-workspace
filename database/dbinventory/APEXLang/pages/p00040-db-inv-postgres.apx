    region postgres-replication (
        name: Replication
        title: Replication
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                -- Read straight from the collect: streaming replication has no home in the
                -- dimensional model, and nothing scores it. That is deliberate - a
                -- replication lag is a supervision signal, watched by Zabbix
                -- (check_postgres.sh), not a compliance verdict this inventory should be
                -- issuing. It is shown here because the estate's topology belongs on the
                -- inventory page.
                --
                -- lag_seconds = -1 is the collect's marker for "not measurable", not a
                -- negative lag: on a standby the collect reports the age of the last
                -- message received, and there is none before the first one arrives.
                select r.hostname,
                       r.db_role,
                       r.peer_addr,
                       r.state,
                       r.sync_state,
                       case when r.lag_seconds < 0 then null else r.lag_seconds end lag_seconds
                  from postgres_replication r
                 order by r.hostname, r.peer_addr
                ```
        }
        layout {
            sequence: 50
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--horizontalBorders
            ]
        }
        pagination {
            type: rowRangesXToYOfZWithPagination
        }
        messages {
            whenNoDataFound: No streaming replication collected. A cluster with no standby produces no row here.
        }

        column HOSTNAME (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Hostname
            }
            layout {
                sequence: 10
            }
        )

        column DB_ROLE (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
