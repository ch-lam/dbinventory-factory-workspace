    region postgres-capacity (
        name: Capacity : Transaction ID Headroom
        title: Capacity : Transaction ID Headroom
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                -- What "running out" means on PostgreSQL.
                --
                -- There is no percentage of a disk here, and that is not an omission: a
                -- PostgreSQL database has no size ceiling of its own, and no filesystem
                -- size is reachable from SQL, so fact_storage_capacity carries used_mb
                -- with pct_used deliberately null. The hard ceiling the engine does have
                -- is transaction id wraparound - 2^31, past which the cluster refuses
                -- writes until a VACUUM FREEZE completes - and that is what is scored,
                -- through PG_XID_WRAPAROUND.
                --
                -- Size is shown beside it for growth, without a verdict attached.
                select i.instance_name hostname,
                       d.db_name,
                       sc.used_mb size_mb,
                       round( 100 * p.xid_age / 2147483648, 2 ) pct_xid_used,
                       t.warn_value,
                       t.crit_value,
                       case when round( 100 * p.xid_age / 2147483648, 2 ) >= t.crit_value then 'Critical'
                            when round( 100 * p.xid_age / 2147483648, 2 ) >= t.warn_value then 'Warning'
                            else 'OK'
                       end xid_status
                  from dim_database d
                  join dim_instance i on i.instance_id = d.instance_id
                  join postgres_databases p
                    on p.hostname = i.instance_name
                   and p.datname = d.db_name
                  left join dim_storage_unit su
                    on su.database_id = d.database_id
                   and su.storage_type = 'DATABASE'
                  left join fact_storage_capacity sc
                    on sc.storage_unit_id = su.storage_unit_id
                   and sc.snapshot_date = ( select max(sc2.snapshot_date) from fact_storage_capacity sc2 )
                  left join ref_threshold t
                    on t.control_code = 'POSTGRES_CAPACITY_SATURATION'
                   and t.metric = 'pct_xid_used'
                   and t.environment = '*'
                 where d.platform = 'POSTGRES'
                   and p.xid_age is not null
                 order by round( 100 * p.xid_age / 2147483648, 2 ) desc nulls last
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--horizontalBorders
            ]
        }
        pagination {
            type: rowRangesXToYOfZWithPagination
        }
        messages {
            whenNoDataFound: No transaction id age collected yet.
        }

        column HOSTNAME (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Hostname
            }
            layout {
                sequence: 10
            }
        )

        column DB_NAME (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Database
            }
            layout {
                sequence: 20
            }
        )

        column SIZE_MB (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Size (MB)
                alignment: end
