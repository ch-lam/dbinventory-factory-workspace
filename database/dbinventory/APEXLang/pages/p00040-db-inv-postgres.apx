page 40 (
    name: DB Inv. - Postgres
    alias: DB-INV-POSTGRES
    title: DB Inv. - Postgres
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region postgres-hosts (
        name: PostgreSQL Servers
        title: PostgreSQL Servers
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                -- Read from the model rather than from postgres_hosts, now that the
                -- PostgreSQL collect feeds dim_host/dim_instance. Same columns in the
                -- same order as before, so the column definitions below are unchanged.
                --
                -- instance_name IS the hostname on PostgreSQL: the collect never carries
                -- the port back into the data, so the model cannot separate two clusters
                -- running on one machine. See pkg_dbinv_inventory.load_dim_host.
                select i.instance_name hostname,
                       h.environment,
                       h.license_type,
                       i.engine_version pg_version,
                       e.db_role,
                       i.port,
                       e.wal_level,
                       e.archive_mode,
                       e.max_connections,
                       e.shared_buffers_mb,
                       e.data_directory
                  from dim_instance i
                  join dim_host h on h.host_id = i.host_id
                  left join ext_postgres_instance e on e.instance_id = i.instance_id
                 where i.platform = 'POSTGRES'
                 order by i.instance_name
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--horizontalBorders
            ]
        }
        pagination {
            type: rowRangesXToYOfZWithPagination
        }
        messages {
            whenNoDataFound: No data found.
        }

        column HOSTNAME (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Hostname
            }
            layout {
                sequence: 10
            }
        )

        column ENVIRONMENT (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Environment
                alignment: center
            }
            layout {
                sequence: 20
                columnAlignment: center
            }
        )

        column LICENSE_TYPE (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: License
            }
            layout {
