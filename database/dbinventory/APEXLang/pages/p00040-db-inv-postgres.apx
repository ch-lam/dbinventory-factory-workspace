    region postgres-databases (
        name: Databases
        title: Databases
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                -- Identity from the model, descriptive attributes from the collect.
                -- owner, encoding, collation and default tablespace have no home in the
                -- dimensional model: there is no ext_postgres_database, because nothing
                -- scores them and inventing a table to mirror four display columns would
                -- add a load step that could drift. They are read from the staging row
                -- the model was built from, joined on the same key.
                select i.instance_name hostname,
                       d.db_name,
                       d.environment,
                       p.owner,
                       p.encoding,
                       p.collation,
                       p.tablespace,
                       sc.used_mb size_mb
                  from dim_database d
                  join dim_instance i on i.instance_id = d.instance_id
                  left join postgres_databases p
                    on p.hostname = i.instance_name
                   and p.datname = d.db_name
                  left join dim_storage_unit su
                    on su.database_id = d.database_id
                   and su.storage_type = 'DATABASE'
                  left join fact_storage_capacity sc
                    on sc.storage_unit_id = su.storage_unit_id
                   and sc.snapshot_date = ( select max(sc2.snapshot_date) from fact_storage_capacity sc2 )
                 where d.platform = 'POSTGRES'
                 order by i.instance_name, d.db_name
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--horizontalBorders
            ]
        }
        pagination {
            type: rowRangesXToYOfZWithPagination
        }
        messages {
            whenNoDataFound: No database collected on PostgreSQL yet.
        }

        column HOSTNAME (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Hostname
            }
            layout {
                sequence: 10
            }
        )

        column DB_NAME (
            reportColumnQueryId: 2
