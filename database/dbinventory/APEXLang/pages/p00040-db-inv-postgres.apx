    region postgres-wal-archiving (
        name: WAL Archiving
        title: WAL Archiving
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                -- WAL archiving is NOT a backup, and this region must not be read as one:
                -- no pgBackRest or Barman catalogue is collected anywhere in the estate,
                -- so nothing here says a restore has ever been possible. What it does say
                -- is whether the necessary condition for point-in-time recovery holds -
                -- archiving switched on, and the last segment recent enough. Both are
                -- scored, as POSTGRES_WAL_ARCHIVING and POSTGRES_BACKUP_FRESHNESS.
                --
                -- hours_since_backup is measured from pg_stat_archiver.last_archived_time
                -- and lands in last_log_date, never in last_full_date: see
                -- pkg_dbinv_inventory.load_fact_instance_backup.
                select i.instance_name hostname,
                       e.archive_mode,
                       ib.last_log_date last_archived_time,
                       b.last_archived_wal,
                       ib.hours_since_backup hours_since_archived,
                       ib.failed_count,
                       b.last_failed_wal,
                       t.crit_value sla_hours
                  from dim_instance i
                  left join ext_postgres_instance e on e.instance_id = i.instance_id
                  left join fact_instance_backup ib
                    on ib.instance_id = i.instance_id
                   and ib.snapshot_date = ( select max(ib2.snapshot_date) from fact_instance_backup ib2 )
                  left join postgres_backup b on b.hostname = i.instance_name
                  left join ref_threshold t
                    on t.control_code = 'POSTGRES_BACKUP_FRESHNESS'
                   and t.metric = 'hours_since_archived'
                   and t.environment = '*'
                 where i.platform = 'POSTGRES'
                 order by ib.hours_since_backup desc nulls last
                ```
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--horizontalBorders
            ]
        }
        pagination {
            type: rowRangesXToYOfZWithPagination
        }
        messages {
            whenNoDataFound: No WAL archiver statistics collected yet.
        }

        column HOSTNAME (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Hostname
            }
            layout {
                sequence: 10
            }
        )

        column ARCHIVE_MODE (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Archive Mode
                alignment: center
            }
            layout {
                sequence: 20
                columnAlignment: center
