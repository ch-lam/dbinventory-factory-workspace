            derivedColumn: N
            heading {
                heading: Peer
            }
            layout {
                sequence: 30
            }
        )

        column STATE (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: State
                alignment: center
            }
            layout {
                sequence: 40
                columnAlignment: center
            }
        )

        column SYNC_STATE (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Sync
                alignment: center
            }
            layout {
                sequence: 50
                columnAlignment: center
            }
        )

        column LAG_SECONDS (
            reportColumnQueryId: 6
            derivedColumn: N
            heading {
                heading: Lag (s)
                alignment: end
            }
            layout {
                sequence: 60
                columnAlignment: end
            }
        )

    )

)
