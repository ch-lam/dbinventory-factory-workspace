page 41 (
    name: DB Inv. - Discovery Triage
    alias: DB-INV-DISCOVERY-TRIAGE
    title: Discovery Triage
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region triage (
        name: Discovered Entity
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
    )

    pageItem P41_LEVEL_NAME (
        type: hidden
        layout {
            sequence: 10
            region: @triage
            slot: regionBody
        }
    )

    pageItem P41_ENTITY_ID (
        type: hidden
        layout {
            sequence: 20
            region: @triage
            slot: regionBody
        }
    )

    pageItem P41_HOSTNAME (
        type: displayOnly
        label {
            label: Host
            alignment: right
        }
        layout {
            sequence: 30
            region: @triage
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
    )

    pageItem P41_INSTANCE_NAME (
        type: displayOnly
        label {
            label: Instance
            alignment: right
        }
        layout {
            sequence: 40
            region: @triage
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
    )

    pageItem P41_PORT (
        type: displayOnly
        label {
            label: TCP Port
            alignment: right
        }
        layout {
            sequence: 50
            region: @triage
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        help {
            helpText: Read from the instance registry key by the Windows discovery. Without it the instance cannot be collected, because a named instance does not listen on 1433.
        }
    )

    pageItem P41_ENVIRONMENT (
        type: selectList
        label {
            label: Environment
            alignment: right
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select distinct environment,
                       environment
                  from mssql_collect_list
                 order by 1
                ```
            displayNullValue: false
        }
        layout {
            sequence: 60
            region: @triage
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        help {
            helpText: Values in use in the collection perimeter. Required to promote.
        }
    )

    pageItem P41_LICENSE_TYPE (
        type: selectList
        label {
            label: License Type
            alignment: right
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select distinct license_type,
                       license_type
                  from mssql_collect_list
                 order by 1
                ```
            displayNullValue: false
        }
        layout {
            sequence: 70
            region: @triage
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        help {
            helpText: Values in use in the collection perimeter. Required to promote.
        }
    )

    pageItem P41_TRIAGE_NOTE (
        type: textarea
        label {
            label: Note
            alignment: right
        }
        layout {
            sequence: 80
            region: @triage
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        help {
            helpText: Why this entity is being ignored. Kept with the row so the next weekly run does not raise it again as an open question.
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 10
            region: @triage
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button ignore (
        buttonName: IGNORE
        label: Ignore
        layout {
            sequence: 20
            region: @triage
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: submitPage
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button promote (
        buttonName: PROMOTE
        label: Add to Collection
        layout {
            sequence: 30
            region: @triage
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: submitPage
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            selectionType: button
            button: @cancel
        }

        action native-cancel-dialog (
            action: cancelDialog
            execution {
                sequence: 10
            }
        )
    )

    process load-context (
        name: Load Context
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                if :P41_LEVEL_NAME = 'INSTANCE' then
                   select h.hostname, i.instance_name, i.port
                     into :P41_HOSTNAME, :P41_INSTANCE_NAME, :P41_PORT
                     from disc_instance i
                     join disc_host h on h.disc_host_id = i.disc_host_id
                    where i.disc_instance_id = :P41_ENTITY_ID;
                else
                   select h.hostname, null, null
                     into :P41_HOSTNAME, :P41_INSTANCE_NAME, :P41_PORT
                     from disc_host h
                    where h.disc_host_id = :P41_ENTITY_ID;
                end if;
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
    )

    process promote-to-collection (
        name: Promote To Collection
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                pkg_dbinv_discovery.promote_instance(
                    p_disc_instance_id => :P41_ENTITY_ID,
                    p_environment      => :P41_ENVIRONMENT,
                    p_license_type     => :P41_LICENSE_TYPE );
                ```
        }
        execution {
            sequence: 10
        }
        serverSideCondition {
            whenButtonPressed: @promote
        }
    )

    process mark-ignored (
        name: Mark Ignored
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                pkg_dbinv_discovery.set_triage(
                    p_level     => :P41_LEVEL_NAME,
                    p_entity_id => :P41_ENTITY_ID,
                    p_status    => 'IGNORED',
                    p_note      => :P41_TRIAGE_NOTE );
                ```
        }
        execution {
            sequence: 20
        }
        serverSideCondition {
            whenButtonPressed: @ignore
        }
    )

    process close-triage-dialog (
        name: Close Triage Dialog
        type: closeDialog
        execution {
            sequence: 90
        }
    )

)
