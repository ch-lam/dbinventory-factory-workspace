    region pg-noncompliance-by-control (
        name: PostgreSQL : Open Non Compliance by Control
        title: PostgreSQL : Open Non Compliance by Control
        type: chart
        layout {
            sequence: 80
            slot: body
            startNewRow: false
            columnSpan: 4
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                i-h320
                t-Region--scrollBody
            ]
        }
        comments {
            comments: The Oracle page notes here that it could not carry over the MSSQL support-status donut, ORACLE_OUT_OF_SUPPORT having no rule behind it. PostgreSQL does not have that problem - PG_ENGINE_SUPPORTED is evaluated against a real calendar - but the support state is already legible on the Versions donut beside it, where each slice is exactly one support date. Keeping this slot on the by-control breakdown says something the other charts do not.
        }
        chart {
            type: bar
        }
        chartAppearance {
            orientation: horizontal
        }
        legend {
            position: bottom
        }

        series pg-noncompliance-by-control (
            name: Open Findings by Control
            execution {
                sequence: 10
            }
            source {
                location: localDatabase
                type: sqlQuery
                sqlQuery:
                    ```sql
                    -- Where the problem is, as opposed to how bad it is (the
                    -- severity chart) or how old the estate is (the release
                    -- update chart). A control carrying a thousand findings is
                    -- fixed by one campaign, not instance by instance, and that
                    -- is a different decision from chasing the worst server.
                    --
                    -- Labelled with ref_control.title, not the control code:
                    -- "Host-based authentication methods" reads,
                    -- POSTGRES_HBA_AUTH does not. Horizontal bars because the
                    -- spread is wide -- one control can carry every pg_hba line
                    -- of the estate while another carries one row per cluster --
                    -- and a donut
                    -- cannot be read at that ratio.
                    --
                    -- "Open" means what it means on the severity chart beside
                    -- it: a derogated finding is not a campaign to run. Without
                    -- these two predicates the bar would keep counting findings
                    -- the RSSI has already signed off.
                    select rc.title as label,
                           count(*) as value
                      from fact_control_finding f
                      join ref_control_rule r
                        on r.rule_code = f.rule_code
                       and r.active = 1
                      join ref_control rc
                        on rc.control_code = r.control_code
                       and rc.score_domain = 'SECURITY'
                       and rc.active = 1
                      join v_entity_ancestry a
                        on a.entity_type = f.entity_type
                       and a.entity_id = f.entity_id
                      join dim_instance i
                        on i.instance_id = a.instance_id
                     where i.platform = 'POSTGRES'
                       and f.is_compliant = 0
                       and f.exception_id is null
                       and f.is_norm_exception = 0
                       and f.snapshot_date = ( select max(f2.snapshot_date) from fact_control_finding f2 )
                     group by rc.title
                     order by count(*) desc
                    ```
            }
            columnMapping {
                label: LABEL
                value: VALUE
            }
        )

        axis x (
            name: x
            showAxis: true
        )

        axis y (
            name: y
            showAxis: true
            title: Open findings
        )

    )

)

