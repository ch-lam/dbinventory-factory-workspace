page 41 (
    name: DB Inv. - Postgres Compliance and Security
    alias: DB-INV-POSTGRES-COMPLIANCE-AND-SECURITY
    title: DB Inv. - Postgres Compliance and Security
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region pg-noncompliance (
        name: Non Compliance Issues
        title: Non Compliance Issues
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select i.instance_name,
                       rc.category,
                       r.title,
                       nvl( r.severity, rc.severity ) severity,
                       f.entity_type scope,
                       f.observed_value,
                       d.db_name,
                       f.item_key,
                       f.expected_value,
                       case when f.exception_id is not null then 'Granted derogation'
                            when f.is_norm_exception = 1 then 'Accepted by the norm'
                            else 'Open'
                       end exception_status,
                       e.justification,
                       -- Appended at the end on purpose: the columns above are
                       -- addressed by reportColumnQueryId, so inserting in the
                       -- middle would renumber every one of them.
                       r.rule_code,
                       f.entity_id
                  from fact_control_finding f
                  join ref_control_rule r
                    on r.rule_code = f.rule_code
                   and r.active = 1
                  join ref_control rc
                    on rc.control_code = r.control_code
                   and rc.score_domain = 'SECURITY'
                   and rc.active = 1
                  join v_entity_ancestry a on a.entity_type = f.entity_type and a.entity_id = f.entity_id
                  join dim_instance i on i.instance_id = a.instance_id
                  left join dim_database d on d.database_id = a.database_id
                  left join ref_exception e on e.exception_id = f.exception_id
                 where i.platform = 'POSTGRES'
                   and f.is_compliant = 0
                   and f.snapshot_date = ( select max(f2.snapshot_date) from fact_control_finding f2 )
                ```
        }
        layout {
            sequence: 110
            slot: body
            startNewRow: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        reportLayout {
            numberOfRows: 60
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
        }
        pagination {
            type: rowRangesXToYOfZWithPagination
            displayPosition: topAndBottomRight
        }
        messages {
            whenNoDataFound: No Compliance Issues matches your criterias
            whenMoreDataFound: Too much issues matches your criteria, please add some filtering to see less than 2000 rows.
        }
        printing {
            enabled: true
        }
        output {
            linkText: Print
            format: pdf
        }
        page {
            height: 8.5
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Non Compliance Issues
        }

        column CATEGORY (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Category
            }
            layout {
                sequence: 20
            }
        )

        column DB_NAME (
            reportColumnQueryId: 7
            derivedColumn: N
            heading {
                heading: Database
            }
            layout {
                sequence: 65
            }
        )

        column ENTITY_ID (
            reportColumnQueryId: 13
            derivedColumn: N
            heading {
                heading: Entity id
            }
            layout {
                sequence: 210
            }
        )

        column EXCEPTION_STATUS (
            reportColumnQueryId: 10
            derivedColumn: N
            heading {
                heading: Exception
            }
            layout {
                sequence: 80
            }
        )

        column EXPECTED_VALUE (
            reportColumnQueryId: 9
            derivedColumn: N
            heading {
                heading: Expected Value
            }
            layout {
                sequence: 75
            }
        )

        column INSTANCE_NAME (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Instance Name
            }
            layout {
                sequence: 60
            }
            comments {
                comments: Plain column, deliberately not a link. There is no PostgreSQL server detail page - 25 covers Oracle and 35 covers MSSQL - and page 40 takes no parameter, so a link there would drop the instance the user clicked.
            }
        )

        column ITEM_KEY (
            reportColumnQueryId: 8
            derivedColumn: N
            heading {
                heading: Item
            }
            layout {
                sequence: 68
            }
        )

        column JUSTIFICATION (
            reportColumnQueryId: 11
            derivedColumn: N
            heading {
                heading: Derogation Justification
            }
            layout {
                sequence: 90
            }
        )

        column OBSERVED_VALUE (
            reportColumnQueryId: 6
            derivedColumn: N
            heading {
                heading: Observed Value
            }
            layout {
                sequence: 70
            }
        )

        column RULE_CODE (
            reportColumnQueryId: 12
            derivedColumn: N
            type: link
            heading {
                heading: Derogation
            }
            layout {
                sequence: 200
            }
            link {
                target: {
                    page: 71
                    items: {
                        P71_RULE_CODE: #RULE_CODE#
                        P71_ENTITY_TYPE: #SCOPE#
                        P71_ENTITY_ID: #ENTITY_ID#
                        P71_ITEM_KEY: #ITEM_KEY#
                        P71_OBSERVED_VALUE: #OBSERVED_VALUE#
                    }
                    clearCache: 71
                }
                linkText: Grant
            }
            sorting {
                sortable: false
            }
            comments {
                comments: Opens the derogation dialog already scoped to this finding, so the rule code and the entity are never typed by hand.
            }
        )

        column SCOPE (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Scope
            }
            layout {
                sequence: 10
            }
        )

        column SEVERITY (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Severity
            }
            layout {
                sequence: 40
            }
        )

        column TITLE (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Title
            }
            layout {
                sequence: 30
            }
        )

    )

    region granted-exceptions (
        name: Granted Exceptions
        title: Granted Exceptions
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select e.exception_id,
                       case when e.active = 0 then 'Disabled'
                            when e.end_date is not null and e.end_date < trunc(sysdate) then 'Expired'
                            when e.start_date > trunc(sysdate) then 'Not started'
                            when nvl( ( select count(*) from fact_control_finding f where f.exception_id = e.exception_id and f.snapshot_date = ( select max(f2.snapshot_date) from fact_control_finding f2 ) ), 0 ) = 0 then 'Active, covers nothing'
                            else 'Active'
                       end status,
                       r.title rule_title,
                       e.entity_type scope,
                       nvl( nvl( i.instance_name, d.db_name ), h.hostname ) scope_name,
                       e.item_key,
                       e.observed_value,
                       ( select count(*) from fact_control_finding f where f.exception_id = e.exception_id and f.snapshot_date = ( select max(f2.snapshot_date) from fact_control_finding f2 ) ) covered_today,
                       e.start_date,
                       e.end_date,
                       e.review_due_date,
                       e.approved_by,
                       e.document_ref,
                       e.justification
                  from ref_exception e
                  join ref_control_rule r on r.rule_code = e.rule_code
                  join ref_control rc on rc.control_code = r.control_code and rc.platform = 'POSTGRES'
                  left join dim_host h on e.entity_type = 'HOST' and h.host_id = e.entity_id
                  left join dim_instance i on e.entity_type = 'INSTANCE' and i.instance_id = e.entity_id
                  left join dim_database d on e.entity_type = 'DATABASE' and d.database_id = e.entity_id
                 order by e.exception_id
                ```
        }
        layout {
            sequence: 120
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        reportLayout {
            numberOfRows: 30
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
        }
        pagination {
            type: rowRangesXToYOfZWithPagination
            displayPosition: topAndBottomRight
        }
        messages {
            whenNoDataFound: No documented derogation has been granted on PostgreSQL yet
        }
        printing {
            enabled: true
        }
        output {
            linkText: Print
            format: pdf
        }
        page {
            height: 8.5
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Granted Exceptions
        }

