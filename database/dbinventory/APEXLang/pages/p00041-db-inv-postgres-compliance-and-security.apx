    region pg-open-noncompliance (
        name: PostgreSQL : Open Non Compliance
        title: PostgreSQL : Open Non Compliance
        type: chart
        layout {
            sequence: 90
            slot: body
            startNewRow: false
            columnSpan: 4
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                i-h320
                t-Region--scrollBody
            ]
        }
        chart {
            type: donut
        }
        settings {
            pieSelectionEffect: highlightAndExplode
        }
        value {
            format: decimal
            decimalPlaces: 0
            formatScaling: none
        }
        legend {
            position: bottom
        }

        series pg-open-noncompliance (
            name: PostgreSQL Open Non Compliance by Severity
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    With COMP_ISSUES As
                    ( select nvl( r.severity, rc.severity ) severity
                        from fact_control_finding f
                        join ref_control_rule r
                          on r.rule_code = f.rule_code
                         and r.active = 1
                        join ref_control rc
                          on rc.control_code = r.control_code
                         and rc.score_domain = 'SECURITY'
                         and rc.active = 1
                        join v_entity_ancestry a on a.entity_type = f.entity_type and a.entity_id = f.entity_id
                        join dim_instance i on i.instance_id = a.instance_id
                       where i.platform = 'POSTGRES'
                         and f.is_compliant = 0
                         and f.exception_id is null
                         and f.is_norm_exception = 0
                         and f.snapshot_date = ( select max(f2.snapshot_date) from fact_control_finding f2 ) )
                    Select COUNT(*) value, InitCAP(SEVERITY) label From COMP_ISSUES Group By InitCAP(SEVERITY)
                    ```
            }
            columnMapping {
                label: LABEL
                value: VALUE
            }
        )

    )

    region pg-versions (
        name: PostgreSQL : Versions
        title: PostgreSQL : Versions
        type: chart
        layout {
            sequence: 70
            slot: body
            columnSpan: 4
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                i-h320
                t-Region--scrollBody
            ]
        }
        chart {
            type: donut
        }
        settings {
            pieSelectionEffect: highlightAndExplode
        }
        value {
            format: decimal
            decimalPlaces: 0
            formatScaling: none
        }
        legend {
            position: bottom
        }

        series pg-versions (
            name: PostgreSQL Major Versions
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                      -- Grouped by MAJOR version, unlike the Oracle page which
                      -- groups by release update. Since release 10 PostgreSQL
                      -- numbers a major with a SINGLE component (16.4 is major 16,
                      -- minor 4), and that is also the grain of the end-of-support
                      -- calendar in product_support -- so this donut and
                      -- PG_ENGINE_SUPPORTED read the version the same way, and a
                      -- slice here maps to one support date rather than several.
                      --
                      -- Ordered numerically, not alphabetically: as text, '9'
                      -- sorts after '16' and would put the oldest cluster last.
                      With PG_MAJOR As
                        ( select nvl( regexp_substr( engine_version, '^\d+' ), 'Unknown' ) major_version
                            from dim_instance where platform = 'POSTGRES' )
                      select major_version as label,
                             count(*) as value
                        from PG_MAJOR
                       group by major_version
                       order by to_number( regexp_substr( major_version, '\d+' ) ) nulls last
                    ```
            }
            columnMapping {
                label: LABEL
                value: VALUE
            }
        )

    )

