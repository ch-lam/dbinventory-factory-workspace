page 45 (
    name: DB Inv. - Postgres Instance
    alias: DB-INV-POSTGRES-INSTANCE
    title: DB Inv. - Postgres Instance
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    advanced {
        reloadOnSubmit: always
    }

    region page-title (
        name: &P45_INSTANCE_LABEL.
        type: staticContent
        layout {
            sequence: 1
            slot: body
        }
        appearance {
            template: @/title-bar
            templateOptions: #DEFAULT#
        }
    )

    region instance-filter (
        name: Instance Selection
        type: staticContent
        layout {
            sequence: 5
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
    )

    pageItem P45_INSTANCE_ID (
        type: selectOne
        label {
            label: Instance
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select h.hostname d,
                       i.instance_id r
                  from dim_instance i
                  join dim_host h on h.host_id = i.host_id
                 where i.platform = 'POSTGRES'
                 order by h.hostname
                ```
        }
        layout {
            sequence: 10
            region: @instance-filter
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        advanced {
            warnOnUnsavedChanges: ignore
        }
        help {
            helpText: Select the PostgreSQL cluster whose card is displayed below.
        }
    )

    pageItem P45_INSTANCE_LABEL (
        type: hidden
        layout {
            sequence: 20
            region: @instance-filter
            slot: regionBody
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select h.hostname
                  from dim_instance i
                  join dim_host h on h.host_id = i.host_id
                 where i.instance_id = :P45_INSTANCE_ID
                ```
            used: always
        }
    )

    region pg-instance-host (
        name: Server
        title: Server
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select h.hostname,
                       h.environment,
                       h.license_type,
                       e.data_directory,
                       e.start_time,
                       ( select count(*) from dim_database d where d.instance_id = i.instance_id ) database_count
                  from dim_instance i
                  join dim_host h on h.host_id = i.host_id
                  left join ext_postgres_instance e on e.instance_id = i.instance_id
                 where i.instance_id = :P45_INSTANCE_ID
                ```
            pageItemsToSubmit: P45_INSTANCE_ID
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--horizontalBorders
            ]
        }
        pagination {
            type: rowRangesXToYNoPagination
        }
        messages {
            whenNoDataFound: Select an instance above.
        }

        column HOSTNAME (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Hostname
            }
            layout {
                sequence: 10
            }
            comments {
                comments: Also the instance name: the PostgreSQL collect never carries the port into the data, so one host is one cluster in this model. A second cluster on the same machine could not be told apart.
            }
        )

        column ENVIRONMENT (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Environment
                alignment: center
            }
            layout {
                sequence: 20
                columnAlignment: center
            }
        )

        column LICENSE_TYPE (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: License
            }
            layout {
                sequence: 30
            }
        )

        column DATA_DIRECTORY (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Data Directory
            }
            layout {
                sequence: 40
            }
        )

        column START_TIME (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Started
                alignment: center
            }
            layout {
                sequence: 50
                columnAlignment: center
            }
        )

        column DATABASE_COUNT (
            reportColumnQueryId: 6
            derivedColumn: N
            heading {
                heading: Databases
                alignment: end
            }
            layout {
                sequence: 60
                columnAlignment: end
            }
        )

    )

    region pg-instance-identity (
        name: Instance
        title: Instance
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
