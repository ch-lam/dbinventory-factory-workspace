                select i.instance_name,
                       i.engine_version,
                       i.port,
                       e.db_role,
                       e.wal_level,
                       e.archive_mode,
                       e.max_connections,
                       e.shared_buffers_mb
                  from dim_instance i
                  left join ext_postgres_instance e on e.instance_id = i.instance_id
                 where i.instance_id = :P45_INSTANCE_ID
                ```
            pageItemsToSubmit: P45_INSTANCE_ID
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
