        }
        pagination {
            type: rowRangesXToYNoPagination
        }
        messages {
            whenNoDataFound: Select an instance above.
        }

        column INSTANCE_NAME (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Instance
            }
            layout {
                sequence: 10
            }
        )

        column ENGINE_VERSION (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Version
            }
            layout {
                sequence: 20
            }
        )

        column PORT (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Port
                alignment: end
            }
            layout {
                sequence: 30
                columnAlignment: end
            }
        )

        column DB_ROLE (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Role
                alignment: center
            }
            layout {
                sequence: 40
                columnAlignment: center
            }
            comments {
                comments: STANDBY explains why a cluster carries no SECURITY finding: get_info_postgres_security.sh skips standbys, their configuration being that of the primary and already judged.
            }
        )

        column WAL_LEVEL (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: WAL Level
            }
            layout {
                sequence: 50
            }
        )

        column ARCHIVE_MODE (
            reportColumnQueryId: 6
            derivedColumn: N
            heading {
                heading: Archive Mode
                alignment: center
            }
            layout {
                sequence: 60
                columnAlignment: center
            }
        )

        column MAX_CONNECTIONS (
            reportColumnQueryId: 7
            derivedColumn: N
            heading {
                heading: Max Connections
                alignment: end
            }
            layout {
                sequence: 70
                columnAlignment: end
            }
        )

        column SHARED_BUFFERS_MB (
            reportColumnQueryId: 8
            derivedColumn: N
            heading {
                heading: Shared Buffers (MB)
                alignment: end
            }
            layout {
                sequence: 80
                columnAlignment: end
            }
        )

    )

    region pg-instance-version (
        name: Version & Support
        title: Version & Support
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select i.engine_version,
                       ps.display_name release_name,
                       to_char(ps.edition_date, 'DD/MM/YYYY') released,
                       to_char(ps.end_of_support_date, 'DD/MM/YYYY') community_support_end,
                       case when fc.control_code is null then 'Not assessed'
                            when fc.is_compliant = 0    then 'Out of support'
                            else 'Supported'
                       end support_status,
                       fc.observed_value support_detail
                  from dim_instance i
                  left join product_support ps
                    on ps.product_company = 'POSTGRESQL'
                   and ps.product_type = 'POSTGRES'
                   and ps.product_version = regexp_substr( i.engine_version, '^\d+' )
                  left join fact_compliance fc
                    on fc.entity_type = 'INSTANCE'
                   and fc.entity_id = i.instance_id
                   and fc.control_code = 'POSTGRES_OUT_OF_SUPPORT'
                   and fc.snapshot_date = ( select max(f2.snapshot_date) from fact_compliance f2 )
                 where i.instance_id = :P45_INSTANCE_ID
                ```
            pageItemsToSubmit: P45_INSTANCE_ID
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--horizontalBorders
            ]
        }
        pagination {
            type: rowRangesXToYNoPagination
        }
        messages {
            whenNoDataFound: Select an instance above.
        }

        column ENGINE_VERSION (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Version
            }
            layout {
                sequence: 10
            }
        )

        column RELEASE_NAME (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Release
            }
            layout {
                sequence: 20
            }
        )

        column RELEASED (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Released
                alignment: center
            }
            layout {
                sequence: 30
                columnAlignment: center
            }
        )

        column COMMUNITY_SUPPORT_END (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Support Ends
                alignment: center
            }
            layout {
                sequence: 40
                columnAlignment: center
            }
            comments {
                comments: Five years from the initial release. There is no extended support on PostgreSQL, which is why no Extended column appears here as it does on the Oracle and MSSQL cards.
            }
        )

        column SUPPORT_STATUS (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Status
                alignment: center
            }
            layout {
                sequence: 50
                columnAlignment: center
            }
        )

        column SUPPORT_DETAIL (
            reportColumnQueryId: 6
            derivedColumn: N
            heading {
                heading: Detail
            }
            layout {
                sequence: 60
            }
        )

    )

    region pg-instance-databases (
        name: Databases
        title: Databases
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select d.db_name,
                       d.environment,
                       p.owner,
                       p.encoding,
                       p.collation,
                       p.tablespace,
                       sc.used_mb size_mb,
                       round( 100 * p.xid_age / 2147483648, 2 ) pct_xid_used,
                       d.database_id
                  from dim_database d
                  left join postgres_databases p
                    on p.hostname = ( select i.instance_name from dim_instance i where i.instance_id = d.instance_id )
                   and p.datname = d.db_name
                  left join dim_storage_unit su
                    on su.database_id = d.database_id
                   and su.storage_type = 'DATABASE'
                  left join fact_storage_capacity sc
                    on sc.storage_unit_id = su.storage_unit_id
                   and sc.snapshot_date = ( select max(s.snapshot_date) from fact_storage_capacity s )
                 where d.instance_id = :P45_INSTANCE_ID
                   and d.platform = 'POSTGRES'
                 order by d.db_name
                ```
            pageItemsToSubmit: P45_INSTANCE_ID
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--horizontalBorders
            ]
        }
        pagination {
            type: rowRangesXToYOfZWithPagination
        }
        messages {
            whenNoDataFound: No database collected on this instance.
        }

        column DB_NAME (
            reportColumnQueryId: 1
            derivedColumn: N
            type: link
            heading {
                heading: Database
            }
            layout {
                sequence: 10
            }
            link {
                target: {
                    page: 46
                    items: {
                        P46_DATABASE_ID: #DATABASE_ID#
