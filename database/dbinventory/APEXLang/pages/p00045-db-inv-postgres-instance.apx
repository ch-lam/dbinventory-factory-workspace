        )

    )

    region pg-instance-wal (
        name: WAL Archiving
        title: WAL Archiving
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                -- L'archivage WAL n'est PAS une sauvegarde : aucun catalogue pgBackRest ou
                -- Barman n'est collecte, donc rien ici ne dit qu'une restauration ait ete
                -- possible. Ce qu'il dit, c'est si la condition necessaire d'une recuperation a
                -- un instant donne tient. Les deux controles sont
                -- POSTGRES_WAL_ARCHIVING et POSTGRES_BACKUP_FRESHNESS.
                select e.archive_mode,
                       to_char(ib.last_log_date, 'DD/MM/YYYY HH24:MI') last_archived_time,
                       b.last_archived_wal,
                       ib.hours_since_backup hours_since_archived,
                       t.crit_value sla_hours,
                       ib.failed_count,
                       b.last_failed_wal
                  from dim_instance i
                  left join ext_postgres_instance e on e.instance_id = i.instance_id
                  left join fact_instance_backup ib
                    on ib.instance_id = i.instance_id
                   and ib.snapshot_date = ( select max(b2.snapshot_date) from fact_instance_backup b2 )
                  left join postgres_backup b on b.hostname = i.instance_name
                  left join ref_threshold t
                    on t.control_code = 'POSTGRES_BACKUP_FRESHNESS'
                   and t.metric = 'hours_since_archived'
                   and t.environment = '*'
                 where i.instance_id = :P45_INSTANCE_ID
                ```
            pageItemsToSubmit: P45_INSTANCE_ID
        }
        layout {
            sequence: 50
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--horizontalBorders
            ]
        }
        pagination {
            type: rowRangesXToYNoPagination
        }
        messages {
            whenNoDataFound: No WAL archiver statistics collected.
        }

        column ARCHIVE_MODE (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Archive Mode
                alignment: center
            }
            layout {
                sequence: 10
                columnAlignment: center
            }
        )

        column LAST_ARCHIVED_TIME (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Last Archived
                alignment: center
            }
            layout {
                sequence: 20
                columnAlignment: center
            }
        )

        column LAST_ARCHIVED_WAL (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Last WAL Segment
            }
            layout {
                sequence: 30
            }
        )

        column HOURS_SINCE_ARCHIVED (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Hours Since
                alignment: end
            }
            layout {
                sequence: 40
                columnAlignment: end
            }
            comments {
                comments: Empty when archiving is off: pg_stat_archiver has never archived anything, the collect writes NA, and safe_to_date returns null rather than a fabricated date.
            }
        )

        column SLA_HOURS (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: SLA (h)
                alignment: end
            }
            layout {
                sequence: 50
                columnAlignment: end
            }
        )

        column FAILED_COUNT (
            reportColumnQueryId: 6
            derivedColumn: N
            heading {
                heading: Failed
                alignment: end
            }
            layout {
                sequence: 60
                columnAlignment: end
            }
        )

        column LAST_FAILED_WAL (
            reportColumnQueryId: 7
            derivedColumn: N
            heading {
                heading: Last Failed WAL
            }
            layout {
                sequence: 70
            }
        )

    )

    region pg-instance-replication (
        name: Replication
        title: Replication
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                -- Lu depuis la collecte : la replication streaming n'a pas de place dans le
                -- modele dimensionnel et n'est scoree par rien. C'est voulu -- un retard de
                -- replication est un signal de supervision, surveille par Zabbix, pas un verdict
                -- de conformite que cet inventaire doit rendre.
                select r.db_role,
                       r.peer_addr,
                       r.state,
                       r.sync_state,
                       case when r.lag_seconds < 0 then null else r.lag_seconds end lag_seconds
                  from postgres_replication r
                  join dim_instance i on i.instance_name = r.hostname
                 where i.instance_id = :P45_INSTANCE_ID
                 order by r.peer_addr
                ```
            pageItemsToSubmit: P45_INSTANCE_ID
        }
        layout {
            sequence: 60
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--horizontalBorders
            ]
        }
        pagination {
            type: rowRangesXToYNoPagination
        }
        messages {
            whenNoDataFound: No streaming replication. A cluster with no standby produces no row here.
        }

        column DB_ROLE (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Role
                alignment: center
            }
            layout {
                sequence: 10
                columnAlignment: center
            }
        )

        column PEER_ADDR (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Peer
            }
            layout {
                sequence: 20
            }
        )

        column STATE (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: State
                alignment: center
            }
            layout {
                sequence: 30
                columnAlignment: center
            }
        )

        column SYNC_STATE (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Sync
                alignment: center
            }
            layout {
                sequence: 40
                columnAlignment: center
            }
        )

        column LAG_SECONDS (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Lag (s)
                alignment: end
            }
            layout {
                sequence: 50
                columnAlignment: end
            }
            comments {
                comments: The collect writes -1 for "not measurable", not for a negative lag; it is shown empty rather than as a negative number.
            }
        )

    )

    region pg-instance-roles (
        name: Roles
        title: Roles
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select a.account_name,
                       a.account_type,
                       r.rolsuper,
                       r.rolcreaterole,
                       r.rolcreatedb,
                       r.rolreplication,
                       r.rolbypassrls,
                       r.rolconnlimit,
                       r.rolvaliduntil
                  from dim_account a
                  join dim_instance i on i.host_id = a.host_id
                  left join postgres_security_roles r
                    on r.hostname = i.instance_name
                   and r.rolname = a.account_name
                 where i.instance_id = :P45_INSTANCE_ID
                   and a.platform = 'POSTGRES'
                   and a.scope = 'SERVER'
                 order by a.account_name
                ```
            pageItemsToSubmit: P45_INSTANCE_ID
        }
        layout {
            sequence: 70
            slot: body
