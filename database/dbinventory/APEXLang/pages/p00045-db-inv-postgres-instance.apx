            layout {
                sequence: 20
                columnAlignment: center
            }
        )

        column OWNER (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Owner
            }
            layout {
                sequence: 30
            }
        )

        column ENCODING (
            reportColumnQueryId: 4
