page 70 (
    name: DB Inv. - Derogations
    alias: DB-INV-DEROGATIONS
    title: DB Inv. - Derogations
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region derogations (
        name: Derogations
        title: Derogations
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select e.exception_id,
                       e.review_state,
                       e.status,
                       e.platform,
                       e.rule_title,
                       e.entity_type,
                       e.scope_name,
                       e.item_key,
                       e.start_date,
                       e.end_date,
                       e.review_due_date,
                       e.covered_today,
                       e.created_by,
                       e.approved_by
                  from v_exception_review e
                 order by case e.review_state
                             when 'Expired'                  then 1
                             when 'Review overdue'           then 2
                             when 'Expiring within 60 days'  then 3
                             when 'Awaiting approval'        then 4
                             when 'Draft, not submitted'     then 5
                             when 'Approved, covers nothing' then 6
                             else 7
                          end,
                          e.exception_id
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        reportLayout {
            numberOfRows: 30
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
        }
        pagination {
            type: rowRangesXToYOfZWithPagination
            displayPosition: topAndBottomRight
        }
        messages {
            whenNoDataFound: No derogation has been captured yet
        }

        column APPROVED_BY (
            reportColumnQueryId: 14
            derivedColumn: N
            heading {
                heading: Approved by
            }
            layout {
                sequence: 140
            }
        )

        column COVERED_TODAY (
            reportColumnQueryId: 12
            derivedColumn: N
            heading {
                heading: Findings covered
            }
            layout {
                sequence: 120
            }
        )

        column CREATED_BY (
            reportColumnQueryId: 13
            derivedColumn: N
            heading {
                heading: Requested by
            }
            layout {
                sequence: 130
            }
        )

        column END_DATE (
            reportColumnQueryId: 10
            derivedColumn: N
            heading {
                heading: Until
            }
            layout {
                sequence: 100
            }
        )

        column ENTITY_TYPE (
            reportColumnQueryId: 6
            derivedColumn: N
            heading {
                heading: Scope
            }
            layout {
                sequence: 60
            }
        )

        column EXCEPTION_ID (
            reportColumnQueryId: 1
            derivedColumn: N
            type: link
            heading {
                heading: Id
            }
            layout {
                sequence: 10
            }
            link {
                target: {
                    page: 71
                    items: {
                        P71_EXCEPTION_ID: #EXCEPTION_ID#
                    }
                    clearCache: 71
                }
                linkText: #EXCEPTION_ID#
            }
        )

        column ITEM_KEY (
            reportColumnQueryId: 8
            derivedColumn: N
            heading {
                heading: Item
            }
            layout {
                sequence: 80
            }
        )

        column PLATFORM (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Platform
            }
            layout {
                sequence: 40
            }
        )

        column REVIEW_DUE_DATE (
            reportColumnQueryId: 11
            derivedColumn: N
            heading {
                heading: Review due
            }
            layout {
                sequence: 110
            }
        )

        column REVIEW_STATE (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Review
            }
            layout {
                sequence: 20
            }
        )

        column RULE_TITLE (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Rule
            }
            layout {
                sequence: 50
            }
        )

        column SCOPE_NAME (
            reportColumnQueryId: 7
            derivedColumn: N
            heading {
                heading: Entity
            }
            layout {
                sequence: 70
            }
        )

        column START_DATE (
            reportColumnQueryId: 9
            derivedColumn: N
            heading {
                heading: From
            }
            layout {
                sequence: 90
            }
        )

        column STATUS (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Status
            }
            layout {
                sequence: 30
            }
        )

    )

    region review-summary (
        name: To Review
        title: To Review
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select review_state,
                       count(*) derogations,
                       sum(covered_today) findings_covered
                  from v_exception_review
                 where review_state <> 'Current'
                 group by review_state
                 order by case review_state
                             when 'Expired'                  then 1
                             when 'Review overdue'           then 2
                             when 'Expiring within 60 days'  then 3
                             when 'Awaiting approval'        then 4
                             when 'Draft, not submitted'     then 5
                             when 'Approved, covers nothing' then 6
                             else 7
                          end
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--altRowsDefault
            ]
        }
        messages {
            whenNoDataFound: Nothing waiting: every derogation is current
        }

        column DEROGATIONS (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Derogations
            }
            layout {
                sequence: 20
            }
        )

        column FINDINGS_COVERED (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Findings covered
            }
            layout {
                sequence: 30
            }
        )

        column REVIEW_STATE (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Review state
            }
            layout {
                sequence: 10
            }
        )

    )

    button create (
        buttonName: CREATE
        label: New Derogation
        layout {
            sequence: 10
            region: @derogations
            slot: edit
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 71
                clearCache: 71
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

)

