    region documents (
        name: Documentation
        title: Documentation
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select r.doc_kind,
                       r.title,
                       case when r.file_name is not null then r.file_name
                            else r.external_url end location,
                       r.review_state,
                       r.review_due_date,
                       r.review_rank,
                       r.document_id
                  from v_application_document_review r
                 where r.application_id = :P81_APPLICATION_ID
                ```
        }
        layout {
            sequence: 50
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        comments {
            comments: A document is stored, linked, or both. The location column shows the file name when there is one and the URL otherwise, so a reader can tell at a glance which documents live here and which only have a pointer. Upload is not yet wired on this page - see the note in the plan about the fileUpload storage type, which cannot be expressed in the .apx and is reset by every import.
        }
        reportLayout {
            numberOfRows: 20
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--altRowsDefault
            ]
        }
        messages {
            whenNoDataFound: No documentation recorded
        }

