    region history (
        name: History
        title: History
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select e.event_date,
                       e.event_type,
                       e.subject_ref,
                       e.event_by,
                       e.note,
                       e.old_value,
                       e.new_value,
                       -e.event_id sort_key
                  from ref_application_event e
                 where e.application_id = :P81_APPLICATION_ID
                ```
        }
        layout {
            sequence: 70
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        comments {
            comments: The append-only journal. It is written by triggers, not by this page, so it records changes made from anywhere - a page process, an interactive grid, a script. Nothing here can alter it: the table refuses update and delete outright.
        }
