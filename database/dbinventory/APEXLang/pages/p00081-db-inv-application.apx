    process load-application (
        name: Load Application
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                if :P81_APPLICATION_ID is not null then
                   select a.app_code, a.app_name, a.description, a.criticality,
                          a.lifecycle_status, a.review_due_date,
                          nvl(to_char(a.last_review_date, 'YYYY-MM-DD')
                              || ' by ' || a.last_review_by, 'never')
                     into :P81_APP_CODE, :P81_APP_NAME, :P81_DESCRIPTION, :P81_CRITICALITY,
                          :P81_LIFECYCLE_STATUS, :P81_REVIEW_DUE_DATE, :P81_LAST_REVIEW
                     from ref_application a
                    where a.application_id = :P81_APPLICATION_ID;
                else
                   :P81_CRITICALITY := 'STANDARD';
                   :P81_LIFECYCLE_STATUS := 'ACTIVE';
                   :P81_LAST_REVIEW := 'never';
                end if;
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
    )

    process save-application (
        name: Save Application
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                -- Writes go through the package, which validates and dates. The
                -- journal is written by a trigger either way, so a future screen
                -- that forgets this call still leaves a trace -- it just leaves
                -- one without a reason attached.
                if :P81_APPLICATION_ID is null then
                   :P81_APPLICATION_ID := pkg_dbinv_application.create_application(
                      p_app_code         => :P81_APP_CODE,
                      p_app_name         => :P81_APP_NAME,
                      p_description      => :P81_DESCRIPTION,
                      p_criticality      => :P81_CRITICALITY,
                      p_lifecycle_status => :P81_LIFECYCLE_STATUS );
                else
                   pkg_dbinv_application.update_application(
                      p_application_id   => :P81_APPLICATION_ID,
                      p_app_name         => :P81_APP_NAME,
                      p_description      => :P81_DESCRIPTION,
                      p_criticality      => :P81_CRITICALITY,
                      p_lifecycle_status => :P81_LIFECYCLE_STATUS,
                      p_note             => 'edited from the application screen' );

                   update ref_application
                      set review_due_date = :P81_REVIEW_DUE_DATE
                    where application_id = :P81_APPLICATION_ID;
                end if;
                ```
        }
        execution {
            sequence: 20
        }
        serverSideCondition {
            whenButtonPressed: @save
        }
        successMessage {
            successMessage: Application saved
        }
    )

    process review-application (
        name: Record Review
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                pkg_dbinv_application.record_review(
                   p_application_id => :P81_APPLICATION_ID,
                   p_note           => 'reviewed from the application screen',
                   p_next_months    => 12 );
                ```
        }
        execution {
            sequence: 30
        }
        serverSideCondition {
            whenButtonPressed: @record-review
        }
        successMessage {
            successMessage: Review recorded, next one due in 12 months
        }
    )

)
