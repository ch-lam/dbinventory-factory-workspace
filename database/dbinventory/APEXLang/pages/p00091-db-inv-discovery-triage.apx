page 91 (
    name: DB Inv. - Discovery Triage
    alias: DB-INV-DISCOVERY-TRIAGE
    title: DB Inv. - Discovery Triage
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region triage (
        name: Discovered Entity
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
    )

    pageItem P91_ENTITY_ID (
        type: hidden
        layout {
            sequence: 20
            region: @triage
            slot: regionBody
        }
    )

    pageItem P91_ENVIRONMENT (
        type: selectList
        label {
            label: Environment
            alignment: right
        }
        lov {
            type: sharedComponent
            lov: @discovery-environment
            displayNullValue: false
        }
        layout {
            sequence: 60
            region: @triage
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        help {
            helpText: Reference values, from the environments and licence_types tables. Required to promote.
        }
    )

    pageItem P91_HOSTNAME (
        type: displayOnly
        label {
            label: Host
            alignment: right
        }
        layout {
            sequence: 30
            region: @triage
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
    )

    pageItem P91_INSTANCE_NAME (
        type: displayOnly
        label {
            label: Instance
            alignment: right
        }
        layout {
            sequence: 40
            region: @triage
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
    )

    pageItem P91_LEVEL_NAME (
        type: hidden
        layout {
            sequence: 10
            region: @triage
            slot: regionBody
        }
    )

    pageItem P91_LICENSE_TYPE (
        type: selectList
        label {
            label: License Type
            alignment: right
        }
        lov {
            type: sharedComponent
            lov: @discovery-license
            displayNullValue: false
        }
        layout {
            sequence: 70
            region: @triage
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        help {
            helpText: Reference values, from the environments and licence_types tables. Required to promote.
        }
    )

    pageItem P91_PORT (
        type: textField
        label {
            label: TCP Port
            alignment: right
        }
        layout {
            sequence: 50
            region: @triage
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        help {
            helpText: MSSQL reads it from the instance registry key, and it is then already filled: without it a named instance cannot be collected, because it does not listen on 1433. Oracle and PostgreSQL are only discovered at host level, so when the host listens on several ports the choice is yours.
        }
    )

    pageItem P91_PLATFORM (
        type: hidden
        layout {
            sequence: 15
            region: @triage
            slot: regionBody
        }
    )

    pageItem P91_PORTS_SEEN (
        type: displayOnly
        label {
            label: Ports Seen
            alignment: right
        }
        layout {
            sequence: 51
            region: @triage
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        help {
            helpText: Every port the detection saw listening on this host, for the engine concerned. Several of them means the discovery cannot choose, and you must.
        }
    )

    pageItem P91_COLLECT_NAME (
        type: textField
        label {
            label: Collect Name
            alignment: right
        }
        layout {
            sequence: 55
            region: @triage
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        help {
            helpText: The key of the Oracle and PostgreSQL perimeters, and a human choice: it names the target in the generated list and in every screen afterwards. MSSQL does not use one, its perimeter is keyed on host and port.
        }
    )

    pageItem P91_SERVICE_NAME (
        type: textField
        label {
            label: Oracle Service
            alignment: right
        }
        layout {
            sequence: 56
            region: @triage
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        help {
            helpText: The database service name, which the connect string needs. The discovery only found the SID, from ora_pmon_<SID>, and a SID is not a service: prefilled with it as a starting point, to be confirmed.
        }
    )

    pageItem P91_TRIAGE_NOTE (
        type: textarea
        label {
            label: Note
            alignment: right
        }
        layout {
            sequence: 80
            region: @triage
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        help {
            helpText: Why this entity is being ignored. Kept with the row so the next weekly run does not raise it again as an open question.
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 10
            region: @triage
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button ignore (
        buttonName: IGNORE
        label: Ignore
        layout {
            sequence: 20
            region: @triage
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: item!=value
            item: P91_LEVEL_NAME
            value: PERIMETER
        }
    )

    button promote (
        buttonName: PROMOTE
        label: Add to Collection
        layout {
            sequence: 30
            region: @triage
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: item!=value
            item: P91_LEVEL_NAME
            value: PERIMETER
        }
    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-cancel-dialog (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process close-triage-dialog (
        name: Close Triage Dialog
        type: closeDialog
        execution {
            sequence: 90
        }
        advanced {
            executionMappingIdentifier: 6078469143392321
        }
    )

    process load-context (
        name: Load Context
        type: executeCode
        source {
            plsqlCode:
                ```plsql
-- Trois niveaux, et le troisieme n'est pas une entite decouverte :
                -- PERIMETER designe une entree de la liste de collecte que plus
                -- aucun run ne rapporte. Il n'y a rien a trancher dessus, et
                -- surtout aucun entity_id a lire -- c'est ce que cette page
                -- faisait avant, et elle levait no_data_found.
                if :P91_LEVEL_NAME = 'PERIMETER' then
                   return;
                elsif :P91_LEVEL_NAME = 'INSTANCE' then
                   select h.platform, h.hostname, i.instance_name,
                          i.port, h.ports_seen
                     into :P91_PLATFORM, :P91_HOSTNAME, :P91_INSTANCE_NAME,
                          :P91_PORT, :P91_PORTS_SEEN
                     from disc_instance i
                     join disc_host h on h.disc_host_id = i.disc_host_id
                    where i.disc_instance_id = :P91_ENTITY_ID;
                else
                   select h.platform, h.hostname, null, null, h.ports_seen
                     into :P91_PLATFORM, :P91_HOSTNAME, :P91_INSTANCE_NAME,
                          :P91_PORT, :P91_PORTS_SEEN
                     from disc_host h
                    where h.disc_host_id = :P91_ENTITY_ID;
                end if;

                -- Un port propose plutot qu'un champ vide, mais seulement quand
                -- il n'y a pas d'ambiguite : plusieurs ports vus, c'est un choix
                -- humain, et le pre-remplir serait le prendre a sa place.
                if :P91_PORT is null and instr(:P91_PORTS_SEEN, ',') = 0 then
                   :P91_PORT := to_number(trim(:P91_PORTS_SEEN)
                                          default null on conversion error);
                end if;

                -- Amorces de saisie. Le SID est le point de depart le plus
                -- probable du nom de service, pas sa reponse.
                :P91_COLLECT_NAME := nvl(:P91_INSTANCE_NAME,
                                         upper(regexp_substr(:P91_HOSTNAME, '^[^.]+')));
                :P91_SERVICE_NAME := :P91_INSTANCE_NAME;
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 6077280278392321
        }
    )

    process mark-ignored (
        name: Mark Ignored
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                pkg_dbinv_discovery.set_triage(
                    p_level     => :P91_LEVEL_NAME,
                    p_entity_id => :P91_ENTITY_ID,
                    p_status    => 'IGNORED',
                    p_note      => :P91_TRIAGE_NOTE );
                ```
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 6078066242392321
        }
        serverSideCondition {
            whenButtonPressed: @ignore
        }
    )

    process promote-to-collection (
        name: Promote To Collection
        type: executeCode
        source {
            plsqlCode:
                ```plsql
-- PostgreSQL n'a pas de grain instance dans la discovery, et un
                -- constat MSSQL de niveau hote non plus : ces deux-la passent
                -- par promote_host. Le paquetage refuse nommement ce qui ne peut
                -- pas etre promu (MySQL, Oracle sans SID) plutot que d'echouer
                -- sur une valeur nulle.
                if :P91_LEVEL_NAME = 'INSTANCE' then
                   pkg_dbinv_discovery.promote_instance(
                       p_disc_instance_id => :P91_ENTITY_ID,
                       p_environment      => :P91_ENVIRONMENT,
                       p_license_type     => :P91_LICENSE_TYPE,
                       p_collect_name     => :P91_COLLECT_NAME,
                       p_service_name     => :P91_SERVICE_NAME,
                       p_port             => to_number(:P91_PORT
                                                       default null on conversion error) );
                else
                   pkg_dbinv_discovery.promote_host(
                       p_disc_host_id => :P91_ENTITY_ID,
                       p_environment  => :P91_ENVIRONMENT,
                       p_license_type => :P91_LICENSE_TYPE,
                       p_collect_name => :P91_COLLECT_NAME,
                       p_port         => to_number(:P91_PORT
                                                   default null on conversion error) );
                end if;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 6077615025392321
        }
        serverSideCondition {
            whenButtonPressed: @promote
        }
    )

)

