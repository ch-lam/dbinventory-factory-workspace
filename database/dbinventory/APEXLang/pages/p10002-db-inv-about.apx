page 10002 (
    name: DB Inv. - About
    alias: DB-INV-ABOUT
    title: DB Inv. - About
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        authorizationScheme: @administration-rights
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region environment (
        name: Environment
        title: Environment
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select e.section_order,
                       e.sort_order,
                       e.section,
                       e.name,
                       e.value
                  from v_environment_identity e
                ```
        }
        layout {
            sequence: 10
            slot: body
            startNewRow: true
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
        }
        reportLayout {
            numberOfRows: 50
        }
        messages {
            whenNoDataFound: The environment could not describe itself - check v_environment_identity
        }
        comments {
            comments: Answers "which database am I actually looking at, and is its data real". Reads v_environment_identity, the same view SQLcl and deployment pipelines read, so all three cannot disagree.
        }

        // The two ordering columns are hidden and carry the report's default
        // sort. An `order by` inside the query does NOT survive: APEX wraps a
        // classic report query for pagination and the rows come back in an
        // arbitrary order -- sections interleaved, items shuffled. Sorting has to
        // be declared on columns, so the columns have to exist.
        // No `heading` on a hidden column: it renders nothing, so the property is
        // rejected outright.
        column SECTION_ORDER (
            reportColumnQueryId: 1
            derivedColumn: N
            type: hidden
            layout {
                sequence: 10
            }
            sorting {
                defaultSequence: 1
            }
        )

        column SORT_ORDER (
            reportColumnQueryId: 2
            derivedColumn: N
            type: hidden
            layout {
                sequence: 20
            }
            sorting {
                defaultSequence: 2
            }
        )

        column SECTION (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Section
            }
            layout {
                sequence: 30
            }
        )

        column NAME (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Item
            }
            layout {
                sequence: 40
            }
        )

        column VALUE (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Value
            }
            layout {
                sequence: 50
            }
        )
    )

    region releases (
        name: Deployment History
        title: Deployment History
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select r.version,
                       r.installed_date,
                       r.installed_by,
                       r.note
                  from ref_app_release r
                 order by r.release_id desc
                ```
        }
        layout {
            sequence: 20
            slot: body
            startNewRow: true
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--altRowsDefault
            ]
        }
        reportLayout {
            numberOfRows: 15
        }
        messages {
            whenNoDataFound: No installation has been recorded yet
        }
        comments {
            comments: Append-only, so a reinstall adds a line rather than erasing the previous ones. That sequence is what shows HOW two environments diverged, not merely that they did.
        }

        column VERSION (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Version
            }
            layout {
                sequence: 10
            }
        )

        column INSTALLED_DATE (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Installed on
            }
            layout {
                sequence: 20
            }
        )

        column INSTALLED_BY (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: By
            }
            layout {
                sequence: 30
            }
        )

        column NOTE (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Note
            }
            layout {
                sequence: 40
            }
        )
    )

)
