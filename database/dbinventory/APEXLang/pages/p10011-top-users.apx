page 10011 (
    name: Top Users
    alias: TOP-USERS
    title: Top Users
    pageGroup: @administration
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: [
            #DEFAULT#
            ui-dialog--stretch
            t-Dialog--noPadding
        ]
    }
    dialog {
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
        warnOnUnsavedChanges: false
    }
    css {
        inline:
            ```css
            .hour-graph { display: table; width: 100%; }
            span.hour { display: table-cell; padding: 0; font-size: 11px; text-align: center; min-width: 32px; }
            span.hour-label { opacity: 0.5; }
            span.hour-value { display: block; }
            span.hour { background-color: var(--ut-palette-success); color:  var(--ut-palette-success-contrast); }
            span.hour.n { background-color: var(--ut-component-highlight-background-color); color: var(--ut-component-text-default-color); }
            span.hour.o { background-color: var(--ut-palette-primary); color:  var(--ut-palette-primary-contrast); }
            ```
    }
    security {
        authorizationScheme: @administration-rights
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    help {
        helpText:
            ```html
            <p>Use this report and chart to see the users with the most page views for the specified timeframe.</p>
            <p>Select the reporting timeframe (Default = 1 day) and choose between the report and chart icons at the top of the page.</p>
            <p>For the interactive report, use the search field, or select the <strong>User</strong> column heading, to select a specific user. You can perform numerous functions by clicking the <strong>Actions</strong> button, such as columns displayed / hidden, rows per page, filter, and so forth. Click the <strong>Reset</strong> button to reset the interactive report back to the default settings.</p>
            ```
    }
    config {
        buildOption: @feature-activity-reporting
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 10
            slot: dialogHeader
        }
        appearance {
            template: @/buttons-container
            templateOptions: [
                #DEFAULT#
                t-ButtonRegion--slimPadding
                t-ButtonRegion--noUI
                t-Form--large
            ]
        }
    )

    region top-users (
        name: Top Users
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select the_user,
                        case when h00=0 then 'n' when h00>999 then 'o' end as c00,h00 as v00,
                        case when h01=0 then 'n' when h01>999 then 'o' end as c01,h01 as v01,
                        case when h02=0 then 'n' when h02>999 then 'o' end as c02,h02 as v02,
                        case when h03=0 then 'n' when h03>999 then 'o' end as c03,h03 as v03,
                        case when h04=0 then 'n' when h04>999 then 'o' end as c04,h04 as v04,
                        case when h05=0 then 'n' when h05>999 then 'o' end as c05,h05 as v05,
                        case when h06=0 then 'n' when h06>999 then 'o' end as c06,h06 as v06,
                        case when h07=0 then 'n' when h07>999 then 'o' end as c07,h07 as v07,
                        case when h08=0 then 'n' when h08>999 then 'o' end as c08,h08 as v08,
                        case when h09=0 then 'n' when h09>999 then 'o' end as c09,h09 as v09,
                        case when h10=0 then 'n' when h10>999 then 'o' end as c10,h10 as v10,
                        case when h11=0 then 'n' when h11>999 then 'o' end as c11,h11 as v11,
                        case when h12=0 then 'n' when h12>999 then 'o' end as c12,h12 as v12,
                        case when h13=0 then 'n' when h13>999 then 'o' end as c13,h13 as v13,
                        case when h14=0 then 'n' when h14>999 then 'o' end as c14,h14 as v14,
                        case when h15=0 then 'n' when h15>999 then 'o' end as c15,h15 as v15,
                        case when h16=0 then 'n' when h16>999 then 'o' end as c16,h16 as v16,
                        case when h17=0 then 'n' when h17>999 then 'o' end as c17,h17 as v17,
                        case when h18=0 then 'n' when h18>999 then 'o' end as c18,h18 as v18,
                        case when h19=0 then 'n' when h19>999 then 'o' end as c19,h19 as v19,
                        case when h20=0 then 'n' when h20>999 then 'o' end as c20,h20 as v20,
                        case when h21=0 then 'n' when h21>999 then 'o' end as c21,h21 as v21,
                        case when h22=0 then 'n' when h22>999 then 'o' end as c22,h22 as v22,
                        case when h23=0 then 'n' when h23>999 then 'o' end as c23,h23 as v23,
                        null as hours,
                        page_events,
                    median_elapsed,
                    rows_fetched,
                    ir_searches,
                    errors,
                    most_recent
                    from (
                    select userid_lc as the_user, count(*) as page_events, median(elap) as median_elapsed,
                        sum(num_rows) as rows_fetched, sum(decode(ir_search,null,0,1)) as ir_searches,
                        sum(decode(sqlerrm,null,0,1)) as errors, max(time_stamp) as most_recent,
                        sum(decode(hh,0,1,0)) h00,sum(decode(hh,1,1,0)) h01,sum(decode(hh,2,1,0)) h02,sum(decode(hh,3,1,0)) h03,sum(decode(hh,4,1,0)) h04,sum(decode(hh,5,1,0)) h05,sum(decode(hh,6,1,0)) h06,sum(decode(hh,7,1,0)) h07,sum(decode(hh,8,1,0)) h08,sum(decode(hh,9,1,0)) h09,sum(decode(hh,10,1,0)) h10,sum(decode(hh,11,1,0)) h11,sum(decode(hh,12,1,0)) h12,sum(decode(hh,13,1,0)) h13,sum(decode(hh,14,1,0)) h14,sum(decode(hh,15,1,0)) h15,sum(decode(hh,16,1,0)) h16,sum(decode(hh,17,1,0)) h17,sum(decode(hh,18,1,0)) h18,sum(decode(hh,19,1,0)) h19,sum(decode(hh,20,1,0)) h20,sum(decode(hh,21,1,0)) h21,sum(decode(hh,22,1,0)) h22,sum(decode(hh,23,1,0)) h23
                    from (
                        select userid_lc, time_stamp, ir_search, sqlerrm, num_rows, elap,
                               to_char(time_stamp,'HH24') hh
                          from apex_activity_log
                         where flow_id = :APP_ID
                           and time_stamp >= sysdate - ( 1/24/60/60 * :P10011_TIMEFRAME )
                           and userid is not null
                    )
                    group by userid_lc) x
                ```
            pageItemsToSubmit: P10011_TIMEFRAME
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--noBorders
            ]
        }
        serverSideCondition {
            type: item=value
            item: P10011_VIEW_AS
            value: REPORT
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        searchBar {
            rowsPerPageSelector: true
        }
        actionsMenu {
            rowsPerPage: false
            savePublicReport: true
        }
        advanced {
            savedReportMappingIdentifier: 2181060179368252
        }

