        column V21 (
            type: hidden
            heading {
                heading: Hour 21 Value
            }
            layout {
                sequence: 530
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: AZ
            }
        )

        column V22 (
            type: hidden
            heading {
                heading: Hour 22 Value
            }
            layout {
                sequence: 550
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: BB
            }
        )

        column V23 (
            type: hidden
            heading {
                heading: Hour 23 Value
            }
            layout {
                sequence: 570
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: BD
            }
        )

        page {
            height: 8.5
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Top Users
        }

        savedReport 21874 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn HOURS (
                sequence: 2
            )

            displayColumn PAGE_EVENTS (
                sequence: 3
            )

            displayColumn THE_USER (
                sequence: 1
            )

            sort (
                column: PAGE_EVENTS
                sort {
                    direction: desc
                    sequence: 1
                }
            )

            sort (
                column: MOST_RECENT
                sort {
                    direction: desc
                    sequence: 2
                }
            )

        )

    )

    region top-users-chart (
        name: Top Users Chart
        type: chart
        layout {
            sequence: 30
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: item=value
            item: P10011_VIEW_AS
            value: CHART
        }
        chart {
            type: donut
        }
        chartLayout {
            height: 600
        }
        animation {
            onDisplay: none
        }
        legend {
            show: false
        }

        series series (
            name: Series 1
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select userid_lc as userid,
                           count(*) as page_views
                      from apex_activity_log
                     where flow_id     = :app_id
                       and time_stamp >= sysdate - ( 1/24/60/60 * :P10011_TIMEFRAME )
                       and userid     is not null
                     group by userid_lc
                     order by 2
                    ```
                pageItemsToSubmit: P10011_TIMEFRAME
            }
            columnMapping {
                label: USERID
                value: PAGE_VIEWS
            }
            label {
                show: true
                position: outsideSlice
            }
        )

    )

    pageItem P10011_TIMEFRAME (
        type: selectList
        label {
            label: Timeframe
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @timeframe-4-weeks
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 10
            region: @buttons
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            type: staticValue
            staticValue: 900
        }
        default {
            type: static
            staticValue: 900
        }
        help {
            helpText: Limits the report and chart to activity within the selected timeframe.
        }
    )

    pageItem P10011_VIEW_AS (
        type: radioGroup
        label {
            label: View As
            alignment: left
        }
        settings {
            noOfCols: 2
        }
        lov {
            type: sharedComponent
            lov: @view-as-report-chart
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 20
            region: @buttons
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/hidden
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--radioButtonGroup
            ]
        }
        source {
            type: staticValue
            staticValue: REPORT
        }
        default {
            type: static
            staticValue: REPORT
        }
    )

    button reset-report (
        buttonName: RESET_REPORT
        label: Reset
        layout {
            sequence: 20
            region: @top-users
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: t-Button--iconLeft
            icon: fa-undo-alt
        }
        behavior {
            action: redirectThisApp
            target: {
                page: &APP_PAGE_ID.
                clearCache: &APP_PAGE_ID.
                action: resetRegions
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction refresh-report (
        name: Refresh Report
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P10011_TIMEFRAME
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @top-users
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-refresh-2 (
            action: refresh
            affectedElements {
                selectionType: region
                region: @top-users
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

    )

    dynamicAction submit-view-as (
        name: Submit View As
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: P10011_VIEW_AS
        }

        action native-submit-page (
            action: submitPage
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

