lov application-attachable-entity (
    name: APPLICATION_ATTACHABLE_ENTITY
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            select 'Host: ' || h.hostname || ' (' || h.platform || ')' d,
                   'HOST:' || h.host_id r,
                   1 g, h.hostname s
              from dim_host h
            union all
            select 'Instance: ' || i.instance_name || ' on ' || h.hostname,
                   'INSTANCE:' || i.instance_id,
                   2, i.instance_name
              from dim_instance i
              join dim_host h on h.host_id = i.host_id
            union all
            select 'Database: ' || d.db_name || ' on ' || i.instance_name,
                   'DATABASE:' || d.database_id,
                   3, d.db_name
              from dim_database d
              join dim_instance i on i.instance_id = d.instance_id
             order by 3, 4
            ```
    }
    columnMapping {
        return: R
        display: D
    }
)

lov application-criticality (
    name: APPLICATION_CRITICALITY
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            select 'Critical' d, 'CRITICAL' r, 1 o from dual
            union all select 'High', 'HIGH', 2 from dual
            union all select 'Standard', 'STANDARD', 3 from dual
            union all select 'Low', 'LOW', 4 from dual
             order by 3
            ```
    }
    columnMapping {
        return: R
        display: D
    }
)

lov application-group-type (
    name: APPLICATION_GROUP_TYPE
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            select t.label d, t.group_type_code r, t.sort_order o
              from ref_application_group_type t
             where t.active = 1
             order by 3
            ```
    }
    columnMapping {
        return: R
        display: D
    }
)

lov application-lifecycle (
    name: APPLICATION_LIFECYCLE
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            select 'Project' d, 'PROJECT' r, 1 o from dual
            union all select 'Active', 'ACTIVE', 2 from dual
            union all select 'Decommissioning', 'DECOMMISSIONING', 3 from dual
            union all select 'Retired', 'RETIRED', 4 from dual
             order by 3
            ```
    }
    columnMapping {
        return: R
        display: D
    }
)

lov discovery-environment (
    name: DISCOVERY_ENVIRONMENT
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            select distinct environment d,
                   environment r
              from mssql_collect_list
             order by 1
            ```
    }
    columnMapping {
        return: R
        display: D
    }
)

lov discovery-license (
    name: DISCOVERY_LICENSE
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            select distinct license_type d,
                   license_type r
              from mssql_collect_list
             order by 1
            ```
    }
    columnMapping {
        return: R
        display: D
    }
)

lov discovery-platform (
    name: DISCOVERY_PLATFORM
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            select d, r
              from ( select '- All -' d, cast(null as varchar2(10)) r, 0 ord
                       from dual
                      union all
                     select distinct platform d, platform r, 1 ord
                       from disc_host )
             order by ord, d
            ```
    }
    columnMapping {
        return: R
        display: D
    }
)

lov discovery-status (
    name: DISCOVERY_STATUS
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            select d, r
              from ( select '- All -'   d, cast(null as varchar2(10)) r, 0 ord from dual
                      union all select 'New',       'NEW',       1 from dual
                      union all select 'Collected', 'COLLECTED', 2 from dual
                      union all select 'Ignored',   'IGNORED',   3 from dual
                      union all select 'Not Seen',  'NOT_SEEN',  4 from dual )
             order by ord
            ```
    }
    columnMapping {
        return: R
        display: D
    }
)

lov exception-doc-kind (
    name: EXCEPTION_DOC_KIND
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            select 'Licence' d, 'LICENSE' r, 1 o from dual
            union all select 'Vendor manual', 'VENDOR_MANUAL', 2 from dual
            union all select 'Signed approval', 'APPROVAL', 3 from dual
            union all select 'Other', 'OTHER', 4 from dual
             order by 3
            ```
    }
    columnMapping {
        return: R
        display: D
    }
)

lov exception-entity-type (
    name: EXCEPTION_ENTITY_TYPE
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            select 'Host' d, 'HOST' r, 1 o from dual
            union all select 'Instance', 'INSTANCE', 2 from dual
            union all select 'Database', 'DATABASE', 3 from dual
            union all select 'Storage', 'STORAGE', 4 from dual
             order by 3
            ```
    }
    columnMapping {
        return: R
        display: D
    }
)

lov timeframe-4-weeks (
    name: TIMEFRAME (4 WEEKS)
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            select disp,
                   val as seconds
              from table( apex_util.get_timeframe_lov_data )
             order by insert_order
            ```
    }
    columnMapping {
        return: SECONDS
        display: DISP
    }
)

lov view-as-report-chart (
    name: VIEW_AS_REPORT_CHART
    source {
        location: staticValues
    }

    entry add-chart-page (
        sequence: 2
        display: Add Chart Page
        return: CHART
        globalization {
            template: <span class="fa fa-pie-chart" aria-hidden="true"></span><span class="u-VisuallyHidden">#DISPLAY_VALUE#</span>
        }
    )

    entry add-report-page (
        sequence: 1
        display: Add Report Page
        return: REPORT
        globalization {
            template: <span class="fa fa-table" aria-hidden="true"></span><span class="u-VisuallyHidden">#DISPLAY_VALUE#</span>
        }
    )

)

