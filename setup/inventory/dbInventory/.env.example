# =============================================================================
# Modèle du fichier .env des scripts dbInventory (bin/_dbinventory_env.sh).
#
# Copier en .env à côté de ce fichier (serveur : /inventory/dbInventory/.env),
# renseigner les valeurs, puis : chmod 600 .env
# Le .env n'est JAMAIS versionné : le .gitignore l'exclut.
#
# Syntaxe bash (le fichier est sourcé) : mettre les valeurs entre apostrophes.
# =============================================================================

# ── Base dbInventory : cible des loaders, du calcul et de gen_collect_lists ──
# DBINVENTORY_TARGET (prod par défaut, ou test) choisit le couple utilisé.
# dbInventory_load_test.sh et les *_test.sh passent en test d'eux-mêmes.
DBINVENTORY_PROD_PASS=''
DBINVENTORY_PROD_DSN='ORAAPPSDBS02-PI:1521/DBINVENTORY_PRD'
DBINVENTORY_TEST_PASS=''
DBINVENTORY_TEST_DSN='ORA-DEV:1521/DBINVENTORY_TST'

# ── Comptes de collecte sur les cibles (utilisateur : monitoring) ────────────
MONITORING_ORACLE_PASS=''
MONITORING_MSSQL_PASS=''
MONITORING_POSTGRES_PASS=''

# ── Périmètre de collecte ────────────────────────────────────────────────────
# 1 : get_info_all.sh régénère les .lst depuis les tables *_collect_list avant
#     de collecter (gen_collect_lists.sh), et s'arrête si la génération échoue.
# 0 : les .lst de collect/ sont tenus à la main (comportement actuel du serveur).
DBINV_GEN_COLLECT_LISTS=0
